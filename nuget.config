<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Asignación de paquetes al único origen del repositorio.

    Hace falta y no es redundante. La configuración global de NuGet de estos equipos asigna por
    NOMBRE EXACTO un puñado de paquetes de Microsoft.Extensions / AspNetCore a un feed privado de la
    organización. Un patrón exacto gana siempre sobre el comodín, así que sin esta lista esos
    paquetes se buscarían en un origen que este repositorio no declara, y la restauración fallaba
    con NU1100 en cuanto hacía falta una versión que no estuviera ya en la caché local — que es justo
    lo que pasó al agregar Blazor WebAssembly.

    Al repetir aquí los mismos patrones, gana el archivo más cercano (este) y el repositorio queda
    autosuficiente: restaura igual en cualquier máquina y en el pipeline, tenga o no configurado el
    feed de la organización.
  -->
  <packageSourceMapping>
    <packageSource key="nuget">
      <package pattern="*" />

      <!-- Los que la configuración global desvía a un feed privado. -->
      <package pattern="Microsoft.Extensions.Caching.Abstractions" />
      <package pattern="Microsoft.Extensions.Caching.Memory" />
      <package pattern="Microsoft.Extensions.DependencyInjection" />
      <package pattern="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <package pattern="Microsoft.Extensions.Diagnostics" />
      <package pattern="Microsoft.Extensions.Features" />
      <package pattern="Microsoft.Extensions.Http" />
      <package pattern="Microsoft.Extensions.Logging" />
      <package pattern="Microsoft.Extensions.Logging.Abstractions" />
      <package pattern="Microsoft.Extensions.Options" />
      <package pattern="Microsoft.Extensions.Options.ConfigurationExtensions" />
      <package pattern="Microsoft.AspNetCore.Connections.Abstractions" />
      <package pattern="Microsoft.AspNetCore.Cryptography.Internal" />
      <package pattern="Microsoft.AspNetCore.DataProtection" />
      <package pattern="Microsoft.AspNetCore.DataProtection.Abstractions" />
      <package pattern="Microsoft.AspNetCore.Http.Connections.Common" />
      <package pattern="Microsoft.AspNetCore.SignalR.Common" />
      <package pattern="Microsoft.AspNetCore.SignalR.Protocols.Json" />
      <package pattern="System.Security.Cryptography.Pkcs" />
      <package pattern="System.Security.Cryptography.ProtectedData" />
      <package pattern="System.Security.Cryptography.Xml" />
      <package pattern="NETStandard.Library" />
      <package pattern="Serilog" />
      <package pattern="Serilog.Sinks.File" />
    </packageSource>
  </packageSourceMapping>
</configuration>
