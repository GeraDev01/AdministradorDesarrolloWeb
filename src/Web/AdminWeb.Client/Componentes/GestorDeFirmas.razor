@using AdminWeb.Shared.Dtos.AusenciasLider
@implements IDisposable
@inject ClienteApi Api
@inject AvisosDeInterfaz Avisos
@inject IJSRuntime Js

@*
    El gestor de firmas compartidas: trazar una nueva, listarlas, renombrarlas, elegir la
    predeterminada y borrarlas. Es el SignatureCaptureControl del escritorio.

    Es un componente y no una pantalla porque se usa desde dos sitios y las dos veces hace falta
    entero:

      · en «Firmas» (Administración), que es donde se administran cuando no se está resolviendo nada;
      · dentro de «Vacaciones del equipo», porque cuando alguien descubre que le falta una firma es
        justo mientras va a firmar un documento, y mandarlo a otra pantalla en ese momento le hace
        perder la solicitud que tenía abierta.

    Escribirlo dos veces habría dejado dos confirmaciones de borrado distintas y un botón de
    predeterminada que en una de las dos se olvidaría de recargar.

    La lista se pide aquí y no se recibe del anfitrión: es un componente que ADMINISTRA firmas, así
    que tiene que poder releerlas después de cada cambio sin depender de que quien lo hospeda se
    acuerde. La respuesta no trae imágenes —solo fichas—, así que la consulta de más es barata; los
    PNG se piden uno a uno por su ruta al pintarlos.
*@

@*
    EL PAPEL DE LAS FIRMAS, que aquí se usa en dos sitios (la vista previa de la escaneada y las
    miniaturas de la rejilla) y en los dos por la misma razón.

    Una firma es TINTA SOBRE PAPEL. La tinta del PNG es grafito y es fija a propósito: ese PNG sale
    transparente y acaba impreso sobre papel blanco de verdad, así que aclararla para que luciera en
    el modo oscuro dejaría la firma invisible en la hoja archivada. Lo único que puede adaptarse es la
    SUPERFICIE donde se enseña, y por eso el papel vale IGUAL en claro y en oscuro: en oscuro es una
    hoja apoyada sobre la mesa, no un agujero. Todo lo que se pinte DENTRO del papel —el borde, los
    cuadros del damero— se elige contra el marfil y nunca contra el tema; en cuanto se cuela ahí una
    variable de Radzen, el defecto vuelve en el modo contrario.

    Los tokens --adminweb-papel* se declaran en cada elemento que los usa, y no en tema.css, porque
    tema.css no es de este componente. Repetir los dos valores es a conciencia: así cada superficie se
    pinta bien por su cuenta, sin depender de un antepasado ni del orden en que se rendericen los
    componentes. Si algún día suben a :root en tema.css, hay que BORRARLOS de aquí en vez de dejarlos
    —una declaración local gana sobre la global y anclaría estas superficies al valor viejo—.
*@
<RadzenStack Gap="0.75rem">
    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
        Las firmas que se estampan en los documentos que autoriza el líder. Se guardan una vez y se
        reutilizan; la marcada como predeterminada es la que se ofrece primero.
    </RadzenText>

    <RadzenCard data-recorrido="gestor-firmas-nueva">
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">Trazar una firma nueva</RadzenText>

            <FirmaEnLienzo @ref="_lienzo" Alto="170" />

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem"
                         AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <RadzenTextBox @bind-Value="_nombre" MaxLength="80" Style="min-width:16rem"
                               Placeholder="Nombre de la firma (p. ej. «Jefe directo»)"
                               aria-label="Nombre de la firma" />
                <RadzenCheckBox TValue="bool" @bind-Value="_predeterminada" Name="firmaPredeterminada" />
                <RadzenLabel Text="Dejarla como predeterminada" Component="firmaPredeterminada" />
                <RadzenButton Text="Guardar firma" Icon="save" Disabled="@_ocupado" Click="@Guardar" />
            </RadzenStack>

            @* Importar una escaneada. El escritorio lo permitía y era lo normal para la firma del
               jefe: se firma en papel una vez y se escanea, en vez de dibujarla con el ratón —que
               nunca sale igual—. Al cargarla se le quita el fondo del papel y se recorta al trazo,
               así que entra igual que si se hubiera trazado aquí; después se guarda con el mismo
               botón de arriba, para que no haya dos caminos distintos de guardar. *@
            <RadzenStack data-recorrido="gestor-firmas-escaneada"
                         Orientation="Orientation.Horizontal" Gap="0.75rem"
                         AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                    …o parte de una firma escaneada:
                </RadzenText>
                <InputFile OnChange="@ImportarEscaneada" accept="image/*" disabled="@_ocupado" />
                @if (_importada is { } imp)
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0"
                                Style="color:var(--rz-success)">
                        Imagen lista (@imp.Ancho×@imp.Alto). Ponle nombre y pulsa «Guardar firma».
                    </RadzenText>
                    <RadzenButton Text="Descartar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Disabled="@_ocupado" Click="@(() => _importada = null)" />
                }
            </RadzenStack>

            @if (_importada is { } vista)
            {
                @* Se ve ANTES de guardar, y sobre un fondo a cuadros para que se note qué quedó
                   transparente: una firma con el rectángulo del papel todavía pegado se descubriría
                   si no, ya estampada dentro de un documento oficial.

                   Los cuadros se pintan sobre el PAPEL y con un gris cálido explícito. Antes eran
                   #0001 —negro al 6 %— sobre el fondo HEREDADO de la tarjeta, así que en oscuro no se
                   veía ni el cuadriculado ni la firma: la única pantalla que existe para comprobar la
                   transparencia dejaba de comprobar nada, y el rectángulo del escaneo se colaba hasta
                   el documento. El tamaño y el desfase de los cuadros no se tocan: son los que hacen
                   el damero. *@
                <div style="--adminweb-papel:#faf9f7;--adminweb-papel-borde:#d6d3d1;
                            display:inline-block;padding:.5rem;border:1px solid var(--adminweb-papel-borde);
                            border-radius:6px;background-color:var(--adminweb-papel);
                            background-image:linear-gradient(45deg,rgba(28,25,23,.10) 25%,transparent 25%,transparent 75%,rgba(28,25,23,.10) 75%),
                                             linear-gradient(45deg,rgba(28,25,23,.10) 25%,transparent 25%,transparent 75%,rgba(28,25,23,.10) 75%);
                            background-size:12px 12px;background-position:0 0,6px 6px">
                    <img src="@($"data:image/png;base64,{Convert.ToBase64String(vista.Png)}")"
                         alt="Vista previa de la firma importada"
                         style="max-height:80px;max-width:260px;display:block" />
                </div>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenDataGrid data-recorrido="gestor-firmas-lista"
                    TItem="FirmaDelLiderDto" Data="@_firmas" IsLoading="@_ocupado"
                    AllowSorting="true" EmptyText="Todavía no hay ninguna firma guardada.">
        <Columns>
            <RadzenDataGridColumn TItem="FirmaDelLiderDto" Title="Firma" Width="140px" Sortable="false">
                @* La imagen se pide por su ruta y no viaja en la lista: con diez firmas guardadas se
                   descargarían las diez para enseñar una.

                   Y se enseña sobre PAPEL, no sobre la fila. El PNG es transparente con tinta oscura,
                   así que sin fondo propio se pintaba contra la rejilla y en oscuro todas las firmas
                   se veían igual de vacías — justo en la pantalla donde se ELIGE cuál estampar. El
                   relleno es para que el trazo no toque el borde. En claro también se gana: hasta
                   ahora el trazo caía sobre el rayado sin nada que lo delimitara. *@
                <Template Context="f">
                    <img src="@($"api/ausencias-lider/firmas/{f.Id}/imagen")"
                         alt="@($"Firma {f.Nombre}")"
                         style="--adminweb-papel:#faf9f7; --adminweb-papel-borde:#d6d3d1;
                                max-height:48px; max-width:120px; display:block; object-fit:contain;
                                padding:.25rem; background:var(--adminweb-papel);
                                border:1px solid var(--adminweb-papel-borde); border-radius:6px" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FirmaDelLiderDto" Title="Nombre" Property="Nombre" />
            <RadzenDataGridColumn TItem="FirmaDelLiderDto" Title="Predeterminada"
                                  Property="Predeterminada" Width="150px">
                @* La estrella se queda —marca de un vistazo cuál se va a estampar sin pedirla— pero
                   como glifo de la fuente: la ⭐ del emoji la dibuja el sistema operativo y es
                   amarilla pase lo que pase, así que en el tema oscuro era el único punto de color
                   de toda la tabla. «star» hereda currentColor y se apaga con el renglón. El guion
                   de la otra rama no se toca: un guion medio es tipografía, no un dibujo, y aquí
                   significa lo mismo que en el resto de la aplicación —«no hay dato». *@
                <Template Context="f">@if (f.Predeterminada) { <RadzenIcon Icon="star" /> <text>Sí</text> } else { <text>—</text> }</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FirmaDelLiderDto" Title="Guardada" Property="CreadaUtc" Width="150px">
                <Template Context="f">@f.CreadaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FirmaDelLiderDto" Title="" Width="280px" Sortable="false">
                <Template Context="f">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                        @if (!f.Predeterminada)
                        {
                            <RadzenButton Text="Predeterminada" ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                          Click="@(() => Predeterminada(f))" />
                        }
                        <RadzenButton Text="Renombrar" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                      Click="@(() => Renombrar(f))" />
                        <RadzenButton Text="Eliminar" ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                      Click="@(() => Eliminar(f))" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>

@code {
    private readonly CancellationTokenSource _cancelacion = new();

    /// <summary>
    /// Se dispara cuando la colección de firmas cambió (alta, renombrado, predeterminada o baja).
    ///
    /// Lo necesita quien tenga firmas pintadas fuera de este componente —el desplegable del documento
    /// de vacaciones—: sin aviso seguiría ofreciendo una firma recién borrada.
    /// </summary>
    [Parameter] public EventCallback OnCambio { get; set; }

    private List<FirmaDelLiderDto> _firmas = [];
    private bool _ocupado;

    private FirmaEnLienzo? _lienzo;
    private string? _nombre;
    private bool _predeterminada;

    /// <summary>La escaneada ya limpia, esperando nombre. Nula mientras no se haya cargado ninguna.</summary>
    private FirmaCapturada? _importada;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        _ocupado = true;
        try
        {
            _firmas = await Api.LeerAsync<List<FirmaDelLiderDto>>(
                "api/ausencias-lider/firmas", _cancelacion.Token) ?? [];
        }
        finally { _ocupado = false; }
    }

    private async Task Guardar()
    {
        if (_lienzo is null) return;

        // Las dos comprobaciones son comodidad: el servicio vuelve a hacerlas y su mensaje es el que
        // se enseña. Se adelantan aquí para no gastar una subida en algo que ya se sabe que sobra.
        // La importada gana sobre el lienzo: si hay una cargada es lo que se está mirando en la
        // vista previa, y guardar otra cosa sería lo último que alguien espera.
        var firma = _importada;

        if (firma is null)
        {
            if (await _lienzo.EstaVaciaAsync())
            {
                Avisos.Aviso("Traza la firma dentro del recuadro, o carga una escaneada, antes de guardarla.");
                return;
            }
            firma = await _lienzo.ObtenerAsync();
            if (firma is null) return;
        }

        if (string.IsNullOrWhiteSpace(_nombre))
        {
            Avisos.Aviso("Ponle un nombre a la firma para poder distinguirla.");
            return;
        }

        _ocupado = true;
        try
        {
            // Multipart y no JSON con la imagen en base64: son bytes, y base64 los infla un tercio.
            // El testigo antifalsificación lo adjunta ClienteApi.SubirAsync sin que este componente
            // tenga que acordarse. El nombre y las medidas van en la cadena de consulta.
            var formulario = new MultipartFormDataContent
            {
                { new ByteArrayContent(firma.Png), "archivo", "firma.png" }
            };

            var ruta = $"api/ausencias-lider/firmas?nombre={Uri.EscapeDataString(_nombre!.Trim())}" +
                       $"&ancho={firma.Ancho}&alto={firma.Alto}&predeterminada={_predeterminada}";

            var (ok, respuesta) = await Api.SubirAsync<ResultadoDto>(ruta, formulario, _cancelacion.Token);
            if (!ok) return;
            if (respuesta is not null) Avisos.Exito(respuesta.Mensaje);

            _nombre = null;
            _predeterminada = false;
            _importada = null;
            await _lienzo.Limpiar();
        }
        finally { _ocupado = false; }

        await Refrescar();
    }

    /// <summary>
    /// Carga una firma escaneada, le quita el fondo del papel y la recorta al trazo.
    ///
    /// <para>La limpieza la hace el NAVEGADOR con el mismo lienzo que ya se usa para trazar. Es la
    /// lógica de <c>SignatureImaging</c> del escritorio, que allí iba con GDI+ — y GDI+ no corre en
    /// Linux. Traerla al servidor habría obligado a meter un paquete de imagen para hacer sobre
    /// píxeles lo que el navegador hace de serie.</para>
    ///
    /// <para>Que el recorte lo haga el cliente NO significa que el servidor se fíe: la subida pasa
    /// por la misma validación que las demás —tamaño, tipo por los bytes y no por la extensión— y el
    /// tope de la imagen de firma lo sigue aplicando <c>SignatureService</c>.</para>
    /// </summary>
    private async Task ImportarEscaneada(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo is null) return;

        // Se corta ANTES de leer nada. Un escaneo normal ronda el megabyte; ocho es de sobra y evita
        // que una foto de móvil de 40 MB se cargue entera en la memoria del navegador.
        const long tope = 8 * 1024 * 1024;
        if (archivo.Size > tope)
        {
            Avisos.Aviso($"La imagen pesa {archivo.Size / 1024d / 1024d:0.0} MB y el tope son 8 MB. " +
                         "Escanéala a menos resolución.");
            return;
        }

        _ocupado = true;
        try
        {
            using var flujo = archivo.OpenReadStream(tope, _cancelacion.Token);
            using var memoria = new MemoryStream();
            await flujo.CopyToAsync(memoria, _cancelacion.Token);

            var limpia = await Js.InvokeAsync<FirmaEnBase64>(
                "adminweb.firma.limpiarEscaneadaDesdeBytes",
                _cancelacion.Token, Convert.ToBase64String(memoria.ToArray()), archivo.ContentType);

            _importada = new FirmaCapturada(Convert.FromBase64String(limpia.Base64), limpia.Ancho, limpia.Alto);
            Avisos.Exito("Imagen cargada y limpiada. Revisa la vista previa antes de guardarla.");
        }
        catch (JSException ex)
        {
            // El mensaje viene del guion y ya está redactado para quien lo lee («la imagen se quedó
            // en blanco…»), así que se enseña tal cual en vez de un «no se pudo» genérico.
            Avisos.Error(ex.Message);
        }
        finally { _ocupado = false; }
    }

    /// <summary>Lo que devuelve el guion: el PNG ya limpio, en base64, con sus medidas.</summary>
    private sealed record FirmaEnBase64(string Base64, int Ancho, int Alto);

    private async Task Renombrar(FirmaDelLiderDto f)
    {
        var nombre = await Avisos.PedirTextoAsync($"Nuevo nombre para «{f.Nombre}»:", "Renombrar firma");
        if (string.IsNullOrWhiteSpace(nombre)) return;

        await Enviar($"api/ausencias-lider/firmas/{f.Id}/nombre", new RenombrarFirmaRequest(nombre));
    }

    private Task Predeterminada(FirmaDelLiderDto f) =>
        Enviar($"api/ausencias-lider/firmas/{f.Id}/predeterminada", new { });

    private async Task Eliminar(FirmaDelLiderDto f)
    {
        if (!await Avisos.ConfirmarAsync(
            $"¿Eliminar la firma «{f.Nombre}»?\n\n" +
            "Los documentos ya firmados con ella no cambian: la imagen va dentro del PDF archivado.",
            "Eliminar firma", "Sí, eliminar"))
            return;

        await Enviar($"api/ausencias-lider/firmas/{f.Id}/eliminacion", new { });
    }

    /// <summary>
    /// El envío que comparten las acciones. El mensaje del servidor se enseña TAL CUAL: dice qué firma
    /// quedó como predeterminada o por qué se rechazó el cambio.
    /// </summary>
    private async Task Enviar<T>(string ruta, T cuerpo)
    {
        _ocupado = true;
        try
        {
            var (ok, respuesta) = await Api.EnviarAsync<T, ResultadoDto>(ruta, cuerpo, _cancelacion.Token);
            if (ok && respuesta is not null) Avisos.Exito(respuesta.Mensaje);
            if (!ok) return;
        }
        finally { _ocupado = false; }

        await Refrescar();
    }

    private async Task Refrescar()
    {
        await Cargar();
        await OnCambio.InvokeAsync();
    }

    public void Dispose()
    {
        _cancelacion.Cancel();
        _cancelacion.Dispose();
    }
}
