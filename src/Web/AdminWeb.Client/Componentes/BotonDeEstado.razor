@using AdminWeb.Shared.Dtos.Jornada
@inject ConexionEnVivo EnVivo
@inject AvisosDeInterfaz Avisos
@inject ClienteApi Api

@*
    El estado propio de presencia: disponible, ocupado, comiendo…

    Va por la conexión en vivo y no por HTTP porque el tablero de quien lo esté mirando tiene que
    enterarse en el momento; un cambio de estado que tarda un minuto en verse no sirve para nada.

    El estado NO se historiza. Es una decisión de producto que viene del escritorio y se conserva:
    un registro minutado de las pausas de alguien es vigilancia, no asistencia. Solo existe el
    estado actual.
*@

@* El manejador del clic va en el MENÚ, no en cada entrada. RadzenProfileMenuItem no tiene
   parámetro Click: lo que se le ponga cae en el diccionario de atributos sueltos, compila sin dar
   error y no se ejecuta jamás —el menú se abría, se elegía un estado y no pasaba nada—. Radzen
   entrega la entrada elegida, así que cada una viaja identificada por su Value. *@
<RadzenProfileMenu Click="@AlElegirAsync">
    <Template>
        @* La nota se ve JUNTO al estado, no escondida en el menú: quien escribió «vuelvo 15:30»
           tiene que poder comprobar de un vistazo que sigue puesta. *@
        @* El punto de color sustituye al emoji que había (🟢🔴🟣🍽⚪). El motivo es el mismo que
           explica Menu.cs para el menú lateral: los emojis los dibuja el sistema operativo, se ven
           distintos en cada equipo y NO heredan currentColor, así que en el tema oscuro seguían
           brillando con sus colores de siempre. Un punto pintado por nosotros sí obedece al tema.
           El texto del estado va SIEMPRE al lado, y no es adorno: cinco puntos de color solos no se
           distinguen ni en oscuro ni por quien no separa el rojo del verde.
           El borde gris no es decoración tampoco: si el día de mañana falta la variable de color, el
           punto se queda sin relleno pero SE SIGUE VIENDO, en vez de desaparecer sin que nadie note
           que se rompió algo. *@
        <span style="white-space:nowrap;display:inline-flex;align-items:center;gap:.4rem">
            <span style="width:.55rem;height:.55rem;flex:none;border-radius:50%;border:1px solid var(--rz-border-color);background:@ColorDePresencia(_estado)"></span>
            @Etiqueta(_estado)@(string.IsNullOrWhiteSpace(_nota) ? "" : $" · {_nota}")
        </span>
    </Template>
    <ChildContent>
        @* Dentro del desplegable van sólo las palabras, sin punto de color. No es un olvido:
           RadzenProfileMenuItem.Text es una CADENA y no admite marcado, y la única forma de meter el
           punto sería su parámetro Template, que existe pero cambia el contenido del elemento sobre
           el que este menú engancha el clic —y este componente ya se rompió una vez por dar por hecho
           cómo maneja Radzen los clics de estas entradas—. Cinco palabras claras no necesitan color;
           el punto hace falta arriba, que es lo que se ve todo el día sin abrir nada. *@
        @foreach (var e in Estados)
        {
            <RadzenProfileMenuItem Text="@Etiqueta(e)" Value="@e.ToString()" />
        }
        @* El escritorio tenía esta misma entrada aparte. Es lo que llenaba la columna «Nota» del
           tablero del líder, que sin ella llevaba tiempo vacía. *@
        @* Lleva icono —y las otras cinco no— porque no es un estado más: es la única que abre un
           diálogo en lugar de cambiar el estado y cerrarse. Que se vea distinta es la intención. *@
        <RadzenProfileMenuItem Text="Estado con nota…" Icon="edit_note" Value="@ValorNota" />
    </ChildContent>
</RadzenProfileMenu>

@code {
    /// <summary>
    /// «Ausente» no está, y no es un olvido: en el escritorio tampoco se podía elegir a mano. Lo pone
    /// el servidor cuando alguien deja de dar señales. Poder declararse ausente convertiría un dato
    /// observado en una afirmación, y entonces dejaría de significar nada.
    /// </summary>
    private static readonly PresenceState[] Estados =
    [
        PresenceState.Disponible,
        PresenceState.Ocupado,
        PresenceState.EnReunion,
        PresenceState.Comiendo,
        PresenceState.Descanso
    ];

    private PresenceState _estado = PresenceState.Disponible;
    private string? _nota;

    /// <summary>
    /// Se pregunta al SERVIDOR cuál es el estado, en vez de dar por hecho «Disponible».
    ///
    /// Antes el botón arrancaba de esta variable local, así que después de recargar decía
    /// «Disponible» aunque en el tablero del líder pusiera «En reunión» — y la nota desaparecía de
    /// la vista de quien la había escrito, aunque siguiera guardada.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var mio = await Api.LeerAsync<MiPresenciaDto>("api/jornada/presencia");
        if (mio is null) return;

        _estado = mio.Estado;
        _nota = mio.Nota;
    }

    /// <summary>
    /// Identifica la entrada «con nota…» dentro del menú. No es el nombre de ningún PresenceState,
    /// así que no puede confundirse con un estado por mucho que crezca el enumerado.
    /// </summary>
    private const string ValorNota = "__nota__";

    /// <summary>
    /// Se eligió una entrada del menú. Radzen avisa una sola vez, a nivel de menú, entregando la
    /// entrada elegida: quién era se sabe por su Value.
    /// </summary>
    private async Task AlElegirAsync(RadzenProfileMenuItem elegido)
    {
        if (elegido.Value == ValorNota)
        {
            await ConNota();
            return;
        }

        if (Enum.TryParse<PresenceState>(elegido.Value, out var nuevo))
            await Cambiar(nuevo);
    }

    private Task Cambiar(PresenceState nuevo) => Aplicar(nuevo, null);

    /// <summary>Cambiar el estado dejando dicho por qué o hasta cuándo.</summary>
    private async Task ConNota()
    {
        var nota = await Avisos.PedirTextoAsync(
            "¿Qué se anota junto a tu estado? (p. ej. «vuelvo 15:30»)", "Estado con nota");

        // Cancelar deja todo como estaba. Una nota en blanco sí es una decisión —quitar la que
        // hubiera—, pero para eso está volver a elegir el estado a secas.
        if (nota is null) return;

        await Aplicar(_estado, string.IsNullOrWhiteSpace(nota) ? null : nota.Trim());
    }

    private async Task Aplicar(PresenceState nuevo, string? nota)
    {
        if (!EnVivo.Conectado)
        {
            Avisos.Aviso("Sin conexión en vivo no se puede cambiar el estado. Se reintenta solo.");
            return;
        }

        await EnVivo.CambiarEstadoAsync(nuevo, nota);
        _estado = nuevo;
        _nota = nota;
    }

    private static string Etiqueta(PresenceState e) => e switch
    {
        PresenceState.Disponible => "Disponible",
        PresenceState.Ocupado    => "Ocupado",
        PresenceState.EnReunion  => "En reunión",
        PresenceState.Comiendo   => "Comiendo",
        PresenceState.Descanso   => "Descanso",
        _                        => "Ausente"
    };

    /// <summary>
    /// El color del punto de presencia. Devuelve la CADENA «var(--…)» y no un color de verdad: esto
    /// se interpola dentro de un atributo <c>style</c> y lo resuelve el navegador, no .NET, así que
    /// aquí no hay nada que convertir. Escribir el hex directamente sería atarlo a un solo tema.
    ///
    /// <para>Los cinco NO salen del semáforo, y es deliberado: «Ocupado» no es un error ni
    /// «Disponible» un éxito. Si se pintaran de rojo y verde, la barra estaría gritando una alarma
    /// cada vez que alguien está concentrado. Salen de la escala de series de la paleta, que es la
    /// que existe justo para distinguir cosas que no están mejor ni peor unas que otras.</para>
    ///
    /// <para>DEPENDENCIA: estas cinco variables las declara <c>tema.css</c>, que es de otro. Mientras
    /// no estén, los puntos se ven como un círculo con borde y sin relleno —feo pero legible, porque
    /// el nombre del estado va siempre al lado—. No las sustituyas por hexes para «arreglarlo»: eso
    /// rompería el tema oscuro, que es exactamente el defecto del que se viene.</para>
    /// </summary>
    private static string ColorDePresencia(PresenceState e) => e switch
    {
        PresenceState.Disponible => "var(--adminweb-presencia-disponible)",
        PresenceState.Ocupado    => "var(--adminweb-presencia-ocupado)",
        PresenceState.EnReunion  => "var(--adminweb-presencia-reunion)",
        PresenceState.Comiendo   => "var(--adminweb-presencia-comida)",
        _                        => "var(--adminweb-presencia-ausente)"
    };
}
