@page "/dashboard"
@using AdminWeb.Shared.Dtos.Dashboard
@* Roles y no política: el cliente registra AddAuthorizationCore sin ninguna política declarada, así
   que nombrar aquí «AdminUDesarrollador» reventaría al renderizar. La política de verdad —la que
   cuenta— está declarada en el endpoint; esto solo evita pintar una pantalla que llegaría vacía. *@
@attribute [Authorize(Roles = "Admin,Desarrollador")]
@inject ClienteApi Api

@*
    Dashboard. Réplica de DashboardControl: no tiene un solo botón que cambie nada, solo enseña.

    Los tres paneles de datos de equipo (carga, recordatorios y podio) se pintan si vienen en la
    respuesta, y vienen o no según el rol de quien pregunta. La pantalla NO decide eso: cuando no le
    corresponden, los campos llegan en null porque el servidor no los consultó. Es a propósito —
    esconderlos aquí no escondería nada, porque este código corre en la máquina del usuario.
*@

<PageTitle>Dashboard</PageTitle>

@if (_datos is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenStack Gap="1rem">

        @* ── Tarjetas ───────────────────────────────────────────────────────── *@
        <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.75rem">
            @Tarjeta("Por estimar",   _datos.Tarjetas.PorEstimar,   SinEmpezar)
            @Tarjeta("En desarrollo", _datos.Tarjetas.EnDesarrollo, EnCurso)
            @Tarjeta("Por entregar",  _datos.Tarjetas.PorEntregar,  EnRiesgo)
            @Tarjeta("Entregados",    _datos.Tarjetas.Entregados,   Logrado)
            @Tarjeta("Cancelados",    _datos.Tarjetas.Cancelados,   Problema)
            @Tarjeta("Pendientes",    _datos.Tarjetas.Pendientes,   OtraCosa)
        </RadzenStack>

        <RadzenRow Gap="1rem">

            @* ── Próximas entregas: la ve todo el mundo ─────────────────────── *@
            @* Sin los paneles de equipo ocupa el ancho completo, igual que en el escritorio. *@
            <RadzenColumn Size="12" SizeMD="@(HayDatosDeEquipo ? 6 : 12)">
                <RadzenCard>
                    @* Los cuatro rótulos de esta pantalla llevaban un emoji delante. Los emojis los
                       dibuja el sistema operativo con su propia paleta: no heredan el color del
                       texto, así que en la barra clara y en la oscura se ven distintos, y en cada
                       equipo del área se ven de otra forma. Los de la fuente de iconos sí lo
                       heredan. *@
                    <RadzenText TextStyle="TextStyle.H6">
                        <RadzenIcon Icon="event" /> Próximas entregas (7 días)
                    </RadzenText>
                    <RadzenDataGrid TItem="EntregaProximaDto" Data="@_datos.ProximasEntregas"
                                    AllowSorting="false" RowRender="@PintarEntrega"
                                    EmptyText="Nada comprometido para esta semana."
                                    Style="min-height:220px">
                        <Columns>
                            <RadzenDataGridColumn TItem="EntregaProximaDto" Property="Titulo" Title="Requerimiento" Width="52%" />
                            <RadzenDataGridColumn TItem="EntregaProximaDto" Property="EstadoTexto" Title="Estado" Width="26%" />
                            <RadzenDataGridColumn TItem="EntregaProximaDto" Title="Fecha" Width="22%">
                                <Template Context="fila">@Fecha(fila.FechaCompromiso)</Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            </RadzenColumn>

            @* ── Datos del equipo: solo si el servidor los mandó ────────────── *@
            @if (_datos.CargaPorDesarrollador is { } carga)
            {
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenCard>
                        <RadzenText TextStyle="TextStyle.H6">
                            <RadzenIcon Icon="groups" /> Carga por desarrollador
                        </RadzenText>
                        <RadzenDataGrid TItem="CargaDesarrolladorDto" Data="@carga" AllowSorting="false"
                                        EmptyText="No hay desarrolladores activos."
                                        Style="min-height:220px">
                            <Columns>
                                <RadzenDataGridColumn TItem="CargaDesarrolladorDto" Property="Nombre" Title="Desarrollador" Width="55%" />
                                <RadzenDataGridColumn TItem="CargaDesarrolladorDto" Property="Activos" Title="Activos" Width="22%" />
                                <RadzenDataGridColumn TItem="CargaDesarrolladorDto" Property="PorEntregar" Title="Por entregar" Width="23%" />
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenCard>
                </RadzenColumn>
            }

            @if (_datos.RecordatoriosPendientes is { } recordatorios)
            {
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenCard>
                        @* La misma chincheta que la entrada «Notas y pendientes» del menú, a
                           propósito: este panel es esa pantalla asomada al Dashboard. *@
                        <RadzenText TextStyle="TextStyle.H6">
                            <RadzenIcon Icon="push_pin" /> Recordatorios pendientes
                        </RadzenText>
                        <RadzenDataGrid TItem="RecordatorioDto" Data="@recordatorios" AllowSorting="false"
                                        RowRender="@PintarRecordatorio"
                                        EmptyText="No hay recordatorios pendientes."
                                        Style="min-height:220px">
                            <Columns>
                                <RadzenDataGridColumn TItem="RecordatorioDto" Property="Titulo" Title="Nota / Pendiente" Width="52%" />
                                <RadzenDataGridColumn TItem="RecordatorioDto" Title="Prioridad" Width="18%">
                                    <Template Context="fila">@EtiquetaPrioridad(fila.Prioridad)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RecordatorioDto" Title="Recordatorio" Width="30%">
                                    <Template Context="fila">@Fecha(fila.FechaRecordatorio, "Sin fecha")</Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenCard>
                </RadzenColumn>
            }

            @if (_datos.TopRanking is { } podio)
            {
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenCard>
                        @* El mismo trofeo que «Desempeño» en el menú: este panel es su resumen. *@
                        <RadzenText TextStyle="TextStyle.H6">
                            <RadzenIcon Icon="emoji_events" /> Top ranking — @_datos.PeriodoRanking
                        </RadzenText>
                        <RadzenDataGrid TItem="PuestoRankingDto" Data="@podio" AllowSorting="false"
                                        EmptyText="Sin datos este mes."
                                        Style="min-height:220px">
                            <Columns>
                                <RadzenDataGridColumn TItem="PuestoRankingDto" Title="Pos." Width="12%">
                                    <Template Context="fila">@Posicion(fila.Posicion)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PuestoRankingDto" Property="Nombre" Title="Dev" Width="55%" />
                                <RadzenDataGridColumn TItem="PuestoRankingDto" Title="Pts" Width="18%">
                                    <Template Context="fila">
                                        <span style="@($"color:{(fila.Puntos >= 0 ? Logrado : Problema)};font-weight:600")">
                                            @(fila.Puntos > 0 ? $"+{fila.Puntos}" : fila.Puntos.ToString())
                                        </span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PuestoRankingDto" Property="Entradas" Title="Entradas" Width="15%" />
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenCard>
                </RadzenColumn>
            }

        </RadzenRow>
    </RadzenStack>
}

@code {
    // ATENCIÓN, AQUÍ SE ROMPIÓ ALGO A PROPÓSITO: hasta ahora estos seis eran los hexes exactos del
    // escritorio (AppTheme) para que las dos aplicaciones se leyeran igual mientras conviven. Ya no.
    // Un hex fijo solo puede estar calibrado contra UN fondo, y estos lo estaban contra el claro: en
    // tema oscuro el gris y el verde se apagan contra el grafito. Ahora cada tarjeta dice su
    // SIGNIFICADO y es la paleta quien elige el tono en cada tema. La paridad con el escritorio se
    // pierde; si algún día se decide recuperarla, se recupera cambiando la paleta, no volviendo aquí.
    //
    // Las cadenas son var(…) y no colores de .NET porque solo se interpolan dentro de un atributo
    // style: quien las resuelve es el navegador.
    private const string SinEmpezar = "var(--rz-text-secondary-color)";
    private const string EnCurso    = "var(--rz-info)";
    private const string EnRiesgo   = "var(--rz-warning)";
    private const string Logrado    = "var(--rz-success)";
    private const string Problema   = "var(--rz-danger)";

    // «Pendientes» no es un estado del requerimiento: son notas y recordatorios, otra COSA. Por eso
    // no toma ningún color del semáforo —diría que algo va mal o algo va bien, y no dice ninguna de
    // las dos— y sale de la escala de series.
    private const string OtraCosa   = "var(--adminweb-serie-1)";

    private DashboardDto? _datos;

    /// <summary>
    /// Si la respuesta trajo los paneles de equipo. Se mira uno de los tres campos y no el rol de la
    /// sesión: lo que manda es lo que el servidor decidió enviar, no lo que el navegador cree ser.
    /// </summary>
    private bool HayDatosDeEquipo => _datos?.CargaPorDesarrollador is not null;

    protected override async Task OnInitializedAsync() =>
        _datos = await Api.LeerAsync<DashboardDto>("api/dashboard");

    private RenderFragment Tarjeta(string rotulo, int valor, string color) => __builder =>
    {
        <RadzenCard Style="@($"border-left:5px solid {color};flex:1 1 150px;min-width:150px;padding:0.75rem 1rem")">
            <RadzenText TextStyle="TextStyle.H4" Style="@($"color:{color};margin:0")">@valor</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" Style="margin:0">@rotulo</RadzenText>
        </RadzenCard>
    };

    // Atrasado = rojo y en negritas. El «atrasado» lo calculó el servidor con su propio reloj: un
    // equipo con la fecha mal puesta no puede pintar de rojo lo que va en tiempo.
    //
    // La negrita NO es adorno y va en las DOS rejillas: sobre el grafito del tema oscuro el rojo
    // pierde fuerza, y hay quien no lo distingue del texto normal. Si el color es la única señal, la
    // fila deja de decir nada para esa persona —y también impresa en blanco y negro.
    private void PintarEntrega(RowRenderEventArgs<EntregaProximaDto> args)
    {
        if (args.Data.Atrasado) args.Attributes["style"] = $"color:{Problema};font-weight:600";
    }

    private void PintarRecordatorio(RowRenderEventArgs<RecordatorioDto> args)
    {
        if (args.Data.Atrasado) args.Attributes["style"] = $"color:{Problema};font-weight:600";
    }

    private static string Fecha(DateTime? f, string siNoHay = "—") => f?.ToString("dd/MM/yyyy") ?? siNoHay;

    // Los tres círculos de colores que había aquí eran emojis, y era verdad lo que decía el comentario
    // anterior: el recorte de la fuente no trae una familia de tres niveles de prioridad, así que con
    // iconos de Material esto no se podía resolver. Pero había una tercera salida, y este repositorio
    // ya la usó: Componentes/BotonDeEstado.razor cambió cinco emojis de colores por un punto pintado
    // por nosotros. Un punto de CSS obedece al tema, se ve igual en todos los equipos y conserva lo
    // único que el emoji aportaba, que era el color. Por eso esto devuelve RenderFragment y no string:
    // hace falta marcado, y en una cadena no cabe.
    //
    // La palabra sigue al lado y NO es adorno: tres puntos de color solos no los distingue quien no
    // separa el rojo del verde, ni sobreviven a una impresión en blanco y negro. El borde gris tampoco
    // es decoración: si algún día falta la variable de color, el punto se queda hueco pero se sigue
    // viendo, en vez de desaparecer sin que nadie note que se rompió algo.
    //
    // Los colores van escritos y no toman las constantes de arriba a propósito: aquéllas nombran el
    // semáforo de las ENTREGAS (SinEmpezar, EnRiesgo, Problema…) y una nota urgente no es un problema
    // de entrega. Compartir la constante ataría dos significados que pueden querer separarse.
    private RenderFragment EtiquetaPrioridad(NotePriority p) => __builder =>
    {
        var color = p switch
        {
            NotePriority.Alta  => "var(--rz-danger)",
            NotePriority.Media => "var(--rz-warning)",
            _                  => "var(--rz-info)"
        };
        var texto = p switch
        {
            NotePriority.Alta  => "Alta",
            NotePriority.Media => "Media",
            _                  => "Baja"
        };

        <span style="white-space:nowrap;display:inline-flex;align-items:center;gap:.4rem">
            <span style="@($"width:.55rem;height:.55rem;flex:none;border-radius:50%;border:1px solid var(--rz-border-color);background:{color}")"></span>
            @texto
        </span>
    };

    // Todas las posiciones se pintan igual: #1, #2, #3, #4… Antes las tres primeras eran medallas de
    // oro, plata y bronce, y eran justo el aspecto poco serio que este trabajo venía a quitar —las
    // dibuja la fuente del sistema y en Windows salen en color aunque la pantalla entera sea
    // monocroma. Forzar military_tech / workspace_premium / star tampoco servía: son tres glifos del
    // MISMO color, o sea sin oro ni plata ni bronce, y la jerarquía se perdía igual. Con «#N» la
    // columna queda coherente de arriba abajo (la fila 4 ya se pintaba así) y el podio se sigue
    // leyendo, porque la tabla viene ordenada.
    private static string Posicion(int posicion) => $"#{posicion}";
}
