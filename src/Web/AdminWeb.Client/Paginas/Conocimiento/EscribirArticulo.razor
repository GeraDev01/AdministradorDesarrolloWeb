@page "/conocimiento/nuevo"
@page "/conocimiento/{Id:int}/editar"
@attribute [Authorize(Policy = "AdminUDesarrollador")]
@using AdminWeb.Shared.Dtos.Conocimiento
@inject ClienteApi Api
@inject HttpClient Http
@inject AvisosDeInterfaz Avisos
@inject NavigationManager Navegacion
@inject EstadoSesion Sesion

@*
    Escribir un artículo, o cambiar uno que ya existe.

    ── EMPIEZA EN BORRADOR, Y EL BORRADOR ES PRIVADO ──────────────────────────────────────────────

    Lo que se guarda aquí no lo ve nadie más —ni el líder— hasta que su autor lo manda a revisar. No
    es un detalle de permisos: si lo escrito a medias se pudiera leer, la gente escribiría en otro
    sitio hasta tenerlo presentable, y la base de conocimiento se quedaría sin la mitad de lo que
    debería contener. Por eso hay dos botones y no uno: guardar es una cosa, mandarlo es otra.

    ── NO HAY VISTA PREVIA DEL TEXTO, Y ES A PROPÓSITO ────────────────────────────────────────────

    Quien decide qué es un título, qué es un enlace y qué es código es el SERVIDOR: esa decisión es
    la que hace que un artículo no pueda ejecutar nada en el navegador de quien lo lea. Una vista
    previa dibujada aquí sería una SEGUNDA interpretación del mismo texto, hecha en la máquina de
    quien escribe, y en cuanto se separara de la de verdad enseñaría una cosa distinta de la que se
    va a publicar — que es peor que no enseñar nada. Lo que sí hay es la lista de las seis marcas
    que existen, ahí abajo: son pocas a propósito, y con eso se documenta cualquier cosa.

    Las IMÁGENES sí se ven mientras se escribe, y eso no contradice lo anterior porque aquí no se
    interpreta nada. Se enseña la imagen que YA está guardada en el artículo, pedida por su número a
    la misma ruta que la va a servir cuando el artículo se lea. Y hace falta verla: lo que se pega
    es una captura, y de un vistazo se sabe si es la que se quería o la de la ventana de al lado.

    Guardado el artículo, se abre para verlo tal como quedó de verdad.

    ── LAS IMÁGENES SE SUBEN AL PEGARLAS, Y ANTES QUE EL TEXTO ────────────────────────────────────

    Para que el cuerpo pueda NOMBRAR una imagen —![descripción](imagen:12)— hace falta que ya tenga
    número, y para tener número hace falta un artículo del que colgar. Por eso, si se pega una
    captura en un artículo que todavía no existe, se guarda solo el borrador antes de subirla: es lo
    único que evita el adjunto huérfano y, sobre todo, es lo que hace que pegar funcione a la
    primera. Pegar es lo que más se usa; obligar a guardar, salir y volver a entrar habría acabado
    con que nadie ponga capturas.
*@

<PageTitle>@(EsNuevo ? "Escribir un artículo" : "Editar el artículo")</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenButton Text="Volver" Icon="chevron_left" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small" Disabled="@_ocupado" Click="@Volver" />
        <RadzenText TextStyle="TextStyle.H5" Style="margin:0">
            @(EsNuevo ? "Escribir un artículo" : "Editar el artículo")
        </RadzenText>
    </RadzenStack>

    @if (_cargando)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else if (_noSePuede is { } motivo)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">@motivo</RadzenAlert>
    }
    else
    {
        <RadzenCard>
            <RadzenStack Gap="0.7rem">
                <RadzenTextBox @bind-Value="_titulo" MaxLength="@MaxTitulo" Style="width:100%"
                               Placeholder="Título: por aquí se va a encontrar"
                               aria-label="Título del artículo" Disabled="@_ocupado" />

                <RadzenTextBox @bind-Value="_etiquetas" MaxLength="@MaxEtiquetas" Style="width:100%"
                               Placeholder="Temas separados por comas: sql, despliegue, glosario…"
                               aria-label="Etiquetas" Disabled="@_ocupado" />

                @* Las etiquetas son el índice de la base, y por eso conviene decir aquí para qué
                   sirven: quien no lo sepa las deja vacías y su artículo solo se encuentra si alguien
                   acierta con una palabra del texto. *@
                <RadzenText TextStyle="TextStyle.Caption" Style="margin:0">
                    Los temas son el índice: es como se llega a «lo demás que habla de esto». Se guardan
                    en minúsculas para que «SQL» y «sql» no partan en dos el mismo tema.
                </RadzenText>

                <RadzenTextArea data-recorrido="escribir-cuerpo"
                                @bind-Value="_cuerpo" Rows="18" MaxLength="@MaxCuerpo" Style="width:100%"
                                aria-label="Texto del artículo" Disabled="@_ocupado"
                                Placeholder="Escribe aquí. Lo que sabes tú y todavía no está escrito en ningún sitio." />

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Caption" Style="margin:0">
                        @($"{Largo:N0} de {MaxCuerpo:N0} caracteres")
                        @if (Largo > MaxCuerpo * 0.9)
                        {
                            <text> — si no cabe, pártelo en varios artículos y enlázalos: así es como se encuentra después.</text>
                        }
                    </RadzenText>
                </RadzenStack>

                <details data-recorrido="escribir-marcas">
                    <summary style="cursor:pointer;font-size:.85rem">Las marcas que se entienden (son seis)</summary>
                    <RadzenText TextStyle="TextStyle.Caption" Style="margin:.4rem 0 0;white-space:pre-wrap">@Ayuda</RadzenText>
                </details>

                @* ── Imágenes ───────────────────────────────────────────────────────── *@
                <div data-recorrido="escribir-imagenes">
                    <RadzenStack Gap="0.5rem">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin:0">
                            <RadzenIcon Icon="image" /> Imágenes del artículo
                        </RadzenText>

                        @* El mismo componente que el foro: pegar con Ctrl+V dentro del recuadro, o
                           elegir el archivo. Aquí se sube EN CUANTO llega en vez de esperar al envío
                           del formulario, porque hasta que la imagen no tiene número no se la puede
                           nombrar desde el texto. *@
                        <PegarImagen Imagenes="@_pegadas" ImagenesChanged="@SubirImagenAsync"
                                     Maximo="1" MaxBytes="@MaxBytesImagen" />

                        @if (_imagenes.Count > 0)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="margin:0">
                                @($"{_imagenes.Count} de {MaxImagenes}.") Cambia el texto entre corchetes
                                por lo que describe cada imagen: es lo que se lee cuando no carga, y lo
                                que oye quien usa un lector de pantalla.
                            </RadzenText>

                            <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.6rem">
                                @foreach (var img in _imagenes)
                                {
                                    <div style="border:1px solid var(--rz-border-color);border-radius:var(--rz-border-radius);padding:.35rem;max-width:200px">
                                        @* La ruta se arma con el NÚMERO, igual que al leer el artículo:
                                           es la misma imagen y el mismo camino, así que lo que se ve
                                           aquí es exactamente lo que se va a publicar. *@
                                        <img src="@Ruta(img)" alt="@img.Nombre" loading="lazy"
                                             style="display:block;max-width:100%;height:auto" />
                                        <RadzenText TextStyle="TextStyle.Caption"
                                                    Style="margin:.25rem 0 0;overflow-wrap:anywhere">
                                            @img.Nombre
                                        </RadzenText>
                                        <RadzenButton Text="Poner en el texto" Icon="add"
                                                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                                      Disabled="@_ocupado" Click="@(() => PonerMarca(img))"
                                                      title="Añade su marca al final del texto" />
                                    </div>
                                }
                            </RadzenStack>
                        }
                    </RadzenStack>
                </div>
            </RadzenStack>
        </RadzenCard>

        <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.5rem">
            <RadzenButton data-recorrido="escribir-borrador"
                          Text="@(EsNuevo ? "Guardar borrador" : "Guardar")" Icon="save"
                          ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Disabled="@_ocupado" Click="@(() => GuardarAsync(mandar: false))" />

            @if (PuedeMandar)
            {
                @* Guardar y mandar en un solo botón: si fueran dos pasos, el segundo se olvidaría y el
                   artículo se quedaría en un borrador que nadie va a leer nunca. *@
                <RadzenButton data-recorrido="escribir-mandar"
                              Text="Guardar y mandar a revisar" Icon="send" ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small" Disabled="@_ocupado"
                              Click="@(() => GuardarAsync(mandar: true))" />
            }

            <RadzenButton Text="Cancelar" Icon="close" ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small" Disabled="@_ocupado" Click="@Volver" />
        </RadzenStack>

        @if (_estado == KnowledgeStatus.Publicado && !EsNuevo)
        {
            @* El aviso se bifurca por rol porque el servidor se bifurca: editar lo publicado devuelve
               el artículo a la cola SALVO que quien edite sea el líder, cuya edición ya está revisada
               por definición —que es lo que significa que él sea el revisor—. Un aviso único prometía
               al líder una cola por la que su cambio no iba a pasar, y un aviso que no se cumple
               enseña a no leer los avisos. Es la misma bifurcación que ya hace el artículo abierto. *@
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">
                @if (_esAdmin)
                {
                    <text>
                        Este artículo está publicado. Tus cambios se ven en cuanto guardas: tu edición ya
                        está revisada por definición, porque el revisor eres tú.
                    </text>
                }
                else
                {
                    <text>
                        Este artículo está publicado. Al guardarlo vuelve a la cola de revisión, porque lo
                        que el equipo lee tiene que haber pasado por ahí — si no, bastaría con publicar
                        algo inocuo y cambiarlo después.
                    </text>
                }
            </RadzenAlert>
        }
    }
</RadzenStack>

@code {
    /// <summary>El artículo que se edita. Null cuando se está escribiendo uno nuevo.</summary>
    [Parameter]
    public int? Id { get; set; }

    /// <summary>
    /// Los topes, repetidos aquí porque el navegador no ve las constantes del servidor. Sirven para
    /// avisar antes y para que el campo no deje teclear de más; el que cuenta lo sigue aplicando el
    /// servidor.
    /// </summary>
    private const int MaxTitulo = 200;
    private const int MaxEtiquetas = 300;
    private const int MaxCuerpo = 20_000;

    /// <summary>
    /// Los topes de las imágenes, y valen lo mismo que arriba: el que cuenta lo aplica
    /// <c>ConocimientoService</c>. Aquí sirven para avisar antes de subir dos megas para que los
    /// rechacen, y para que el recuadro de pegar diga en su texto cuánto cabe.
    /// </summary>
    private const int MaxImagenes = 12;
    private const long MaxBytesImagen = 2L * 1024 * 1024;

    /// <summary>Lo mínimo para que valga la pena hacer que el líder abra la cola.</summary>
    private const int MinCuerpoParaMandar = 40;

    private const string Ayuda =
        "# Título    ##  y  ###  para las secciones de dentro\n" +
        "- punto de una lista        1. punto numerado\n" +
        "**negrita**                 `código dentro de una línea`\n" +
        "```sql   …líneas de código…   ```   (las tres comillas, en su propia línea)\n" +
        "Las direcciones se vuelven enlaces solas; para ponerles nombre, [así](https://…).\n" +
        "![lo que se ve](imagen:12)   una imagen ya subida aquí abajo, SOLA en su renglón.\n\n" +
        "Todo lo demás es texto tal cual. No hay tablas ni HTML, y las imágenes son las que se " +
        "suben aquí: una dirección de fuera no se incrusta, se queda en enlace. Dentro de un bloque " +
        "de código no se interpreta nada, así que un script lleno de # comentarios no se convierte " +
        "en títulos.";

    private string _titulo = "", _cuerpo = "", _etiquetas = "";
    private KnowledgeStatus _estado = KnowledgeStatus.Borrador;
    private bool _cargando, _ocupado, _esAdmin;
    private string? _noSePuede;

    /// <summary>
    /// Si el SERVIDOR dice que quien está aquí puede mandar ESTE artículo a revisar. Se cree lo que
    /// venga en el artículo y no se deduce del estado, que es lo que se hacía y estaba mal: mandar a
    /// revisar es solo de su AUTOR, así que el líder editando algo devuelto de otra persona veía el
    /// botón, guardaba, y se llevaba un «solo su autor puede mandarlo a revisar» con el texto ya
    /// escrito. La regla vive en un sitio, y no es éste.
    /// </summary>
    private bool _puedoEnviar;

    /// <summary>
    /// Qué artículo hay cargado en el formulario. Existe para no volver a traerlo del servidor cuando
    /// la pantalla se vuelve a preparar sin haber cambiado de artículo: recargar aquí no es refrescar,
    /// es TIRAR lo que la persona lleva escrito y no ha guardado todavía.
    /// </summary>
    private int? _enElFormulario;
    private bool _preparado;

    /// <summary>Las imágenes que ya tiene el artículo, con la marca con la que nombrarlas.</summary>
    private List<ConocimientoImagenDto> _imagenes = [];

    /// <summary>
    /// Lo que acaba de llegar del portapapeles o del selector de archivos. Se vacía en cuanto se
    /// sube: este componente es el conducto de UNA imagen cada vez, no una lista que se envía al
    /// final — a diferencia del foro, aquí la imagen tiene que estar guardada antes de que el texto
    /// pueda nombrarla.
    /// </summary>
    private List<ImagenAdjunta> _pegadas = [];

    /// <summary>
    /// El artículo que se creó SOLO para poder colgar de él la primera imagen, cuando se pegó una
    /// captura en uno que todavía no existía. Desde ese momento esta pantalla ya edita algo real
    /// aunque la dirección siga siendo la de «nuevo»: guardar tiene que ir a ESE artículo y no crear
    /// un segundo, que es lo que pasaría si el guardado siguiera mirando solo la ruta.
    /// </summary>
    private int? _guardado;

    private bool EsNuevo => Id is null;

    /// <summary>El artículo con el que se está trabajando de verdad. Null mientras no exista ninguno.</summary>
    private int? IdActual => Id ?? _guardado;

    private int Largo => _cuerpo?.Length ?? 0;

    /// <summary>
    /// Mandar a revisar solo tiene sentido mientras el artículo esté en manos de SU AUTOR. Uno nuevo
    /// lo es siempre —lo acaba de escribir quien está aquí—; para el resto manda lo que dijo el
    /// servidor, no lo que esta pantalla pueda deducir del estado.
    /// </summary>
    private bool PuedeMandar => EsNuevo || _puedoEnviar;

    protected override async Task OnInitializedAsync()
    {
        // Solo para saber qué avisar sobre lo publicado. Quién puede hacer qué lo sigue diciendo el
        // servidor en cada artículo; esto no abre ni cierra ningún botón.
        var usuario = Sesion.Usuario ?? await Sesion.RefrescarAsync();
        _esAdmin = usuario?.Rol == UserRole.Admin;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Ya está preparado para ESTE artículo: no se toca nada.
        if (_preparado && _enElFormulario == Id) return;
        _preparado = true;
        _enElFormulario = Id;

        if (EsNuevo)
        {
            // Se entra a escribir uno nuevo, quizá desde el que se acababa de editar: la pantalla se
            // reutiliza, así que hay que dejarla en blanco a mano. El borrador que se hubiera creado
            // para colgar una imagen también se olvida: aquel artículo ya no es éste.
            _titulo = _cuerpo = _etiquetas = "";
            _estado = KnowledgeStatus.Borrador;
            _puedoEnviar = false;   // uno nuevo se manda por ser nuevo, no por este permiso
            _noSePuede = null;
            _guardado = null;
            _imagenes = [];
            _pegadas = [];
            return;
        }

        _cargando = true;
        _noSePuede = null;
        var a = await Api.LeerAsync<ConocimientoArticuloDto>($"api/conocimiento/{Id}");
        _cargando = false;

        if (a is null)
        {
            _noSePuede = "Ese artículo no existe o no está disponible para ti.";
            return;
        }

        if (!a.PuedoEditar)
        {
            _noSePuede = "Solo puedes editar lo que tú escribiste.";
            return;
        }

        _titulo = a.Titulo;
        _etiquetas = a.Etiquetas ?? "";
        _estado = a.Estado;
        _puedoEnviar = a.PuedoEnviar;

        // Se edita la FUENTE —el texto con su marcado sin interpretar—, nunca los bloques ya
        // analizados: el análisis es de ida, y reconstruir el original a partir de él perdería
        // exactamente lo que el autor escribió.
        _cuerpo = a.Fuente ?? "";

        _guardado = null;   // se edita el de la ruta; no hay ninguno creado a medias
        _pegadas = [];
        await CargarImagenesAsync();
    }

    /// <summary>
    /// Trae las imágenes que ya tiene el artículo. Sin ellas, quien vuelve a editar no tendría cómo
    /// volver a nombrar una captura cuya marca borró del texto, y acabaría subiéndola otra vez.
    /// </summary>
    private async Task CargarImagenesAsync()
    {
        if (IdActual is not int id) { _imagenes = []; return; }
        _imagenes = await Api.LeerAsync<List<ConocimientoImagenDto>>($"api/conocimiento/{id}/imagenes") ?? [];
    }

    /// <summary>
    /// Guarda, y si se pidió, manda a revisar acto seguido.
    ///
    /// <para>Las validaciones de fondo —título corto, cuerpo insuficiente, quién puede editar qué—
    /// las hace el servidor y su mensaje se enseña TAL CUAL. Aquí solo se adelanta lo que evitaría un
    /// viaje seguro a un rechazo, y con el mismo texto que daría el servidor.</para>
    /// </summary>
    private async Task GuardarAsync(bool mandar)
    {
        if (mandar && _cuerpo.Trim().Length < MinCuerpoParaMandar)
        {
            Avisos.Aviso($"Para mandarlo a revisar escribe al menos {MinCuerpoParaMandar} caracteres.");
            return;
        }

        _ocupado = true;
        try
        {
            var cuerpo = new ConocimientoEscrituraDto(_titulo, _cuerpo, _etiquetas);
            int id;

            // Se mira IdActual y no la ruta: si al pegar una captura se creó el borrador, este
            // artículo YA existe aunque se haya entrado por «/conocimiento/nuevo», y guardar tiene
            // que actualizarlo. Mirando la ruta se crearía un segundo artículo cada vez que se
            // guardara, y la imagen se quedaría colgando del primero.
            if (IdActual is not int existente)
            {
                var (ok, creado) = await Api.EnviarAsync<ConocimientoEscrituraDto, ConocimientoCreadoDto>(
                    "api/conocimiento", cuerpo);
                if (!ok || creado is null) return;

                id = creado.Id;
                if (!mandar) Avisos.Exito(creado.Mensaje);
            }
            else
            {
                var r = await Http.CambiarAsync($"api/conocimiento/{existente}", cuerpo);
                if (!r.Ok)
                {
                    if (!string.IsNullOrEmpty(r.Mensaje)) Avisos.Error(r.Mensaje);
                    return;
                }

                id = existente;
                if (!mandar) Avisos.Exito(r.Mensaje);
            }

            if (mandar)
            {
                var (ok, enviado) = await Api.EnviarAsync<object?, ResultadoDto>(
                    $"api/conocimiento/{id}/enviar", null);

                // Si el envío falla, el texto YA está guardado: se dice qué pasó y se abre el
                // artículo igual, para que nadie se quede pensando que perdió lo que escribió.
                if (ok && enviado is not null) Avisos.Resultado(enviado.Ok, enviado.Mensaje);
            }

            // Los contadores del menú pudieron cambiar por los dos lados: un borrador nuevo, o algo
            // que acaba de entrar en la cola del líder.
            PendientesDeConocimiento.Avisar();
            Navegacion.NavigateTo($"conocimiento/{id}");
        }
        finally { _ocupado = false; }
    }

    // ── Imágenes ─────────────────────────────────────────────────────────────────

    /// <summary>
    /// Sube la imagen que se acaba de pegar o de elegir, y deja su marca puesta en el texto.
    ///
    /// <para><b>Se sube ahora y no al guardar</b>, al revés que en el foro: allí las imágenes viajan
    /// con el formulario y se evita así el adjunto huérfano, pero aquí el texto tiene que poder
    /// NOMBRAR la imagen, y para nombrarla hace falta el número que solo existe una vez guardada. El
    /// huérfano se evita por el otro lado: la imagen cuelga del artículo desde el primer momento y se
    /// va con él si se borra.</para>
    ///
    /// <para>Los topes de peso y de formato los aplica el servidor mirando los BYTES; el recuadro de
    /// pegar ya frena lo que se pase de tamaño antes de subirlo, que es cortesía y no defensa.</para>
    /// </summary>
    private async Task SubirImagenAsync(List<ImagenAdjunta> imagenes)
    {
        // El componente es un conducto, no una lista: se vacía en el acto para que la siguiente
        // captura entre por el mismo sitio sin que haya que quitar la anterior a mano.
        _pegadas = [];

        if (imagenes.Count == 0) return;
        var imagen = imagenes[^1];

        _ocupado = true;
        try
        {
            if (await AsegurarArticuloAsync() is not int id) return;

            // El tipo de contenido NO se declara a propósito: el servidor decide qué es el archivo
            // mirando sus bytes, y creerle al navegador sería justo lo que se quiere evitar. Es la
            // misma regla que sigue EnvioDeImagenes en el foro; no se reutiliza aquel porque manda
            // además la miniatura, y aquí no hay miniatura que guardar.
            var formulario = new MultipartFormDataContent
            {
                { new ByteArrayContent(imagen.Contenido), "imagen", imagen.Nombre }
            };

            var (ok, subida) = await Api.SubirAsync<ConocimientoImagenDto>(
                $"api/conocimiento/{id}/imagenes", formulario);
            if (!ok || subida is null) return;

            _imagenes = [.. _imagenes, subida];
            PonerMarca(subida);
        }
        finally { _ocupado = false; }
    }

    /// <summary>
    /// El artículo del que colgar la imagen, creándolo como borrador si todavía no existe.
    ///
    /// <para>Es lo que hace que pegar funcione a la primera mientras se escribe algo nuevo. Lo que se
    /// crea es un borrador privado —no lo ve nadie más— con lo que haya escrito hasta ese momento, y
    /// se dice que se hizo: guardar por tu cuenta algo que la persona no pidió guardar, y callarlo,
    /// es de las cosas que hacen desconfiar de una pantalla.</para>
    ///
    /// <para>Si el servidor rechaza la creación —el título todavía es corto, que es el caso normal—
    /// se enseña SU mensaje y no se sube nada: no hay artículo del que colgar la imagen.</para>
    /// </summary>
    private async Task<int?> AsegurarArticuloAsync()
    {
        if (IdActual is int id) return id;

        var (ok, creado) = await Api.EnviarAsync<ConocimientoEscrituraDto, ConocimientoCreadoDto>(
            "api/conocimiento", new ConocimientoEscrituraDto(_titulo, _cuerpo, _etiquetas));

        if (!ok || creado is null) return null;

        _guardado = creado.Id;
        Avisos.Exito("Se guardó el borrador para poder guardar la imagen. Sigue siendo privado.");
        PendientesDeConocimiento.Avisar();
        return creado.Id;
    }

    /// <summary>
    /// Pone la marca de una imagen al final del texto, en su propio renglón — que es como se
    /// reconoce.
    ///
    /// <para>Al final y no donde está el cursor: llevar el cursor de un <c>textarea</c> exige bajar a
    /// JavaScript, y lo que se ganaría no compensa. Mover una línea es un corte y un pegado, y así lo
    /// dice el aviso.</para>
    /// </summary>
    private void PonerMarca(ConocimientoImagenDto imagen)
    {
        var texto = _cuerpo ?? "";
        var separador = texto.Length == 0 ? "" : texto.EndsWith("\n") ? "\n" : "\n\n";

        _cuerpo = texto + separador + imagen.Marca + "\n";

        // El tope del cuerpo lo aplica el servidor, pero si la marca no cabe conviene decirlo aquí:
        // el mensaje del rechazo llegaría al guardar, cuando ya no se entiende qué lo causó.
        if (_cuerpo.Length > MaxCuerpo)
            Avisos.Aviso($"El texto pasa de {MaxCuerpo:N0} caracteres. Recorta antes de guardar.");
    }

    /// <summary>
    /// La ruta de una imagen del artículo. Se arma con el NÚMERO, igual que al leerlo: lo que se ve
    /// aquí sale de la misma ruta que lo servirá después, así que no puede enseñar una cosa distinta
    /// de la que se va a publicar.
    /// </summary>
    private static string Ruta(ConocimientoImagenDto imagen) => $"api/adjuntos/conocimiento/{imagen.Id}";

    /// <summary>Volver: al artículo si ya existe —incluido el borrador que se creó para una imagen—,
    /// y a la lista si todavía no hay ninguno.</summary>
    private void Volver() =>
        Navegacion.NavigateTo(IdActual is int id ? $"conocimiento/{id}" : "conocimiento");
}
