@page "/usuarios"
@attribute [Authorize(Policy = "SoloAdmin")]
@using AdminWeb.Shared.Dtos.Personas
@implements IDisposable
@inject ClienteApi Api
@inject AvisosDeInterfaz Avisos
@inject Descargas Descargas

@*
    Cuentas de acceso. Réplica de UserManagementControl.

    Decisiones del escritorio que se conservan:

      · «Desbloquear» levanta el bloqueo por intentos fallidos y NO toca la contraseña. Antes solo
        caducaba por tiempo, así que el líder no podía hacer nada por alguien que estuviera esperando
        a su lado.
      · Antes de eliminar se avisa de las DOS cosas por las que alguien se arrepentiría: que una
        cuenta de líder no se puede borrar, y que el histórico pierde la atribución.
      · «Activar/Desactivar» existe aparte de eliminar y el texto lo dice: si solo quieres quitarle el
        acceso un tiempo, eso es lo que hay que usar.

    Lo que CAMBIA respecto al escritorio, y por qué:

      · La contraseña ya no la teclea el líder, ni al dar de alta ni al restablecer: la genera el
        servidor y se enseña UNA vez. Una contraseña escrita por otra persona viaja por chat, se
        repite entre cuentas y sobrevive al primer inicio de sesión; la temporal obliga a cambiarla al
        entrar. El restablecimiento ya funcionaba así desde que se portó AuthService.
      · Cambiar el rol, cambiar la ficha ligada o desactivar CIERRAN la sesión abierta de esa cuenta.
        En el escritorio la sesión moría con el proceso; aquí vive en una cookie de ocho horas que
        lleva el rol dentro, así que sin esto a quien se le quita el rol de líder seguiría entrando a
        las pantallas de líder toda la tarde.

    Ni el hash de la contraseña ni el sello de sesión llegan al navegador: el servidor no los manda.
*@

<PageTitle>Usuarios</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.H5" class="rz-mb-0">Usuarios</RadzenText>
        <RadzenButton Text="➕ Nuevo usuario" Disabled="@_ocupado" Click="@AbrirAlta" />
        <RadzenButton Text="Recargar" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small" Click="@Cargar" Disabled="@_ocupado" />
    </RadzenStack>

    @if (_datos is { } datos)
    {
        <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
            @datos.IntentosParaBloquear intentos fallidos bloquean la cuenta @datos.MinutosDeBloqueo minutos.
            «Desbloquear» levanta ese bloqueo sin tocar la contraseña.
        </RadzenText>

        @if (_capturando)
        {
            <RadzenCard>
                <RadzenStack Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                        @(_editandoId is null ? "Nueva cuenta" : $"Editar la cuenta «{_usuario}»")
                    </RadzenText>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap"
                                 AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Usuario" Component="usuario" />
                            <RadzenTextBox @bind-Value="_usuario" Name="usuario" MaxLength="100" Style="width:14rem" />
                        </RadzenStack>

                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Nombre" Component="nombre" />
                            <RadzenTextBox @bind-Value="_nombre" Name="nombre" MaxLength="200" Style="width:20rem" />
                        </RadzenStack>

                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Rol" Component="rol" />
                            <RadzenDropDown TValue="UserRole" @bind-Value="_rol" Name="rol"
                                            Data="@Roles" TextProperty="Texto" ValueProperty="Valor"
                                            Style="width:14rem" />
                        </RadzenStack>

                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Ficha de desarrollador" Component="ficha" />
                            @* Opcional: hay cuentas sin ficha (Operaciones) y fichas sin cuenta. Es
                               esta ligadura la que hace que los comunicados y los puntos lleguen a
                               la persona correcta. *@
                            <RadzenDropDown TValue="int?" @bind-Value="_developerId" Name="ficha"
                                            Data="@datos.Desarrolladores" TextProperty="Texto" ValueProperty="Id"
                                            AllowClear="true" Placeholder="Sin ficha" Style="width:20rem" />
                        </RadzenStack>

                        @if (_editandoId is not null)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenCheckBox TValue="bool" @bind-Value="_activo" Name="activo" />
                                <RadzenLabel Text="Cuenta activa" Component="activo" />
                            </RadzenStack>
                        }
                    </RadzenStack>

                    @if (_editandoId is null)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                            La contraseña la genera el servidor y se muestra una sola vez al guardar.
                            Quien entre con ella tendrá que cambiarla de inmediato.
                        </RadzenText>
                    }

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <RadzenButton Text="Guardar" Disabled="@_ocupado" Click="@GuardarCuenta" />
                        <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light"
                                      Disabled="@_ocupado" Click="@(() => _capturando = false)" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        }

        @if (_temporal is { } temporal)
        {
            @* Se enseña en la pantalla y no en un aviso pasajero: hay que poder copiarla, y un aviso
               que se desvanece a los cuatro segundos obligaría a restablecerla otra vez. *@
            <RadzenCard Style="border-left:6px solid var(--rz-warning)">
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">
                        🔑 Contraseña temporal de «@_temporalDe»
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">
                        <code>@temporal</code>
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                        Se muestra UNA sola vez: no se guarda en ningún sitio en claro. Si se pierde,
                        vuelve a restablecerla.
                    </RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <RadzenButton Text="Copiar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@(() => Copiar(temporal))" />
                        <RadzenButton Text="Ocultar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@(() => _temporal = null)" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        }

        <RadzenDataGrid TItem="UsuarioDto" Data="@datos.Usuarios" IsLoading="@_ocupado"
                        AllowSorting="true" AllowPaging="true" PageSize="20"
                        RowRender="@ApagarInactivos" EmptyText="No hay cuentas.">
            <Columns>
                <RadzenDataGridColumn TItem="UsuarioDto" Property="Id" Title="ID" Width="70px" />
                <RadzenDataGridColumn TItem="UsuarioDto" Property="Usuario" Title="Usuario" Width="160px" />
                <RadzenDataGridColumn TItem="UsuarioDto" Property="Nombre" Title="Nombre" />
                <RadzenDataGridColumn TItem="UsuarioDto" Property="RolTexto" Title="Rol" Width="140px" />
                <RadzenDataGridColumn TItem="UsuarioDto" Property="Desarrollador" Title="Ficha" Width="180px">
                    <Template Context="u">@(u.Desarrollador ?? "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UsuarioDto" Property="Activo" Title="Activo" Width="90px">
                    <Template Context="u">@(u.Activo ? "✓" : "✗")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UsuarioDto" Title="Acceso" Width="200px" Sortable="false">
                    <Template Context="u">
                        <span style="@EstiloDeAcceso(u)" title="@ExplicacionDeAcceso(u, datos)">@Acceso(u, datos)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UsuarioDto" Property="AltaUtc" Title="Alta" Width="150px">
                    <Template Context="u">@u.AltaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UsuarioDto" Title="" Width="380px" Sortable="false">
                    <Template Context="u">
                        <RadzenButton Text="✏ Editar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                      Disabled="@_ocupado" Click="@(() => AbrirEdicion(u))" />
                        <RadzenButton Text="🔑 Contraseña" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                      Disabled="@_ocupado" Click="@(() => Restablecer(u))" />
                        <RadzenButton Text="🔓 Desbloquear" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                      Disabled="@_ocupado" Click="@(() => Desbloquear(u))" />
                        <RadzenButton Text="@(u.Activo ? "⚡ Desactivar" : "⚡ Activar")"
                                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                      Disabled="@_ocupado" Click="@(() => Alternar(u))" />
                        <RadzenButton Text="🗑 Eliminar" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                      Disabled="@_ocupado" Click="@(() => Eliminar(u))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    /// <summary>Los tres roles, con el mismo texto que pinta la rejilla.</summary>
    private static readonly OpcionDeRol[] Roles =
    [
        new(UserRole.Admin, "Admin"),
        new(UserRole.Operaciones, "Operaciones"),
        new(UserRole.Desarrollador, "Desarrollador")
    ];

    private sealed record OpcionDeRol(UserRole Valor, string Texto);

    private readonly CancellationTokenSource _cancelacion = new();

    private PantallaDeUsuariosDto? _datos;
    private bool _ocupado;

    // Alta y edición.
    private bool _capturando;
    private int? _editandoId;
    private string _usuario = "";
    private string _nombre = "";
    private UserRole _rol = UserRole.Desarrollador;
    private int? _developerId;
    private bool _activo = true;

    // La contraseña temporal recién generada, a la vista hasta que se oculte.
    private string? _temporal;
    private string _temporalDe = "";

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        _ocupado = true;
        try
        {
            var datos = await Api.LeerAsync<PantallaDeUsuariosDto>("api/personas/usuarios", _cancelacion.Token);
            if (datos is not null) _datos = datos;
        }
        finally { _ocupado = false; }
    }

    // ── Alta y edición ───────────────────────────────────────────────────────

    private void AbrirAlta()
    {
        _editandoId  = null;
        _usuario     = "";
        _nombre      = "";
        _rol         = UserRole.Desarrollador;
        _developerId = null;
        _activo      = true;
        _capturando  = true;
    }

    private void AbrirEdicion(UsuarioDto u)
    {
        _editandoId  = u.Id;
        _usuario     = u.Usuario;
        _nombre      = u.Nombre;
        _rol         = u.Rol;
        _developerId = u.DeveloperId;
        _activo      = u.Activo;
        _capturando  = true;
    }

    private async Task GuardarCuenta()
    {
        // Solo lo evidente se comprueba aquí; el usuario repetido, la ficha ya ligada y el «última
        // cuenta de líder» los valida el servidor, que es donde esas reglas tienen que vivir.
        if (string.IsNullOrWhiteSpace(_usuario) || string.IsNullOrWhiteSpace(_nombre))
        {
            Avisos.Aviso("El usuario y el nombre son obligatorios.");
            return;
        }

        if (_editandoId is int id)
        {
            if (await Enviar($"api/personas/usuarios/{id}/editar",
                    new ActualizarUsuarioRequest(id, _usuario, _nombre, _rol, _developerId, _activo)))
                _capturando = false;
            return;
        }

        _ocupado = true;
        try
        {
            var (ok, r) = await Api.EnviarAsync<CrearUsuarioRequest, ContrasenaTemporalDto>(
                "api/personas/usuarios",
                new CrearUsuarioRequest(_usuario, _nombre, _rol, _developerId), _cancelacion.Token);

            if (!ok || r is null) return;

            Avisos.Exito(r.Mensaje);
            MostrarTemporal(_usuario, r.Temporal);
            _capturando = false;
            await Cargar();
        }
        finally { _ocupado = false; }
    }

    // ── Acciones sobre una cuenta ────────────────────────────────────────────

    private async Task Restablecer(UsuarioDto u)
    {
        if (!await Avisos.ConfirmarAsync(
                $"¿Restablecer la contraseña de «{u.Usuario}»? Se generará una temporal, tendrá que " +
                "cambiarla al entrar y su sesión abierta, si la tiene, se cerrará.",
                "Restablecer contraseña", "Sí, restablecerla"))
            return;

        _ocupado = true;
        try
        {
            var (ok, r) = await Api.EnviarAsync<object?, ContrasenaTemporalDto>(
                $"api/personas/usuarios/{u.Id}/contrasena", null, _cancelacion.Token);

            if (!ok || r is null) return;

            Avisos.Exito(r.Mensaje);
            MostrarTemporal(u.Usuario, r.Temporal);
            await Cargar();
        }
        finally { _ocupado = false; }
    }

    private Task Desbloquear(UsuarioDto u) =>
        Enviar<object?>($"api/personas/usuarios/{u.Id}/desbloquear", null);

    private async Task Alternar(UsuarioDto u)
    {
        if (u.Activo && !await Avisos.ConfirmarAsync(
                $"¿Desactivar a «{u.Usuario}»? Deja de poder entrar y su sesión abierta se cierra. " +
                "Sus datos y su histórico no se tocan.",
                "Desactivar cuenta", "Sí, desactivarla"))
            return;

        await Enviar<object?>($"api/personas/usuarios/{u.Id}/activo", null);
    }

    private async Task Eliminar(UsuarioDto u)
    {
        // Se avisa ANTES de confirmar, no después: son las dos razones por las que alguien se
        // arrepentiría de pulsar el botón. Es la misma advertencia del escritorio.
        if (u.Rol == UserRole.Admin)
        {
            Avisos.Aviso($"«{u.Usuario}» es líder y no se puede eliminar. Si de verdad quieres darlo de " +
                         "baja, cámbiale antes el rol o desactívalo.");
            return;
        }

        if (!await Avisos.ConfirmarEscribiendoAsync(
                $"Vas a eliminar la cuenta «{u.Usuario}» ({u.Nombre}).\n\n" +
                "⚠  Los registros del histórico que le apuntan quedarán sin atribución (puntos " +
                "asignados, revisiones, despliegues iniciados…). La bitácora conserva su nombre.\n\n" +
                "Si solo quieres quitarle el acceso temporalmente, usa «Desactivar» en su lugar. " +
                "Esta acción no se puede deshacer.",
                u.Usuario, "Eliminar usuario"))
            return;

        await Enviar<object?>($"api/personas/usuarios/{u.Id}/eliminar", null);
    }

    /// <summary>
    /// El envío que comparten las acciones. El mensaje del servidor se enseña TAL CUAL: dice el
    /// motivo concreto —«es la única cuenta de líder activa»— y cambiarlo por un «no se pudo»
    /// genérico tiraría lo que el escritorio hacía bien.
    /// </summary>
    private async Task<bool> Enviar<T>(string ruta, T cuerpo)
    {
        _ocupado = true;
        try
        {
            var (ok, r) = await Api.EnviarAsync<T, ResultadoDto>(ruta, cuerpo, _cancelacion.Token);
            if (ok && r is not null) Avisos.Exito(r.Mensaje);
            if (ok) await Cargar();
            return ok;
        }
        finally { _ocupado = false; }
    }

    private void MostrarTemporal(string usuario, string? temporal)
    {
        _temporal = temporal;
        _temporalDe = usuario;
    }

    private async Task Copiar(string texto)
    {
        if (!await Descargas.CopiarAsync(texto))
            Avisos.Aviso("El navegador no dejó copiar al portapapeles. Cópiala a mano.");
    }

    // ── Textos y pintado ─────────────────────────────────────────────────────

    private static string Acceso(UsuarioDto u, PantallaDeUsuariosDto datos) =>
        u.Bloqueado ? $"🔒 Hasta {u.BloqueadoHastaUtc!.Value.ToLocalTime():HH:mm}"
        : u.IntentosFallidos > 0 ? $"⚠ {u.IntentosFallidos}/{datos.IntentosParaBloquear} fallidos"
        : u.DebeCambiarContrasena ? "🔑 Contraseña temporal sin cambiar"
        : "";

    private static string ExplicacionDeAcceso(UsuarioDto u, PantallaDeUsuariosDto datos) =>
        u.Bloqueado
            ? $"Bloqueada por {datos.IntentosParaBloquear} intentos fallidos hasta las " +
              $"{u.BloqueadoHastaUtc!.Value.ToLocalTime():HH:mm}. Usa «Desbloquear» para levantarlo ya."
        : u.IntentosFallidos > 0
            ? $"Lleva {u.IntentosFallidos} intento(s) fallido(s). A los {datos.IntentosParaBloquear} " +
              $"la cuenta se bloquea {datos.MinutosDeBloqueo} minutos."
            : "";

    private static string EstiloDeAcceso(UsuarioDto u) =>
        u.Bloqueado ? "color:var(--rz-danger);font-weight:600"
        : u.IntentosFallidos > 0 || u.DebeCambiarContrasena ? "color:var(--rz-warning)"
        : "";

    private static void ApagarInactivos(RowRenderEventArgs<UsuarioDto> args)
    {
        if (!args.Data.Activo) args.Attributes["style"] = "opacity:.6";
    }

    public void Dispose()
    {
        _cancelacion.Cancel();
        _cancelacion.Dispose();
    }
}
