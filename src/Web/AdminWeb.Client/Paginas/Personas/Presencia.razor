@page "/presencia"
@attribute [Authorize(Policy = "SoloAdmin")]
@using AdminWeb.Shared.Dtos.Personas
@implements IDisposable
@inject ClienteApi Api
@inject AvisosDeInterfaz Avisos
@inject ConexionEnVivo EnVivo
@inject Descargas Descargas

@*
    Quién está, la asistencia oficial y el registro automático de jornadas. Réplica de
    PresenceControl.

    Las tres pestañas miden cosas distintas y por eso siguen separadas:

      · «Quién está» es el AHORA: quién tiene la aplicación abierta y en qué anda.
      · «Asistencia» es lo que cada quien DECLARA marcando entrada y salida. Es el registro oficial,
        el que se consulta a diario, y por eso va antes que el automático — igual que en el escritorio.
      · «Registro de jornadas» es lo que la aplicación puede ver SOLA. Es el contraste, se mira
        cuando algo no cuadra.

    Ninguna se deduce de la otra: es justamente la diferencia entre ambas lo que delata un olvido.

    LOS ESTADOS NO SE HISTORIZAN, y esta pantalla no ofrece ninguna forma de consultarlos hacia
    atrás porque no existe tal cosa. Es una decisión ética heredada del escritorio: un registro
    minutado de las pausas de alguien es vigilancia, no asistencia. Lo que sí queda es la jornada: a
    qué hora entró y a qué hora salió.

    «Ausente» tampoco se elige aquí ni en ningún sitio: lo pone el servidor cuando alguien deja de
    dar señales durante más de la tolerancia.

    Lo que cambia respecto al escritorio: corregir un registro y dar de alta un día olvidado se hacen
    en un panel dentro de la misma pantalla y no en una ventana modal aparte. Son el mismo formulario
    y las mismas reglas —el servidor sigue validando—, pero en el navegador una ventana modal encima
    de otra pantalla se pierde detrás del propio navegador con demasiada facilidad.
*@

<PageTitle>Quién está</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.H5" class="rz-mb-0">Quién está</RadzenText>
        <RadzenButton Text="Actualizar" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small" Click="@CargarTodo" Disabled="@_ocupado" />
    </RadzenStack>

    <RadzenTabs>
        <Tabs>
            @* «sensors» (las ondas de señal) y no un círculo verde: la pestaña lista a TODO el mundo,
               conectado o no, y un verde en el rótulo prometía que solo salían los disponibles. Es
               además el glifo que Menu.cs le dio a la entrada «Quién está», así que la puerta y la
               pantalla a la que se llega se reconocen como la misma cosa. *@
            <RadzenTabsItem Text="Quién está" Icon="sensors">
                <RadzenStack Gap="0.75rem">
                    <RadzenDataGrid TItem="PresenteDto" Data="@Presentes" IsLoading="@_ocupado"
                                    AllowSorting="false" RowRender="@ApagarDesconectados"
                                    EmptyText="No hay cuentas activas.">
                        <Columns>
                            @* AQUÍ HABÍA UNA COLUMNA DE 52 px QUE PINTABA p.Icono, y se quitó entera.
                               Era el emoji (🟢🔴📅🍽☕⚪) que escribe el servidor, y el comentario que
                               vivía en ella decía que «no se arregla desde aquí» porque la cadena
                               llega hecha de PresenceService.Icono. Eso sigue siendo verdad para su
                               CONTENIDO, pero no obligaba a seguir pintándola: la pantalla siempre
                               pudo dejar de enseñar esa columna, y eso resuelve el problema sin
                               tocar el servidor. El campo del DTO se queda donde está; lo que se va
                               es la celda.

                               No se pierde nada, porque la marca de color se mudó a la columna
                               «Estado» de aquí al lado, con el punto de Componentes/BotonDeEstado.
                               Dejar las dos sería marcar el mismo dato dos veces, y encima con dos
                               paletas: la del sistema operativo en el emoji y la del tema en el
                               punto —que es exactamente la discrepancia de la que se viene—. *@
                            <RadzenDataGridColumn TItem="PresenteDto" Property="Nombre" Title="Persona">
                                <Template Context="p">
                                    <span style="@(p.Conectado ? "font-weight:600" : "")">@p.Nombre</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PresenteDto" Property="EstadoTexto" Title="Estado" Width="180px">
                                @* El punto de color de Componentes/BotonDeEstado, que es el mismo
                                   enumerado visto desde el otro lado: lo que uno elige en la barra
                                   superior es lo que sale en esta fila, así que tiene que verse
                                   igual. Ésta es además la columna que se barre —«¿quién está
                                   disponible ahora mismo?»— entre todas las cuentas activas.

                                   El texto vuelve a TINTA NORMAL: antes iba coloreado y en negrita,
                                   y con el punto delante eso sería decir el mismo dato dos veces y
                                   tener dos sitios donde puede discrepar. La negrita se va con el
                                   color porque aquí solo servía para sostenerlo; la de la columna
                                   «Persona» se queda, que ésa marca otra cosa (quién está
                                   conectado). El opacity que llevaba el texto de los desconectados
                                   también se va: la fila entera ya se apaga en ApagarDesconectados,
                                   y encadenar los dos dejaba la celda al 42 % y casi ilegible.

                                   El color sale del ENUM que el DTO trae junto al texto, nunca de
                                   comparar la palabra, y el borde gris deja el punto visible aunque
                                   un día falte la variable. La palabra va SIEMPRE al lado: un punto
                                   de color solo no lo distingue quien no separa el rojo del verde,
                                   y aquí además hay dos que comparten gris —«Descanso» y
                                   «Desconectado»— que solo separa el texto. *@
                                <Template Context="p">
                                    <span style="white-space:nowrap;display:inline-flex;align-items:center;gap:.4rem">
                                        <span style="width:.55rem;height:.55rem;flex:none;border-radius:50%;border:1px solid var(--rz-border-color);background:@ColorDePresencia(p)"></span>
                                        @p.EstadoTexto
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PresenteDto" Property="Nota" Title="Nota">
                                <Template Context="p">@(p.Nota ?? "")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PresenteDto" Title="Desde" Width="220px" Sortable="false">
                                <Template Context="p">@Desde(p)</Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">@ResumenDePresencia()</RadzenText>
                </RadzenStack>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Asistencia (oficial)" Icon="schedule">
                <RadzenStack Gap="0.75rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                 Gap="0.75rem" Wrap="FlexWrap.Wrap">
                        <RadzenLabel Text="Día:" Component="diaAsistencia" />
                        <RadzenDatePicker TValue="DateTime" @bind-Value="_diaAsistencia" Name="diaAsistencia"
                                          DateFormat="dd/MM/yyyy" ShowTime="false" Style="width:9rem"
                                          Change="@(_ => CargarAsistencia())" Disabled="@_ocupado" />
                        <RadzenButton Text="Hoy" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Disabled="@_ocupado" Click="@(() => IrAlDia(DateTime.Today))" />
                        <RadzenButton Text="Día olvidado…" Icon="add" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small" Disabled="@_ocupado" Click="@AbrirAlta" />
                        @* Baja el día que se está viendo, con las mismas diez columnas del
                           escritorio. Incluye las filas sin marcar: esa ausencia es el dato por el
                           que se suele exportar. *@
                        <RadzenButton Text="Excel" Icon="download" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small" Disabled="@_ocupado"
                                      Style="margin-left:auto" Click="@ExportarAsistencia" />
                    </RadzenStack>

                    @if (_capturando)
                    {
                        <RadzenCard>
                            <RadzenStack Gap="0.75rem">
                                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                                    @(_corrigiendoId is null
                                        ? "Dar de alta un día que no se marcó"
                                        : $"Corregir la asistencia de {_personaCapturada}")
                                </RadzenText>

                                @if (_corrigiendoId is null)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                                 Gap="0.75rem" Wrap="FlexWrap.Wrap">
                                        <RadzenLabel Text="Persona:" Component="personaAlta" />
                                        <RadzenDropDown TValue="int?" @bind-Value="_userIdCapturado" Name="personaAlta"
                                                        Data="@Asistencias" TextProperty="Nombre" ValueProperty="UserId"
                                                        Placeholder="Elige a quién" Style="min-width:16rem" />
                                    </RadzenStack>
                                }

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                             Gap="0.75rem" Wrap="FlexWrap.Wrap">
                                    <RadzenLabel Text="Entrada:" Component="entrada" />
                                    <RadzenDatePicker TValue="DateTime" @bind-Value="_entradaCapturada" Name="entrada"
                                                      DateFormat="dd/MM/yyyy HH:mm" ShowTime="true" Style="width:13rem" />

                                    <RadzenLabel Text="Salida:" Component="salida" />
                                    @* Vacía = jornada abierta, igual que en el escritorio: quien no marcó
                                       su salida no tiene una hora que inventar. *@
                                    <RadzenDatePicker TValue="DateTime?" @bind-Value="_salidaCapturada" Name="salida"
                                                      DateFormat="dd/MM/yyyy HH:mm" ShowTime="true"
                                                      AllowClear="true" Style="width:13rem" />
                                </RadzenStack>

                                <RadzenTextArea @bind-Value="_motivoCapturado" Rows="2" Style="width:100%"
                                                MaxLength="500"
                                                Placeholder="Motivo (obligatorio): por qué se toca este registro" />

                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenButton Text="Guardar" Disabled="@_ocupado" Click="@GuardarAsistencia" />
                                    <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light"
                                                  Disabled="@_ocupado" Click="@(() => _capturando = false)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCard>
                    }

                    <RadzenDataGrid TItem="AsistenciaDelDiaDto" Data="@Asistencias" IsLoading="@_ocupado"
                                    AllowSorting="false" RowRender="@ApagarSinRegistro"
                                    EmptyText="No hay cuentas activas que mostrar.">
                        <Columns>
                            <RadzenDataGridColumn TItem="AsistenciaDelDiaDto" Property="Nombre" Title="Persona" />
                            <RadzenDataGridColumn TItem="AsistenciaDelDiaDto" Title="Entrada" Width="100px" Sortable="false">
                                <Template Context="f">@Hora(f.EntradaUtc)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="AsistenciaDelDiaDto" Title="Salida" Width="110px" Sortable="false">
                                <Template Context="f">
                                    @(f.SalidaUtc is not null
                                        ? Hora(f.SalidaUtc)
                                        : f.RegistroId != null ? "— abierta" : "")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="AsistenciaDelDiaDto" Property="Horas" Title="Horas" Width="110px" />
                            @* «Dif.» en lugar de la letra griega Δ que encabezaba estas dos columnas.
                               Es el mismo problema que los emojis, solo que más callado: los archivos
                               de IBM Plex que viajan con la aplicación son subconjuntos latinos —está
                               en el unicode-range de tipografia.css— y el griego no entra, así que la
                               Δ caía en la fuente de respaldo de cada equipo y se veía distinta y peor
                               alineada que las cabeceras vecinas. El valor ya viene con signo y con
                               «min», que es lo que hay que leer. *@
                            <RadzenDataGridColumn TItem="AsistenciaDelDiaDto" Title="Dif. entrada" Width="110px" Sortable="false">
                                <Template Context="f">
                                    <span style="@(f.Discrepancia ? Ambar : "")">@Delta(f.DeltaEntradaMinutos)</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="AsistenciaDelDiaDto" Title="Dif. salida" Width="110px" Sortable="false">
                                <Template Context="f">
                                    <span style="@(f.Discrepancia ? Ambar : "")">@Delta(f.DeltaSalidaMinutos)</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="AsistenciaDelDiaDto" Title="1ª señal app" Width="120px" Sortable="false">
                                <Template Context="f">@Hora(f.PrimeraSenalUtc)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="AsistenciaDelDiaDto" Title="Últ. señal app" Width="130px" Sortable="false">
                                <Template Context="f">@Hora(f.UltimaSenalUtc)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="AsistenciaDelDiaDto" Property="EstadoTexto" Title="Estado" Width="220px">
                                @* ESTA COLUMNA NO LLEVA PUNTO DE COLOR, y no es que se olvidara al
                                   ponérselo a la pestaña de al lado. Aquí no hay un estado: hay
                                   VARIOS a la vez. El texto lo compone el servidor concatenando lo
                                   que haya pasado ese día («Pide corrección · Olvido (estimada)»),
                                   y detrás no hay un enum sino cuatro booleanos independientes, así
                                   que no existe un valor único al que asignarle un color —el punto
                                   tendría que elegir uno de los tres y callarse los otros dos—.
                                   El ámbar sobre el texto sí dice lo único binario que importa
                                   aquí: esta fila reclama algo. Con eso se filtra a ojo, que es
                                   para lo que se abre esta pestaña. *@
                                <Template Context="f">
                                    <span style="@(f.Olvido || f.CorreccionSolicitada || f.SinMarcar ? Ambar : "")">
                                        @f.EstadoTexto
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="AsistenciaDelDiaDto" Title="" Width="110px" Sortable="false">
                                <Template Context="f">
                                    @if (f.RegistroId is not null)
                                    {
                                        <RadzenButton Text="Corregir" ButtonStyle="ButtonStyle.Light"
                                                      Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                      Click="@(() => AbrirCorreccion(f))" />
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">@ResumenDeAsistencia()</RadzenText>

                    @if (_asistencia?.Filas.FirstOrDefault(f => f.CorreccionSolicitada) is { } pide)
                    {
                        @* La nota de quien pide corrección se enseña completa: es lo que hay que leer
                           antes de decidir qué corregir, y en la columna «Estado» no cabe. *@
                        <RadzenCard>
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                                <RadzenIcon Icon="pan_tool" /> <b>@pide.Nombre</b> pidió corrección: @(pide.NotaCorreccion ?? "(sin nota)")
                            </RadzenText>
                        </RadzenCard>
                    }
                </RadzenStack>
            </RadzenTabsItem>

            @* «list_alt» y no «schedule» ni «history»: es la tercera pestaña de la misma pantalla, así
               que el glifo tiene que decir en qué se diferencia de las otras dos. Aquí no se vigila
               ni se mide, se LISTA lo que quedó registrado; el reloj ya lo lleva la pestaña de al
               lado y «history» es la bitácora en esta aplicación. *@
            <RadzenTabsItem Text="Registro de jornadas" Icon="list_alt">
                <RadzenStack Gap="0.75rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                 Gap="0.75rem" Wrap="FlexWrap.Wrap">
                        <RadzenLabel Text="Día:" Component="diaJornadas" />
                        <RadzenDatePicker TValue="DateTime" @bind-Value="_diaJornadas" Name="diaJornadas"
                                          DateFormat="dd/MM/yyyy" ShowTime="false" Style="width:9rem"
                                          Change="@(_ => CargarJornadas())" Disabled="@_ocupado" />
                        <RadzenButton Text="Hoy" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Disabled="@_ocupado"
                                      Click="@(() => { _diaJornadas = DateTime.Today; return CargarJornadas(); })" />
                    </RadzenStack>

                    <RadzenDataGrid TItem="JornadaDelDiaDto" Data="@Jornadas" IsLoading="@_ocupado"
                                    AllowSorting="false" EmptyText="Nadie abrió la aplicación ese día.">
                        <Columns>
                            <RadzenDataGridColumn TItem="JornadaDelDiaDto" Property="Persona" Title="Persona" />
                            <RadzenDataGridColumn TItem="JornadaDelDiaDto" Title="Entrada" Width="110px" Sortable="false">
                                <Template Context="j">@j.InicioUtc.ToLocalTime().ToString("HH:mm")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="JornadaDelDiaDto" Title="Salida" Width="120px" Sortable="false">
                                <Template Context="j">
                                    @if (j.Abierta)
                                    {
                                        <span style="color:var(--rz-success)">— en curso</span>
                                    }
                                    else
                                    {
                                        @j.FinUtc!.Value.ToLocalTime().ToString("HH:mm")
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="JornadaDelDiaDto" Property="Duracion" Title="Duración" Width="130px" />
                            <RadzenDataGridColumn TItem="JornadaDelDiaDto" Property="CierreTexto" Title="Cierre" Width="150px">
                                <Template Context="j">
                                    <span style="@(j.SinSenales ? Ambar : "")">@j.CierreTexto</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="JornadaDelDiaDto" Property="Equipo" Title="Equipo">
                                <Template Context="j">@(j.Equipo ?? "")</Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">@ResumenDeJornadas()</RadzenText>
                </RadzenStack>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenStack>

@code {
    /// <summary>El ámbar de aviso del escritorio (AppTheme.Warning), para lo que hay que mirar.</summary>
    private const string Ambar = "color:var(--rz-warning);font-weight:600";

    /// <summary>
    /// Cada cuánto se repinta el tablero por su cuenta.
    ///
    /// Convive con el evento en vivo y no lo sustituye: el hub avisa cuando alguien CAMBIA de estado,
    /// pero conectarse y desconectarse no dispara ningún evento, y el «desde» envejece solo. Sin este
    /// tic, el tablero se quedaría congelado diciendo «conectado» de quien cerró el navegador. Son
    /// los mismos 30 s del escritorio.
    /// </summary>
    private static readonly TimeSpan Refresco = TimeSpan.FromSeconds(30);

    private readonly CancellationTokenSource _cancelacion = new();
    private Timer? _tic;
    private bool _ocupado;

    private TableroDePresenciaDto? _tablero;
    private RegistroDeJornadasDto? _jornadas;
    private AsistenciaDelDiaResumenDto? _asistencia;

    private DateTime _diaJornadas = DateTime.Today;
    private DateTime _diaAsistencia = DateTime.Today;

    // Corrección y alta manual.
    private bool _capturando;
    private int? _corrigiendoId;
    private string _personaCapturada = "";
    private int? _userIdCapturado;
    private DateTime _entradaCapturada = DateTime.Today.AddHours(9);
    private DateTime? _salidaCapturada;
    private string _motivoCapturado = "";

    private IReadOnlyList<PresenteDto> Presentes => _tablero?.Personas ?? [];
    private IReadOnlyList<JornadaDelDiaDto> Jornadas => _jornadas?.Jornadas ?? [];
    private IReadOnlyList<AsistenciaDelDiaDto> Asistencias => _asistencia?.Filas ?? [];

    protected override async Task OnInitializedAsync()
    {
        EnVivo.PresenciaCambiada += AlCambiarLaPresencia;
        await CargarTodo();
        _tic = new Timer(_ => InvokeAsync(Envejecer), null, Refresco, Refresco);
    }

    private async Task CargarTodo()
    {
        await CargarTablero();
        await CargarAsistencia();
        await CargarJornadas();
    }

    private async Task CargarTablero()
    {
        _ocupado = true;
        try
        {
            // null es «falló y ya se avisó»: se deja lo que había en pantalla en vez de vaciarla, que
            // se leería como «no hay nadie conectado» y sería mentira.
            var tablero = await Api.LeerAsync<TableroDePresenciaDto>("api/personas/presencia", _cancelacion.Token);
            if (tablero is not null) _tablero = tablero;
        }
        finally { _ocupado = false; }
    }

    private async Task CargarJornadas()
    {
        _ocupado = true;
        try
        {
            var registro = await Api.LeerAsync<RegistroDeJornadasDto>(
                $"api/personas/presencia/jornadas?dia={_diaJornadas:yyyy-MM-dd}", _cancelacion.Token);
            if (registro is not null) _jornadas = registro;
        }
        finally { _ocupado = false; }
    }

    private async Task CargarAsistencia()
    {
        _ocupado = true;
        try
        {
            var resumen = await Api.LeerAsync<AsistenciaDelDiaResumenDto>(
                $"api/personas/presencia/asistencia?dia={_diaAsistencia:yyyy-MM-dd}", _cancelacion.Token);
            if (resumen is not null) _asistencia = resumen;
        }
        finally { _ocupado = false; }
    }

    /// <summary>Baja el día que se está viendo. El nombre del archivo lo pone el servidor.</summary>
    private Task ExportarAsistencia() =>
        Descargas.DesdeApiAsync(
            $"api/personas/presencia/asistencia/excel?dia={_diaAsistencia:yyyy-MM-dd}").AsTask();

    private Task IrAlDia(DateTime dia)
    {
        _diaAsistencia = dia;
        return CargarAsistencia();
    }

    /// <summary>
    /// El tic de fondo. Solo refresca lo que envejece solo: el tablero siempre, y los dos días
    /// solo si son HOY. Los días pasados no cambian por sí mismos y pedirlos otra vez sería una
    /// consulta cada 30 s a cambio de nada.
    /// </summary>
    private async Task Envejecer()
    {
        await CargarTablero();
        if (_diaAsistencia.Date == DateTime.Today) await CargarAsistencia();
        if (_diaJornadas.Date == DateTime.Today) await CargarJornadas();
        StateHasChanged();
    }

    /// <summary>Alguien cambió su estado: el tablero quedó viejo al instante.</summary>
    private void AlCambiarLaPresencia() => InvokeAsync(async () =>
    {
        await CargarTablero();
        StateHasChanged();
    });

    // ── Corrección y alta manual ─────────────────────────────────────────────

    private void AbrirCorreccion(AsistenciaDelDiaDto fila)
    {
        _corrigiendoId    = fila.RegistroId;
        _personaCapturada = fila.Nombre;
        _userIdCapturado  = fila.UserId;
        _entradaCapturada = (fila.EntradaUtc ?? DateTime.UtcNow).ToLocalTime();
        _salidaCapturada  = fila.SalidaUtc?.ToLocalTime();
        _motivoCapturado  = "";
        _capturando       = true;
    }

    private void AbrirAlta()
    {
        _corrigiendoId    = null;
        _personaCapturada = "";
        _userIdCapturado  = null;
        // El día que se está mirando, a una hora de entrada verosímil: es el caso real («se le pasó
        // marcar el martes»), y así no hay que teclear la fecha entera.
        _entradaCapturada = _diaAsistencia.Date.AddHours(9);
        _salidaCapturada  = null;
        _motivoCapturado  = "";
        _capturando       = true;
    }

    private async Task GuardarAsistencia()
    {
        // Solo lo evidente se comprueba aquí; el horario, el solape y el futuro los valida el
        // servicio, que es donde esas reglas tienen que vivir.
        if (string.IsNullOrWhiteSpace(_motivoCapturado))
        {
            Avisos.Aviso("Escribe el motivo: una corrección sin explicación es indistinguible de una manipulación.");
            return;
        }

        bool ok;
        if (_corrigiendoId is int registroId)
        {
            ok = await Enviar($"api/personas/presencia/asistencia/{registroId}/corregir",
                new CorregirAsistenciaRequest(_entradaCapturada, _salidaCapturada, _motivoCapturado));
        }
        else
        {
            if (_userIdCapturado is not int userId)
            {
                Avisos.Aviso("Elige a quién le corresponde el día.");
                return;
            }
            ok = await Enviar("api/personas/presencia/asistencia",
                new AltaDeAsistenciaRequest(userId, _entradaCapturada, _salidaCapturada, _motivoCapturado));
        }

        if (ok) _capturando = false;
    }

    /// <summary>
    /// El envío que comparten las dos acciones. El mensaje del servidor se enseña TAL CUAL: dice el
    /// motivo concreto —«ese horario se encima con otro registro de la misma persona»— y cambiarlo
    /// por un «no se pudo» genérico tiraría lo que el escritorio hacía bien.
    /// </summary>
    private async Task<bool> Enviar<T>(string ruta, T cuerpo)
    {
        _ocupado = true;
        try
        {
            var (ok, r) = await Api.EnviarAsync<T, ResultadoDto>(ruta, cuerpo, _cancelacion.Token);
            if (ok && r is not null) Avisos.Exito(r.Mensaje);
            if (ok) await CargarAsistencia();
            return ok;
        }
        finally { _ocupado = false; }
    }

    // ── Textos y pintado ─────────────────────────────────────────────────────

    private static string Hora(DateTime? utc) => utc is DateTime d ? d.ToLocalTime().ToString("HH:mm") : "";

    /// <summary>El delta con signo: «+12 min» = marcó después de lo que vio la aplicación.</summary>
    private static string Delta(int? minutos) => minutos switch
    {
        null => "",
        0    => "0",
        > 0  => $"+{minutos} min",
        _    => $"{minutos} min"
    };

    /// <summary>
    /// La columna «Desde».
    ///
    /// <para>El caso de <c>RegistraJornada == false</c> —hoy, Operaciones— va PRIMERO y no es un
    /// adorno. A esas cuentas la aplicación no les abre jornada, así que no hay hora de inicio que
    /// enseñar ni fila histórica de la que sacar un «visto». Sin este caso, la rama de abajo caía en
    /// «nunca ha entrado» todos los días de su vida laboral —de alguien que puede estar conectado en
    /// ese mismo instante—, que es mentira y acaba en un ticket. Se dice lo que pasa de verdad: la
    /// aplicación no le lleva las horas.</para>
    ///
    /// <para>Y las que SÍ tuvieran filas de antes —las de antes del cambio— siguen ahí y se siguen
    /// consultando por el registro de jornadas y por la asistencia del día; lo que no se hace es
    /// leerlas aquí como si fueran su última señal, porque desde el cambio ya no lo son.</para>
    /// </summary>
    private string Desde(PresenteDto p)
    {
        if (!p.RegistraJornada)
            return p.Conectado ? "conectado ahora" : "no registra jornada";

        if (p.Conectado && p.DesdeUtc is DateTime d)
        {
            var t = DateTime.UtcNow - d;
            return $"{d.ToLocalTime():HH:mm}  ({(t < TimeSpan.Zero ? "un momento" : $"{(int)t.TotalHours} h {t.Minutes:00} min")})";
        }
        return p.UltimoLatidoUtc is DateTime visto
            ? $"visto {visto.ToLocalTime():dd/MM HH:mm}"
            : "nunca ha entrado";
    }

    /// <summary>
    /// El color del punto de la columna «Estado». Lo único que decide esta pantalla es QUIÉN cuenta
    /// como ausente; los cinco colores salen de <c>ColoresDeEstado.ColorDePresencia</c>, en Shared,
    /// que es la misma tabla que pinta el botón de la barra superior. Y va así a propósito: lo que
    /// alguien elige arriba es lo que los demás ven en esta fila, así que tiene que verse igual.
    /// Antes había aquí una copia de esas cinco líneas y otra dentro de <c>BotonDeEstado.razor</c>;
    /// coincidían, que es como empiezan las tablas que un día discrepan sin que nadie lo note. No
    /// vuelvas a bajarla a la pantalla.
    ///
    /// <para>Antes de eso, esta pantalla usaba el SEMÁFORO —verde para «Disponible», rojo para
    /// «Ocupado»— y eso decía algo que no es: estar concentrado no es un error ni estar libre un
    /// logro, y el tablero parecía una alarma cada vez que alguien se ponía a trabajar.</para>
    ///
    /// <para>Quien no está conectado va al gris de «ausente» y no al color de su último estado: el
    /// servidor le pone «Desconectado» de texto (<c>PersonasQueryService</c>), y un punto verde junto
    /// a esa palabra sería el punto contradiciendo a la palabra. Esa decisión se queda AQUÍ y no en
    /// la tabla común porque «estar conectado» no es un valor del enumerado, es un dato de este DTO
    /// que la barra superior ni siquiera tiene: quien mira su propio estado está, por definición,
    /// conectado.</para>
    /// </summary>
    private static string ColorDePresencia(PresenteDto p) =>
        ColoresDeEstado.ColorDePresencia(p.Conectado ? p.Estado : PresenceState.Ausente);

    private string ResumenDePresencia() => _tablero is not { } t
        ? ""
        : $"{t.Conectados} de {t.Total} conectado(s).  " +
          $"Se da por desconectado a quien lleve {t.ToleranciaMinutos} min sin dar señales.";

    // El «⚠» de esta frase NO se quita todavía, aunque el resto de los triángulos de este archivo sí:
    // lo que va entre comillas angulares es una CITA de una etiqueta que se pinta en la columna de
    // salida, y esa etiqueta la escribe el servidor (PersonasQueryService.SinLatido devuelve
    // literalmente «⚠ Sin señales»). Si se quita aquí y allí no, la leyenda manda a buscar en
    // pantalla algo que no está escrito así. Los dos cambios van juntos o no van.
    private string ResumenDeJornadas() => _jornadas is not { } j
        ? ""
        : j.Jornadas.Count == 0
            ? "Nadie abrió la aplicación ese día."
            : $"{j.Jornadas.Count} jornada(s) de {j.Personas} persona(s)  ·  {j.DuracionTotal} en total.  " +
              "«⚠ Sin señales» = la aplicación dejó de responder; la salida es su última señal, no una " +
              "hora real de salida.";

    private string ResumenDeAsistencia()
    {
        if (_asistencia is not { } a) return "";
        // Esto es una CADENA que se pinta como texto plano: no hay dónde colgar un <RadzenIcon>, así
        // que las marcas se quitan en vez de sustituirse. Y no se pierde nada: los tres trozos solo
        // se añaden cuando el número es mayor que cero, o sea que aparecer YA es el aviso. Con los
        // triángulos, el resumen parecía una alarma cualquier día normal. Ojo a la asimetría con la
        // mano de más arriba, que sí se conservó como <RadzenIcon Icon="pan_tool" />: allí hay
        // marcado que la sostenga y aquí no. La regla es ésa, no un descuido.
        return $"{a.Marcaron} de {a.Filas.Count} marcaron su asistencia." +
               (a.SinMarcar > 0 ? $"  {a.SinMarcar} usó la aplicación sin marcar." : "") +
               (a.Olvidos > 0 ? $"  {a.Olvidos} sin salida marcada (la hora es una estimación, corrígela)." : "") +
               (a.Solicitudes > 0 ? $"  {a.Solicitudes} pidió corrección." : "") +
               $"  Se resalta a partir de {a.ToleranciaMinutos} min de diferencia con lo que vio la aplicación.";
    }

    private static void ApagarDesconectados(RowRenderEventArgs<PresenteDto> args)
    {
        if (!args.Data.Conectado) args.Attributes["style"] = "opacity:.6";
    }

    /// <summary>
    /// Quien no marcó nada se apaga si tampoco abrió la aplicación, y se deja legible si sí la abrió:
    /// ese segundo caso es el que hay que mirar, igual que en el escritorio.
    /// </summary>
    private static void ApagarSinRegistro(RowRenderEventArgs<AsistenciaDelDiaDto> args)
    {
        if (args.Data.RegistroId == null && !args.Data.SinMarcar)
            args.Attributes["style"] = "opacity:.6";
    }

    public void Dispose()
    {
        EnVivo.PresenciaCambiada -= AlCambiarLaPresencia;
        _tic?.Dispose();
        _cancelacion.Cancel();
        _cancelacion.Dispose();
    }
}
