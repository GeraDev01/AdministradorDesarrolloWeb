@page "/desempeno"
@attribute [Authorize(Policy = "SoloAdmin")]
@using AdminWeb.Shared.Dtos.Desempeno
@implements IDisposable
@inject ClienteApi Api
@inject AvisosDeInterfaz Avisos

@*
    Desempeño del mes (administrador): los dos rankings y la cola de revisión.

    Es la traducción de las pestañas «Ranking Mensual», «Ranking por Equipo» y «Pendientes de
    aprobación» del escritorio.

    Decisiones del escritorio que se conservan en la parte de escritura:

      · Una entrada YA APROBADA no se vuelve a tocar. La pantalla ni siquiera la ofrece —solo lista
        pendientes— y el servidor la rechazaría igual: esos puntos ya se contaron en un ranking que
        la gente vio.
      · El PUNTAJE no lo escribe el desarrollador. Lo pone el criterio y solo el líder lo ajusta, y
        ajustarlo NO aprueba la entrada: sigue esperando decisión. Es la contraparte necesaria de
        haberle quitado el campo al desarrollador.
      · Las VUELTAS se ven en la lista, no dentro de la ficha. Una entrada que vuelve por tercera vez
        no es una propuesta nueva, y saberlo antes de abrirla cambia cómo se revisa.
      · La evidencia completa —comentario, enlace, tiempo declarado, captura e historial— se mira
        junta. En el escritorio costó una versión aprender que revisar con el comentario truncado en
        una celda no es revisar.

    Lo que cambia respecto al escritorio: el motivo del rechazo es OBLIGATORIO (allí el diálogo lo
    pedía «(opcional)»). Sin motivo, quien recibe la devolución no sabe qué arreglar y vuelve a
    mandar lo mismo. Es además lo que ya exige el pool al devolver una entrega.
*@

<PageTitle>Desempeño</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-0">Desempeño</RadzenText>

    <RadzenCard data-recorrido="desempeno-periodo">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                     Gap="0.75rem" Wrap="FlexWrap.Wrap">
            @* El período solo manda en los rankings: la cola de revisión no se filtra por él. *@
            <RadzenLabel Text="Mes:" Component="mes" />
            <RadzenDropDown @bind-Value="_mes" Data="@Meses" TextProperty="Texto" ValueProperty="Id"
                            Name="mes" Style="width:150px" Change="@(_ => CargarRanking())" Disabled="@_ocupado" />

            <RadzenLabel Text="Año:" Component="anio" />
            <RadzenNumeric @bind-Value="_anio" Min="2020" Max="2099" Name="anio"
                           Style="width:110px" Change="@((int _) => CargarRanking())" Disabled="@_ocupado" />

            @* El nivel Lead no compite (reparte parte de los puntos y no se mide contra los niveles
               que evalúa), pero el administrador necesita poder verlo: entra fuera de concurso, con
               corona y sin ocupar lugar. *@
            <RadzenCheckBox data-recorrido="desempeno-lead" @bind-Value="_incluirNivelLead" Name="lead"
                            Change="@((bool _) => CargarRanking())" Disabled="@_ocupado" />
            <RadzenLabel Text="Incluir nivel Lead (fuera de concurso)" Component="lead" />

            <RadzenButton Text="Recargar" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small" Click="@Cargar" Disabled="@_ocupado" />
        </RadzenStack>
    </RadzenCard>

    <RadzenTabs data-recorrido="desempeno-vistas">
        <Tabs>
            @* Los rótulos de las pestañas llevaban emoji. Un emoji lo dibuja el sistema operativo con
               su propia paleta y no hereda el color del texto, así que la pestaña activa y la
               inactiva se veían igual de encendidas; el icono de la fuente sí sigue al texto. *@
            <RadzenTabsItem Text="Ranking mensual" Icon="leaderboard">
                @* Lista vacía y no null mientras carga: la rejilla enseña su EmptyText en vez de
                   quedarse a medio pintar. *@
                @* EL DOBLE CLIC ABRE DE QUÉ SE COMPONE LA FILA. Un ranking es una lista de números y
                   ninguno se puede discutir sin saber de dónde sale: «42 puntos» se acepta o no se
                   acepta, mientras que la lista de lo que se hizo se revisa, se corrige y se explica.
                   La información ya existía, repartida entre la autocalificación de cada quien y el
                   pool; lo que faltaba era poder llegar a ella desde aquí y acotada al mes que se
                   está mirando. El panel se abre DEBAJO y no en una ventana modal, por lo mismo que
                   en el pool: una modal encima de otra pantalla se pierde detrás del navegador. *@
                <RadzenDataGrid TItem="RankingIndividualFilaDto" Data="@(_datos?.Individual ?? Array.Empty<RankingIndividualFilaDto>())"
                                IsLoading="@_ocupado" AllowSorting="true" AllowColumnResize="true"
                                PageSize="25" AllowPaging="true" @attributes="@Paginador.ArribaYAbajo" EmptyText="Sin puntos aprobados en el mes."
                                RowDoubleClick="@(f => AbrirDetalleDeDesarrollador(f.Data))"
                                RowRender="@ResaltarPodio">
                    <Columns>
                        <RadzenDataGridColumn TItem="RankingIndividualFilaDto" Property="Posicion" Title="Pos." Width="80px">
                            <Template Context="fila">@fila.Medalla</Template>
                        </RadzenDataGridColumn>
                        @* El botón del ojo, porque un doble clic no se ve y quien navega con el
                           teclado no lo tiene. Mismo criterio que BotonDeDetalle en las demás
                           rejillas; aquí no se usa ese componente porque lo que abre no es un cuadro
                           de campos sino un panel con dos listas. *@
                        <RadzenDataGridColumn TItem="RankingIndividualFilaDto" Title="" Width="52px" Sortable="false">
                            <Template Context="fila">
                                <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                              Click="@(() => AbrirDetalleDeDesarrollador(fila))"
                                              title="Ver de qué se componen sus puntos del mes"
                                              aria-label="Ver de qué se componen sus puntos del mes" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="RankingIndividualFilaDto" Property="Desarrollador" Title="Desarrollador" />
                        <RadzenDataGridColumn TItem="RankingIndividualFilaDto" Property="Total" Title="Total" Width="110px"
                                              TextAlign="TextAlign.Right">
                            <Template Context="fila">
                                <b style="@EstiloDeTotal(fila.Total)">@ConSigno(fila.Total)</b>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="RankingIndividualFilaDto" Property="Premio" Title="+ Premio"
                                              Width="120px" TextAlign="TextAlign.Right">
                            <Template Context="fila">@(fila.Premio > 0 ? $"+{fila.Premio}" : "—")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="RankingIndividualFilaDto" Property="Penalizacion" Title="- Penaliz."
                                              Width="120px" TextAlign="TextAlign.Right">
                            <Template Context="fila">@(fila.Penalizacion < 0 ? fila.Penalizacion.ToString() : "—")</Template>
                        </RadzenDataGridColumn>
                        @* DE DÓNDE SALEN. «Premio» y «Penalización» dicen el signo; esta columna dice
                           la PROCEDENCIA, que es otra pregunta: cuarenta puntos de trabajo publicado,
                           tomado y verificado no son lo mismo que cuarenta de autocalificación, y
                           hasta ahora la tabla no distinguía. Puede salir en negativo, porque el
                           retrabajo resta. *@
                        <RadzenDataGridColumn TItem="RankingIndividualFilaDto" Property="DelPool" Title="Del pool"
                                              Width="120px" TextAlign="TextAlign.Right">
                            <Template Context="fila">
                                @(fila.DelPool == 0 ? "—" : ConSigno(fila.DelPool))
                            </Template>
                        </RadzenDataGridColumn>
                        @* Los retrabajos son la CUENTA, no los puntos: los puntos ya están en la
                           columna de al lado y lo que aporta el número es cuántas veces hubo que
                           volver sobre algo ya entregado. En rojo porque es lo que se viene a
                           buscar. *@
                        <RadzenDataGridColumn TItem="RankingIndividualFilaDto" Property="Retrabajos" Title="Retrabajos"
                                              Width="120px" TextAlign="TextAlign.Right">
                            <Template Context="fila">
                                <span style="@(fila.Retrabajos > 0 ? "color:var(--rz-danger);font-weight:600" : "")">
                                    @(fila.Retrabajos == 0 ? "—" : fila.Retrabajos.ToString())
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="RankingIndividualFilaDto" Property="Entradas" Title="Entradas"
                                              Width="110px" TextAlign="TextAlign.Right" />
                    </Columns>
                </RadzenDataGrid>

                @PanelDeDetalle()
            </RadzenTabsItem>

            <RadzenTabsItem Text="Ranking por equipo" Icon="groups">
                @* Aquí TODOS cuentan, también los de nivel Lead: la competencia es entre equipos y
                   cada quien es parte del suyo. Restar los puntos del Lead castigaría justo a los
                   equipos cuyo Lead más trabaja. *@
                <RadzenDataGrid TItem="RankingEquipoFilaDto" Data="@(_datos?.Equipos ?? Array.Empty<RankingEquipoFilaDto>())"
                                IsLoading="@_ocupado" AllowSorting="true" AllowColumnResize="true"
                                PageSize="25" AllowPaging="true" @attributes="@Paginador.ArribaYAbajo" EmptyText="No hay equipos."
                                RowDoubleClick="@(f => AbrirDetalleDeEquipo(f.Data))">
                    <Columns>
                        <RadzenDataGridColumn TItem="RankingEquipoFilaDto" Property="Posicion" Title="Pos." Width="80px">
                            <Template Context="fila">@fila.Medalla</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="RankingEquipoFilaDto" Title="" Width="52px" Sortable="false">
                            <Template Context="fila">
                                <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                              Click="@(() => AbrirDetalleDeEquipo(fila))"
                                              title="Ver qué hicieron sus integrantes en el mes"
                                              aria-label="Ver qué hicieron sus integrantes en el mes" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="RankingEquipoFilaDto" Property="Equipo" Title="Equipo" />
                        <RadzenDataGridColumn TItem="RankingEquipoFilaDto" Property="Total" Title="Total"
                                              Width="110px" TextAlign="TextAlign.Right">
                            <Template Context="fila">
                                <b style="@EstiloDeTotal(fila.Total)">@ConSigno(fila.Total)</b>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="RankingEquipoFilaDto" Property="PuntosIntegrantes"
                                              Title="Pts integrantes" Width="150px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="RankingEquipoFilaDto" Property="PuntosEquipo"
                                              Title="Pts equipo" Width="130px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="RankingEquipoFilaDto" Property="DelPool" Title="Del pool"
                                              Width="120px" TextAlign="TextAlign.Right">
                            <Template Context="fila">
                                @(fila.DelPool == 0 ? "—" : ConSigno(fila.DelPool))
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="RankingEquipoFilaDto" Property="Retrabajos" Title="Retrabajos"
                                              Width="120px" TextAlign="TextAlign.Right">
                            <Template Context="fila">
                                <span style="@(fila.Retrabajos > 0 ? "color:var(--rz-danger);font-weight:600" : "")">
                                    @(fila.Retrabajos == 0 ? "—" : fila.Retrabajos.ToString())
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="RankingEquipoFilaDto" Property="Miembros"
                                              Title="# Miembros" Width="120px" TextAlign="TextAlign.Right" />
                    </Columns>
                </RadzenDataGrid>

                @PanelDeDetalle()

                @* POR QUÉ FALTA UN EQUIPO. Los que tienen subequipos no compiten, y una tabla de la
                   que un equipo simplemente desaparece se lee como un fallo: alguien nota a fin de
                   mes que el suyo ya no sale y no tiene forma de saber si es la regla o una avería.
                   Por eso se nombran, y por eso se dice además cuánta gente directa tienen: ése es
                   el caso que duele, porque sus puntos no cuentan para ningún equipo. Con cero
                   integrantes propios no hay nada que echar en falta y basta con explicar la
                   ausencia. *@
                @if (_datos?.EquiposQueNoCompiten is { Count: > 0 } fuera)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" AllowClose="false"
                                 Title="Por qué no salen todos los equipos" class="rz-mt-3">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                            En el ranking compiten los equipos que hacen el trabajo. Uno con
                            subequipos colgando no juega: si sumara lo de sus hijos les ganaría
                            siempre, y si compitiera solo con lo suyo saldría a cero por ser un
                            paraguas. Ahora mismo están fuera
                            @(string.Join(", ", fuera.Select(e => e.Equipo))).
                        </RadzenText>
                        @if (fuera.Any(e => e.PersonasDirectas > 0))
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0" Style="margin-top:.5rem">
                                Y hay gente asignada directamente a
                                @(string.Join(", ", fuera.Where(e => e.PersonasDirectas > 0)
                                    .Select(e => $"{e.Equipo} ({e.PersonasDirectas})"))):
                                <b>sus puntos no cuentan para ningún equipo</b>. En el ranking
                                individual cuentan igual. Si eso no es lo que quieres, muévelos a un
                                subequipo.
                            </RadzenText>
                        }
                    </RadzenAlert>
                }
            </RadzenTabsItem>

            <RadzenTabsItem Text="@TituloDePendientes()" Icon="pending">
                <RadzenStack Gap="0.75rem">
                    @* La cola NO se filtra por el mes de arriba: lo pendiente es pendiente venga del
                       mes que venga, y filtrarlo escondería justo lo que más tiempo lleva esperando. *@
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                        Puntos que los desarrolladores se autoasignaron, de lo más antiguo a lo más
                        reciente. El puntaje lo fija el criterio: solo tú puedes ajustarlo aquí antes
                        de aprobar. Se puede marcar más de una fila.
                    </RadzenText>

                    <RadzenStack data-recorrido="desempeno-acciones"
                                 Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        @* Aprobar y rechazar se distinguían solo por el COLOR del botón, y en tema
                           oscuro el verde y el rojo se acercan lo suficiente como para pulsar el que
                           no era. La palomita en círculo y el aspa en círculo se distinguen por
                           FORMA, que es lo que se ve incluso sin ver bien el color. *@
                        <RadzenButton Text="Aprobar" Icon="check_circle"
                                      Disabled="@(_ocupado || Marcadas.Count == 0)" Click="@Aprobar" />
                        <RadzenButton Text="Rechazar" Icon="cancel" ButtonStyle="ButtonStyle.Danger"
                                      Disabled="@(_ocupado || Marcadas.Count == 0)" Click="@Rechazar" />
                        <RadzenButton Text="Ajustar puntos" Icon="edit" ButtonStyle="ButtonStyle.Light"
                                      Disabled="@(_ocupado || Marcadas.Count != 1)" Click="@AjustarPuntos" />
                        <RadzenButton Text="Recargar" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small" Click="@CargarPendientes" Disabled="@_ocupado" />
                    </RadzenStack>

                    <RadzenDataGrid data-recorrido="desempeno-cola"
                                    TItem="PuntoPendienteDto" Data="@_pendientes" IsLoading="@_ocupado"
                                    AllowSorting="true" AllowColumnResize="true" AllowPaging="true" @attributes="@Paginador.ArribaYAbajo" PageSize="15"
                                    SelectionMode="DataGridSelectionMode.Multiple"
                                    Value="@_marcadas" ValueChanged="@Marcar"
                                    RowRender="@ResaltarLasReplicas"
                                    EmptyText="No hay nada esperando aprobación.">
                        <Columns>
                            <RadzenDataGridColumn TItem="PuntoPendienteDto" Property="Desarrollador"
                                                  Title="Desarrollador" Width="180px" />
                            <RadzenDataGridColumn TItem="PuntoPendienteDto" Property="Criterio"
                                                  Title="Actividad / criterio">
                                <Template Context="p">
                                    <span title="@p.DescripcionCriterio">@p.Criterio</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PuntoPendienteDto" Property="Puntos" Title="Puntos"
                                                  Width="90px" TextAlign="TextAlign.Right">
                                <Template Context="p"><b>@ConSigno(p.Puntos)</b></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PuntoPendienteDto" Property="Periodo"
                                                  Title="Período" Width="140px" />
                            <RadzenDataGridColumn TItem="PuntoPendienteDto" Property="FechaUtc"
                                                  Title="Registrada" Width="130px">
                                <Template Context="p">@p.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PuntoPendienteDto" Property="Requerimiento"
                                                  Title="Req." Width="90px">
                                <Template Context="p">
                                    <span title="@p.Requerimiento">
                                        @(p.RequerimientoId is int r ? $"#{r}" : "—")
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>
                            @* La cabecera dice la palabra que ya usa el propio DTO. Title es un string
                               y además es el nombre con el que la columna sale en el selector de
                               columnas y al ordenar, así que un dibujo ahí no se lee ni se busca. Y
                               unas flechas en círculo no distinguen «vueltas de revisión» de
                               «reintentar» ni de «sincronizar», que son tres cosas que existen en esta
                               aplicación. *@
                            <RadzenDataGridColumn TItem="PuntoPendienteDto" Property="Vueltas"
                                                  Title="Vueltas" Width="90px">
                                <Template Context="p">
                                    @if (p.EsReplica)
                                    {
                                        <span style="color:var(--rz-warning);font-weight:600"
                                              title="El desarrollador ya replicó. Abre la ficha para leer la discusión.">
                                            ×@p.Vueltas
                                        </span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PuntoPendienteDto" Property="TiempoDeclarado"
                                                  Title="Tiempo" Width="110px" />
                            <RadzenDataGridColumn TItem="PuntoPendienteDto" Title="Evidencia"
                                                  Width="110px" Sortable="false">
                                @* Cada icono lleva su title: dos glifos sueltos en una celda no dicen
                                   qué son, y esta columna se lee de reojo antes de abrir la ficha. *@
                                <Template Context="p">
                                    @if (p.TieneCaptura)
                                    {
                                        <RadzenIcon Icon="image" title="Adjuntó una captura" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.Enlace))
                                    {
                                        <RadzenIcon Icon="link" title="Adjuntó un enlace" />
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

                    @* La ficha de evidencia va SIEMPRE a la vista, debajo de la lista y no detrás de
                       un botón: revisar es mirar esto. *@
                    <RadzenCard data-recorrido="desempeno-evidencia">
                        @if (Abierta is not { } entrada)
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                                Marca una actividad para ver su evidencia completa.
                            </RadzenText>
                        }
                        else
                        {
                            <RadzenStack Gap="0.75rem">
                                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">
                                    @entrada.Desarrollador — @entrada.Criterio (@ConSigno(entrada.Puntos) pts,
                                    @entrada.Periodo)
                                </RadzenText>

                                @if (!string.IsNullOrWhiteSpace(entrada.DescripcionCriterio))
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                                        @entrada.DescripcionCriterio
                                    </RadzenText>
                                }

                                @* Aquí el reloj SÍ se conserva —al revés que en las cabeceras de la
                                   rejilla—: esta línea encadena varios datos seguidos y el glifo es lo
                                   que deja ver dónde empieza cada uno. Como icono de la fuente hereda
                                   el color atenuado del TextStyle.Caption, cosa que el emoji no hacía:
                                   se quedaba a todo color dentro de un texto gris. *@
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                                    <RadzenIcon Icon="schedule" /> @entrada.TiempoDeclarado declarados
                                    @(entrada.Requerimiento is null ? "" : $"  ·  Requerimiento: {entrada.Requerimiento}")
                                </RadzenText>

                                @* Texto escrito por una persona: se pinta TAL CUAL, sin interpretarlo
                                   como marcado. Los saltos de línea los respeta el estilo, no el HTML. *@
                                <div style="white-space:pre-wrap">@(entrada.Comentario ?? "(sin comentario)")</div>

                                @if (!string.IsNullOrWhiteSpace(entrada.Enlace))
                                {
                                    <a href="@entrada.Enlace" target="_blank" rel="noopener">
                                        <RadzenIcon Icon="link" /> @entrada.Enlace
                                    </a>
                                }

                                @if (entrada.TieneCaptura)
                                {
                                    @* Los bytes salen por la ruta que ya sirve esta imagen y que ya
                                       comprueba quién puede verla; no hace falta una segunda. *@
                                    <img src="@($"api/autocalificacion/entradas/{entrada.Id}/captura")"
                                         alt="Captura que respalda la actividad"
                                         style="max-width:100%;max-height:420px;border:1px solid var(--rz-border-color)" />
                                }

                                @if (!string.IsNullOrWhiteSpace(entrada.HistorialDeRevision))
                                {
                                    <RadzenFieldset Text="Historial de la revisión" AllowCollapse="true">
                                        <div style="white-space:pre-wrap">@entrada.HistorialDeRevision</div>
                                    </RadzenFieldset>
                                }
                            </RadzenStack>
                        }
                    </RadzenCard>
                </RadzenStack>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenStack>

@code {
    private static readonly OpcionDeMes[] Meses =
    [
        new(1, "Enero"), new(2, "Febrero"), new(3, "Marzo"), new(4, "Abril"),
        new(5, "Mayo"), new(6, "Junio"), new(7, "Julio"), new(8, "Agosto"),
        new(9, "Septiembre"), new(10, "Octubre"), new(11, "Noviembre"), new(12, "Diciembre")
    ];

    private record OpcionDeMes(int Id, string Texto);

    private readonly CancellationTokenSource _cancelacion = new();

    private int _anio = DateTime.Today.Year;
    private int _mes = DateTime.Today.Month;
    private bool _incluirNivelLead;
    private bool _ocupado;
    private DesempenoAdminDto? _datos;


    // ── El detalle de una fila del ranking ───────────────────────────────────

    /// <summary>
    /// De qué se compone la fila que se abrió. Nulo = no hay ninguna abierta.
    ///
    /// <para>Se guarda el OBJETO y no el identificador, al revés que la entrada de la cola de
    /// revisión de más abajo. Ahí hacía falta resolverlo por id porque cada recarga trae instancias
    /// nuevas y la ficha se quedaría enseñando una copia vieja; aquí el detalle no viene dentro de
    /// <c>_datos</c>: es una consulta aparte que se pide al abrir, así que no hay nada contra lo que
    /// re-resolverlo.</para>
    /// </summary>
    private DetalleDeDesempenoDto? _detalle;

    private async Task AbrirDetalleDeDesarrollador(RankingIndividualFilaDto fila) =>
        await AbrirDetalle($"api/desempeno/ranking/desarrollador/{fila.DeveloperId}");

    private async Task AbrirDetalleDeEquipo(RankingEquipoFilaDto fila) =>
        await AbrirDetalle($"api/desempeno/ranking/equipo/{fila.TeamId}");

    /// <summary>
    /// Trae el detalle DEL MES QUE SE ESTÁ MIRANDO. El período va en la petición y no se da por
    /// supuesto en el servidor: la pantalla puede estar en marzo mientras el reloj dice agosto, y un
    /// panel que contestara con el mes en curso enseñaría números que no cuadran con la fila de la
    /// que salió.
    /// </summary>
    private async Task AbrirDetalle(string ruta)
    {
        _ocupado = true;
        try
        {
            _detalle = await Api.LeerAsync<DetalleDeDesempenoDto>(
                $"{ruta}?anio={_anio}&mes={_mes}", _cancelacion.Token);
        }
        finally { _ocupado = false; }
    }

    /// <summary>
    /// El panel que se abre al pulsar una fila del ranking: los totales del período, cada entrada de
    /// puntos con su motivo y las actividades del pool que se aceptaron.
    ///
    /// <para>Es UNO SOLO y se pinta en las dos pestañas porque las dos abren el mismo contrato: en el
    /// individual «Quién» es siempre la misma persona y en el de equipo dice de qué integrante salió
    /// cada renglón. Dos paneles gemelos acabarían enseñando cosas distintas del mismo dato.</para>
    ///
    /// <para>Las DOS listas y no una: las entradas de puntos son la contabilidad —lo que suma y lo
    /// que resta, incluida la autocalificación— y las actividades del pool son el trabajo, con su
    /// tipo, su complejidad y su enlace al ticket. La segunda explica una parte de la primera, y
    /// mezclarlas dejaría una tabla con la mitad de las columnas vacías en cada renglón.</para>
    /// </summary>
    private RenderFragment PanelDeDetalle() => __builder =>
    {
        @if (_detalle is { } d)
        {
            <RadzenCard class="rz-mt-3">
                <RadzenStack Gap="0.75rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                 Gap="1rem" Wrap="FlexWrap.Wrap">
                        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                            @d.Titulo · @d.Periodo
                        </RadzenText>
                        <RadzenButton Text="Cerrar" Icon="close" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.ExtraSmall" Click="@(() => _detalle = null)" />
                    </RadzenStack>

                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                        Total <b style="@EstiloDeTotal(d.Total)">@ConSigno(d.Total)</b>
                        &nbsp;·&nbsp; premios @(d.Premio > 0 ? $"+{d.Premio}" : "—")
                        &nbsp;·&nbsp; penalizaciones @(d.Penalizacion < 0 ? d.Penalizacion.ToString() : "—")
                        &nbsp;·&nbsp; del pool @(d.DelPool == 0 ? "—" : ConSigno(d.DelPool))
                        @if (d.Retrabajos > 0)
                        {
                            <span style="color:var(--rz-danger);font-weight:600">
                                &nbsp;·&nbsp; @d.Retrabajos retrabajo(s)
                            </span>
                        }
                    </RadzenText>

                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">Puntos del mes</RadzenText>
                    <RadzenDataGrid TItem="EntradaDeDesempenoDto" Data="@d.Entradas" AllowSorting="true"
                                    AllowColumnResize="true" AllowPaging="true" PageSize="10"
                                    @attributes="@Paginador.EnEspanol"
                                    EmptyText="Sin puntos aprobados en el mes.">
                        <Columns>
                            <RadzenDataGridColumn TItem="EntradaDeDesempenoDto" Property="Fecha" Title="Fecha" Width="120px">
                                <Template Context="e">@e.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="EntradaDeDesempenoDto" Property="Quien" Title="Quién" Width="170px" />
                            <RadzenDataGridColumn TItem="EntradaDeDesempenoDto" Property="Criterio" Title="Criterio"
                                                  MinWidth="200px">
                                @* El origen se marca con una insignia y no con un color: «del pool»
                                   no es bueno ni malo, es de dónde viene, y el color en esta pantalla
                                   ya significa suma o resta. *@
                                <Template Context="e">
                                    @e.Criterio
                                    @if (e.EsDelPool)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="pool" class="rz-ml-2" />
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="EntradaDeDesempenoDto" Property="Puntos" Title="Puntos"
                                                  Width="110px" TextAlign="TextAlign.Right">
                                <Template Context="e">
                                    <b style="@EstiloDeTotal(e.Puntos)">@ConSigno(e.Puntos)</b>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="EntradaDeDesempenoDto" Property="Comentario" Title="Comentario">
                                <Template Context="e">@(e.Comentario ?? "—")</Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">
                        Actividades del pool aceptadas en el mes
                    </RadzenText>
                    <RadzenDataGrid TItem="ActividadDelPoolEnDesempenoDto" Data="@d.ActividadesDelPool"
                                    AllowSorting="true" AllowColumnResize="true" AllowPaging="true" PageSize="10"
                                    @attributes="@Paginador.EnEspanol"
                                    EmptyText="Ninguna actividad del pool se aceptó en el mes.">
                        <Columns>
                            <RadzenDataGridColumn TItem="ActividadDelPoolEnDesempenoDto" Property="AceptadaUtc"
                                                  Title="Aceptada" Width="120px">
                                <Template Context="a">
                                    @(a.AceptadaUtc is DateTime f ? f.ToLocalTime().ToString("dd/MM/yyyy") : "—")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ActividadDelPoolEnDesempenoDto" Property="Quien"
                                                  Title="Quién" Width="170px" />
                            <RadzenDataGridColumn TItem="ActividadDelPoolEnDesempenoDto" Property="Titulo"
                                                  Title="Actividad" MinWidth="220px" />
                            <RadzenDataGridColumn TItem="ActividadDelPoolEnDesempenoDto" Property="TipoTexto"
                                                  Title="Tipo" Width="130px" />
                            <RadzenDataGridColumn TItem="ActividadDelPoolEnDesempenoDto" Property="ComplejidadTexto"
                                                  Title="Complejidad" Width="130px" />
                            <RadzenDataGridColumn TItem="ActividadDelPoolEnDesempenoDto" Property="Puntos"
                                                  Title="Puntos" Width="110px" TextAlign="TextAlign.Right">
                                <Template Context="a">
                                    <b style="@EstiloDeTotal(a.Puntos)">@ConSigno(a.Puntos)</b>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ActividadDelPoolEnDesempenoDto" Title="" Width="60px" Sortable="false">
                                <Template Context="a">
                                    @if (!string.IsNullOrWhiteSpace(a.Enlace))
                                    {
                                        <a href="@a.Enlace" target="_blank" rel="noopener" title="Abrir el ticket">
                                            <RadzenIcon Icon="open_in_new" />
                                        </a>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenStack>
            </RadzenCard>
        }
    };

    // Cola de revisión.
    private List<PuntoPendienteDto> _pendientes = [];
    private IList<PuntoPendienteDto>? _marcadas;
    private int? _abiertaId;

    /// <summary>
    /// Lo marcado en la rejilla. Siempre es una <c>List</c> porque la selección se normaliza al
    /// recibirla; así esto se lee sin copiar en cada repintado y sin depender de qué tipo concreto
    /// entregue la rejilla.
    /// </summary>
    private IReadOnlyList<PuntoPendienteDto> Marcadas => (List<PuntoPendienteDto>?)_marcadas ?? [];

    /// <summary>
    /// La entrada cuya evidencia se está mirando. Se resuelve por id y no guardando el objeto:
    /// cada recarga trae instancias nuevas y la ficha se quedaría enseñando una copia vieja.
    /// </summary>
    private PuntoPendienteDto? Abierta =>
        _abiertaId is int id ? _pendientes.FirstOrDefault(p => p.Id == id) : null;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        await CargarRanking();
        await CargarPendientes();
    }

    private async Task CargarRanking()
    {
        // El panel abierto se cierra al cambiar de mes o de filtro: sus números son de OTRO período
        // y la fila de la que salió puede ya ni estar. Dejarlo abierto sería enseñar agosto debajo de
        // una tabla de marzo.
        _detalle = null;
        _ocupado = true;
        try
        {
            var ruta = $"api/desempeno/ranking?anio={_anio}&mes={_mes}" +
                       $"&incluirNivelLead={(_incluirNivelLead ? "true" : "false")}";
            _datos = await Api.LeerAsync<DesempenoAdminDto>(ruta, _cancelacion.Token);
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task CargarPendientes()
    {
        _ocupado = true;
        try
        {
            _pendientes = await Api.LeerAsync<List<PuntoPendienteDto>>(
                "api/desempeno/pendientes", _cancelacion.Token) ?? [];

            // Lo que ya se resolvió deja de estar marcado y deja de enseñarse: una ficha de algo ya
            // decidido hace creer que sigue esperando respuesta.
            var siguen = _pendientes.Select(p => p.Id).ToHashSet();
            _marcadas = Marcadas.Where(p => siguen.Contains(p.Id)).ToList();
            if (_abiertaId is int id && !siguen.Contains(id)) _abiertaId = null;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void Marcar(IList<PuntoPendienteDto>? seleccion)
    {
        // Se copia a una lista propia: la que entrega la rejilla es suya y la sigue mutando.
        _marcadas = seleccion?.ToList();
        // La ficha enseña la ÚLTIMA marcada: con varias marcadas para aprobar en tanda, la que se
        // acaba de tocar es la que se está mirando.
        _abiertaId = seleccion?.LastOrDefault()?.Id;
    }

    // ── Revisión ─────────────────────────────────────────────────────────────

    private async Task Aprobar()
    {
        var elegidas = Marcadas;
        if (elegidas.Count == 0) return;

        int puntos = elegidas.Sum(p => p.Puntos);
        if (!await Avisos.ConfirmarAsync(
            $"¿Aprobar {elegidas.Count} actividad(es)? Se abonan {ConSigno(puntos)} puntos y cuentan " +
            "de inmediato en el ranking del mes.",
            "Aprobar actividades", "Sí, aprobarlas"))
            return;

        await Enviar("api/desempeno/pendientes/aprobar",
            new AprobarPuntosRequest(elegidas.Select(p => p.Id).ToList()));
    }

    private async Task Rechazar()
    {
        var elegidas = Marcadas;
        if (elegidas.Count == 0) return;

        var motivo = await Avisos.PedirTextoAsync(
            $"¿Qué falta en {(elegidas.Count == 1 ? "esta actividad" : $"estas {elegidas.Count} actividades")}? " +
            "Es lo que va a leer para corregirlo.",
            "Rechazar actividades");

        // Vacío también cancela: el motivo es obligatorio y mandarlo en blanco solo serviría para que
        // el servidor conteste lo que ya se sabe aquí.
        if (string.IsNullOrWhiteSpace(motivo)) return;

        await Enviar("api/desempeno/pendientes/rechazar",
            new RechazarPuntosRequest(elegidas.Select(p => p.Id).ToList(), motivo));
    }

    private async Task AjustarPuntos()
    {
        if (Marcadas.Count != 1) return;
        var entrada = Marcadas[0];

        var texto = await Avisos.PedirTextoAsync(
            $"Criterio: {entrada.Criterio}\nActual: {entrada.Puntos} pts\n\n" +
            "Nuevo puntaje (puede ser negativo). La actividad seguirá pendiente de aprobación:",
            "Ajustar puntos");

        if (string.IsNullOrWhiteSpace(texto)) return;
        if (!int.TryParse(texto.Trim(), out int nuevos))
        {
            Avisos.Aviso("Escribe un número entero.");
            return;
        }

        await Enviar($"api/desempeno/pendientes/{entrada.Id}/puntos", new AjustarPuntosRequest(nuevos));
    }

    /// <summary>
    /// El envío que comparten las tres acciones. El mensaje del servidor se enseña TAL CUAL: dice
    /// cuántas se resolvieron y cuántas se omitieron porque alguien se adelantó, y cambiarlo por un
    /// «listo» genérico tiraría lo que el escritorio hacía bien.
    /// </summary>
    private async Task Enviar<T>(string ruta, T cuerpo)
    {
        _ocupado = true;
        try
        {
            var (ok, r) = await Api.EnviarAsync<T, ResultadoDto>(ruta, cuerpo, _cancelacion.Token);
            if (ok && r is not null) Avisos.Exito(r.Mensaje);
            // El ranking se recarga también cuando se rechaza: la entrada pudo haber estado aprobada
            // en otra pestaña, y de todas formas es más barato que dejar dos vistas discrepando.
            if (ok) await Cargar();
        }
        finally { _ocupado = false; }
    }

    // El reloj de arena que llevaba delante lo pone ahora el Icon de la pestaña: aquí solo queda el
    // texto, porque este método devuelve una CADENA y ahí no cabe un icono de la fuente.
    private string TituloDePendientes() =>
        _pendientes.Count == 0 ? "Pendientes de aprobación" : $"Pendientes de aprobación ({_pendientes.Count})";

    /// <summary>
    /// Una entrada en discusión se marca ENTERA, igual que en el escritorio: es una decisión que ya
    /// se tomó y se está rebatiendo, no una propuesta nueva.
    ///
    /// <para>Se marca con una BARRA en el canto y no con un fondo. El fondo crema que había aquí era
    /// opaco y claro: en tema oscuro dejaba texto claro sobre casi blanco, ilegible. Una barra
    /// interior no toca el fondo, así que no pelea con el rayado de la rejilla ni con el tema, y se
    /// sigue viendo con la fila seleccionada.</para>
    /// </summary>
    private void ResaltarLasReplicas(RowRenderEventArgs<PuntoPendienteDto> args)
    {
        if (args.Data.EsReplica) args.Attributes["style"] = "box-shadow:inset 3px 0 0 var(--rz-primary)";
    }

    /// <summary>
    /// Podio resaltado como en el escritorio. Un Lead no lo recibe: no está compitiendo.
    ///
    /// <para>Los tres puestos eran crema, azul claro y verde claro: oro, plata y bronce disfrazados,
    /// y el verde chocaba de frente con el verde de «aprobado». Ahora son tres intensidades del MISMO
    /// acento, declaradas en la paleta, así que el podio se lee como una escala —primero es más
    /// fuerte que tercero— y no como tres estados distintos.</para>
    /// </summary>
    private void ResaltarPodio(RowRenderEventArgs<RankingIndividualFilaDto> args)
    {
        var f = args.Data;
        if (f.EsNivelLead || f.Total <= 0 || f.Posicion is < 1 or > 3) return;

        var fondo = f.Posicion switch
        {
            1 => "var(--adminweb-podio-1)",
            2 => "var(--adminweb-podio-2)",
            _ => "var(--adminweb-podio-3)"
        };
        args.Attributes["style"] = $"background-color:{fondo}";
    }

    private static string ConSigno(int puntos) => puntos >= 0 ? $"+{puntos}" : puntos.ToString();

    private static string EstiloDeTotal(int total) =>
        total > 0 ? "color:var(--rz-success)" : total < 0 ? "color:var(--rz-danger)" : "";

    public void Dispose()
    {
        _cancelacion.Cancel();
        _cancelacion.Dispose();
    }
}
