    private TicketDevOpsDto? _ticket;

    private ComentariosDevOpsDto? _comentarios;
    private string _comentario = "";
    private List<ImagenAdjunta> _evidencias = [];

    private FichaDeTicketDto? _ficha;

    private int? _reasignarA;
    private string? _nuevoEstado;
    private int _nuevaPrioridad = 2;

    // Regla en edición.
    private int _reglaId;
    private DevOpsRuleMatch _reglaCondicion = DevOpsRuleMatch.AreaPathContiene;
    private string _reglaValor = "";
    private int _reglaDesarrolladorId;
    private int _reglaOrden;
    private bool _reglaActiva = true;

    private EstadoDevOpsDto? Integracion => _datos?.Integracion;
    private IReadOnlyList<FiltroGuardadoDto> FiltrosGuardados => _datos?.FiltrosGuardados ?? [];
    private IReadOnlyList<ReglaDeAsignacionDto> Reglas => _datos?.Reglas ?? [];
    private IReadOnlyList<DesarrolladorDevOpsDto> Desarrolladores => _datos?.Desarrolladores ?? [];
    private IReadOnlyList<string> EstadosConocidos => _datos?.EstadosConocidos ?? [];
    private IReadOnlyList<string> TiposConocidos => _datos?.TiposConocidos ?? [];
    private int SinPrioridad => _datos?.SinPrioridad ?? 0;

    /// <summary>
    /// Solo los desarrolladores CON correo: es lo que empata la API de DevOps al reasignar y lo que
    /// entiende la consulta de la sincronización selectiva. Ofrecer a quien no lo tiene sería ofrecer
    /// una acción que siempre falla.
    /// </summary>
    private IReadOnlyList<DesarrolladorDevOpsDto> ConCorreo =>
        Desarrolladores.Where(d => !string.IsNullOrWhiteSpace(d.Correo)).ToList();

    private static readonly IReadOnlyList<OpcionDePrioridad> Prioridades =
    [
        new(1, "1 — Muy alta"), new(2, "2 — Alta"), new(3, "3 — Media"), new(4, "4 — Baja")
    ];

    private static readonly IReadOnlyList<OpcionDeCondicion> Condiciones =
        Enum.GetValues<DevOpsRuleMatch>().Select(c => new OpcionDeCondicion(c, Etiqueta(c))).ToList();

    private record OpcionDePrioridad(int Valor, string Texto);

    private record OpcionDeCondicion(DevOpsRuleMatch Valor, string Texto);

    /// <summary>
    /// Lo que recibe la rejilla: los dos filtros de la pantalla aplicados ANTES que ella. El filtro
    /// por columna lo hace la rejilla con lo que le llegue, así que los dos se combinan con Y, igual
    /// que en el escritorio.
    ///
    /// Se guarda en un campo y se recalcula a mano en vez de ser una propiedad. No es un capricho: la
    /// rejilla considera que le cambiaron los datos cuando recibe otra LISTA, y una propiedad que
    /// devuelve una lista nueva en cada repintado le borraría los filtros por columna y la página en
    /// la que estuviera cada vez que algo de la pantalla cambia.
    /// </summary>
    private IReadOnlyList<TicketDevOpsDto> _filas = [];

    private void RecalcularFilas()
    {
        IEnumerable<TicketDevOpsDto> filas = _datos?.Filas ?? [];

        var buscar = _buscar.Trim();
        if (buscar.Length > 0)
            filas = filas.Where(t =>
                t.Numero.ToString().Contains(buscar)
                || Contiene(t.Titulo, buscar) || Contiene(t.Estado, buscar)
                || Contiene(t.Tipo, buscar) || Contiene(t.AsignadoA, buscar)
                || Contiene(t.Iteracion, buscar) || Contiene(t.Etiquetas, buscar)
                || Contiene(t.Area, buscar) || Contiene(t.Prioridad, buscar));

        var titulo = _titulo.Trim();
        if (titulo.Length > 0)
            filas = filas.Where(t => Contiene(t.Titulo, titulo));

        _filas = filas.ToList();
    }

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        _ocupado = true;
        try
        {
            _datos = await Api.LeerAsync<TableroDevOpsDto>("api/devops/tablero", _cancelacion.Token);

            // El ticket del panel abierto pudo salir de la lista o dejar de existir: mantener el panel
            // sobre algo que ya no está haría operar contra datos viejos sin que nadie lo note.
            if (_ticket is { } abierto)
                _ticket = _datos?.Filas.FirstOrDefault(t => t.Numero == abierto.Numero);
            if (_ticket is null && EsPanelDeTicket(_panel)) _panel = Panel.Ninguno;

            RecalcularFilas();
        }
        finally { _ocupado = false; }
    }

    // ── Sincronización ───────────────────────────────────────────────────────

    private async Task Sincronizar(SincronizarDevOpsRequest? filtro)
    {
        _ocupado = true;
        try
        {
            var (ok, resultado) = await Api.EnviarAsync<SincronizarDevOpsRequest?, ResultadoDeSincronizacionDto>(
                "api/devops/sincronizar", filtro, _cancelacion.Token);

            if (!ok || resultado is null) return;   // el mensaje ya se mostró

            Avisos.Exito(resultado.Mensaje);
            _cambiosVigilados = resultado.CambiosVigilados.ToList();
        }
        finally { _ocupado = false; }

        await Cargar();
    }

    private async Task SincronizarSelectiva()
    {
        var correos = ConCorreo
            .Where(d => _personasElegidas.Contains(d.Id))
            .Select(d => d.Correo!)
            .ToList();

        await Sincronizar(new SincronizarDevOpsRequest(
            _tiposElegidos.ToList(), _estadosElegidos.ToList(), correos, _diasSelectiva));

        _panel = Panel.Ninguno;
    }

    private async Task Importar()
    {
        if (!await Avisos.ConfirmarAsync(
            "Se darán de alta como requerimientos los work items asignados y abiertos que todavía no " +
            "existan aquí, repartiéndolos según las reglas.\n\nNada que ya esté cerrado se da de alta.",
            "Importar de Azure DevOps", "Sí, importar"))
            return;

        _ocupado = true;
        try
        {
            var (ok, resultado) = await Api.EnviarAsync<object?, ResultadoDeImportacionDto>(
                "api/devops/importar", null, _cancelacion.Token);

            if (ok && resultado is not null) Avisos.Exito(resultado.Mensaje);
        }
        finally { _ocupado = false; }
    }

    // ── Vistas guardadas ─────────────────────────────────────────────────────

    private void AplicarVista()
    {
        var vista = FiltrosGuardados.FirstOrDefault(f => f.Id == _filtroAplicado);
        if (vista is null) return;

        _buscar = vista.Busqueda ?? "";
        _titulo = vista.TituloContiene ?? "";
        RecalcularFilas();

        // Una vista guardada con otras columnas —o de antes de que existiera alguna— no debe tumbar
        // la pantalla: si no se puede leer, se aplican los dos filtros de texto y ya.
        try
        {
            _ajustes = string.IsNullOrWhiteSpace(vista.AjustesDeRejilla)
                ? null
                : JsonSerializer.Deserialize<DataGridSettings>(vista.AjustesDeRejilla);
        }
        catch
        {
            Avisos.Aviso("Esa vista se guardó con una versión anterior de la tabla: se aplicó solo su búsqueda.");
        }
    }

    private async Task GuardarVista()
    {
        var nombre = await Avisos.PedirTextoAsync("Nombre de la vista:", "Guardar vista");
        if (string.IsNullOrWhiteSpace(nombre)) return;

        var ajustes = _rejilla?.Settings is { } actuales ? JsonSerializer.Serialize(actuales) : null;

        await Enviar("api/devops/filtros",
            new GuardarFiltroRequest(nombre.Trim(), SinBlancos(_buscar), SinBlancos(_titulo), ajustes));
    }

    private async Task EliminarVista()
    {
        if (_filtroAplicado is not int id) return;

        var vista = FiltrosGuardados.FirstOrDefault(f => f.Id == id);
        if (vista is null) return;

        if (!await Avisos.ConfirmarAsync($"¿Eliminar la vista «{vista.Nombre}»?", "Eliminar vista"))
            return;

        if (await Enviar($"api/devops/filtros/{id}/eliminar", new { })) _filtroAplicado = null;
    }

    private void LimpiarFiltros()
    {
        _buscar = "";
        _titulo = "";
        _filtroAplicado = null;
        _ajustes = null;
        RecalcularFilas();
        _rejilla?.Reset(true, false);
    }

    // ── Acciones sobre un ticket ─────────────────────────────────────────────

    private async Task AbrirComentarios(TicketDevOpsDto t)
    {
        _ticket = t;
        _panel = Panel.Comentarios;
        _comentario = "";
        _evidencias = [];
        _comentarios = null;

        _ocupado = true;
        try
        {
            _comentarios = await Api.LeerAsync<ComentariosDevOpsDto>(
