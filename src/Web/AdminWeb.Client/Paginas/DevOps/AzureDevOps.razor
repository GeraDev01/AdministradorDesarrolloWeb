            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TicketDevOpsDto" Property="AsignadoA" Title="Asignado a" Width="160px">
                <Template Context="t">@TextoOGuion(t.AsignadoA)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TicketDevOpsDto" Property="Iteracion" Title="Iteración" Width="150px" Visible="false" />
            <RadzenDataGridColumn TItem="TicketDevOpsDto" Property="Area" Title="Área" Width="150px" Visible="false" />
            <RadzenDataGridColumn TItem="TicketDevOpsDto" Property="Etiquetas" Title="Etiquetas" Width="140px" />
            <RadzenDataGridColumn TItem="TicketDevOpsDto" Property="Puntos" Title="Pts" Width="70px" TextAlign="TextAlign.Right">
                <Template Context="t">@(t.Puntos?.ToString("0.#") ?? "—")</Template>
