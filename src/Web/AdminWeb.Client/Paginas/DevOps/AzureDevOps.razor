    private Task Vigilar(TicketDevOpsDto t) => Enviar($"api/devops/{t.Numero}/vigilar", new { });

    // ── Reglas ───────────────────────────────────────────────────────────────

    private void EditarRegla(ReglaDeAsignacionDto r)
    {
        _reglaId = r.Id;
        _reglaCondicion = r.Condicion;
        _reglaValor = r.Valor;
        _reglaDesarrolladorId = r.DesarrolladorId;
