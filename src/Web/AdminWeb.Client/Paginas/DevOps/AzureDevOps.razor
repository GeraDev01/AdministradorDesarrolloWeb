                <Template Context="t">
                    <span style="@(t.SinPrioridadDefinida && !t.Cerrado ? "color:var(--rz-warning);font-weight:600" : "")">
                        @(string.IsNullOrWhiteSpace(t.Prioridad) ? "—" : t.Prioridad)
