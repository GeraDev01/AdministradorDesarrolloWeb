    private async Task EliminarRegla(ReglaDeAsignacionDto r)
    {
        // «asigna a» y no la flecha «→»: esto viaja como CADENA hasta el cuadro de confirmación, donde
        // no hay dónde poner un icono, y la flecha no está en los subconjuntos de IBM Plex que se
        // sirven, así que la ponía la fuente de respaldo del equipo. Al escribirlo con palabras se gana
        // además decir QUÉ hace la regla, que la flecha sola dejaba a la interpretación.
        if (!await Avisos.ConfirmarAsync(
            $"¿Eliminar la regla «{r.CondicionTexto} {r.Valor}», que asigna a {r.Desarrollador}?",
            "Eliminar regla"))
            return;

        await Enviar($"api/devops/reglas/{r.Id}/eliminar", new { });
    }

    // ── Envío ────────────────────────────────────────────────────────────────

    /// <summary>
    /// El envío que comparten todas las acciones. El mensaje del servidor se enseña TAL CUAL: dice el
    /// motivo concreto —«tu token expiró», «DevOps rechazó la transición»— y cambiarlo por un «no se
    /// pudo» genérico tiraría por la borda lo que más ayuda a resolverlo.
    /// </summary>
    private async Task<bool> Enviar<T>(string ruta, T cuerpo)
    {
        _ocupado = true;
        try
        {
            var (ok, resultado) = await Api.EnviarAsync<T, ResultadoDto>(ruta, cuerpo, _cancelacion.Token);
            if (ok && resultado is not null) Avisos.Exito(resultado.Mensaje);
            if (ok) await Cargar();
            return ok;
        }
        finally { _ocupado = false; }
    }

    // ── Presentación ─────────────────────────────────────────────────────────

    private void Alternar(Panel panel)
    {
        _panel = _panel == panel ? Panel.Ninguno : panel;
        if (!EsPanelDeTicket(_panel)) _ticket = null;
    }

    private void Cerrar()
    {
        _panel = Panel.Ninguno;
        _ticket = null;
    }

    private static bool EsPanelDeTicket(Panel panel) =>
        panel is Panel.Comentarios or Panel.Ficha or Panel.Reasignar or Panel.Estado or Panel.Prioridad;

    /// <summary>
    /// Los indicadores se calculan sobre lo que la rejilla está ENSEÑANDO, igual que en el escritorio:
    /// filtrar por «Bug» y que el contador de bugs siguiera diciendo el total no serviría de nada.
    /// </summary>
    /// <remarks>
    /// El color de cada tarjeta lo decide su RÓTULO y no el gusto de esta pantalla. «Mostrados» y
    /// «Máx. por persona» son totales neutros —no significan que algo vaya bien ni mal— y por eso van
    /// en el color del texto, con el borde en el de los bordes; los ESTADOS caen en el semáforo de la
    /// aplicación; y los TIPOS de work item, que no son estados, salen de la escala de series en el
    /// orden en que aparecen. «Bugs» es la única excepción admitida: es un tipo, pero en un tablero
    /// de trabajo el rojo del bug ya es lenguaje.
    /// </remarks>
    private IReadOnlyList<(string Etiqueta, string Valor, string Color, string Borde)> Indicadores()
    {
        // View es lo que la rejilla dejó tras aplicar sus filtros de columna; antes del primer
        // pintado todavía no existe, y entonces lo que se está enseñando es la lista entera.
        var vista = _rejilla?.View is { } filtradas ? filtradas.ToList() : _filas.ToList();

        var maximoPorPersona = vista
            .Where(t => !string.IsNullOrWhiteSpace(t.AsignadoA))
            .GroupBy(t => t.AsignadoA)
            .Select(g => g.Count())
            .DefaultIfEmpty(0)
            .Max();

        return
        [
            ("Mostrados", vista.Count.ToString(), "var(--rz-text-color)", "var(--rz-border-color)"),
            ("Sin cerrar", vista.Count(t => !t.Cerrado).ToString(), "var(--rz-warning)", "var(--rz-warning)"),
            // Cerrado no es un éxito: es trabajo que ya no pide nada. Iba en verde y competía con el
            // verde de «entregado» del resto de la aplicación, que sí significa haber logrado algo.
            ("Cerrados", vista.Count(t => t.Cerrado).ToString(), "var(--rz-text-secondary-color)", "var(--rz-text-secondary-color)"),
            ("Bugs", vista.Count(t => EsTipo(t, "Bug")).ToString(), "var(--rz-danger)", "var(--rz-danger)"),
            ("User Stories", vista.Count(t => EsTipo(t, "User Story")).ToString(), "var(--adminweb-serie-1)", "var(--adminweb-serie-1)"),
            ("Tareas", vista.Count(t => EsTipo(t, "Task")).ToString(), "var(--adminweb-serie-2)", "var(--adminweb-serie-2)"),
            ("Story points", vista.Sum(t => t.Puntos ?? 0).ToString("0.#"), "var(--adminweb-serie-3)", "var(--adminweb-serie-3)"),
            ("Sin asignar", vista.Count(t => string.IsNullOrWhiteSpace(t.AsignadoA)).ToString(), "var(--rz-warning)", "var(--rz-warning)"),
            ("Máx. por persona", maximoPorPersona.ToString(), "var(--rz-text-color)", "var(--rz-border-color)"),
        ];
    }

    private string Resumen()
    {
        int total = _datos?.Filas.Count ?? 0;
        var sincronizacion = _datos?.UltimaSincronizacionUtc is DateTime s
            ? s.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            : "nunca";

        // Sin triángulo delante: esto es una cadena que se pinta como texto plano y ahí no hay dónde
        // colgar un componente, así que el carácter lo dibujaría el sistema. Tampoco hace falta: el
        // aviso de «sin prioridad» ya está dado donde de verdad se ve, en la fila del ticket
        // concreto, con su <RadzenIcon Icon="warning" /> y su title. El trozo solo se añade cuando
        // hay tickets sin prioridad, así que su mera presencia ya es el aviso.
        var pendiente = SinPrioridad > 0 ? $"  ·  {SinPrioridad} sin prioridad definida" : "";

        return $"{_filas.Count} de {total} ticket(s)  ·  última sincronización: {sincronizacion}" +
               $"  ·  vigilados: {_datos?.Vigilados ?? 0}{pendiente}";
    }

    private static bool EsTipo(TicketDevOpsDto t, string tipo) =>
        string.Equals(t.Tipo?.Trim(), tipo, StringComparison.OrdinalIgnoreCase);

    private static bool Contiene(string? valor, string texto) =>
        valor != null && valor.Contains(texto, StringComparison.CurrentCultureIgnoreCase);

    /// <summary>Lo que no tiene valor se pinta como raya, no como hueco.</summary>
    private static string TextoOGuion(string? valor) => string.IsNullOrWhiteSpace(valor) ? "—" : valor;

    /// <summary>Un filtro en blanco es «sin filtro», no un filtro por cadena vacía.</summary>
    private static string? SinBlancos(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();

    private static string Etiqueta(DevOpsRuleMatch condicion) => condicion switch
    {
        DevOpsRuleMatch.AreaPathContiene => "Área contiene",
        DevOpsRuleMatch.TipoEsIgual => "Tipo es igual a",
        DevOpsRuleMatch.TituloContiene => "Título contiene",
        DevOpsRuleMatch.TagContiene => "Etiqueta contiene",
        DevOpsRuleMatch.AsignadoAContiene => "Asignado a contiene",
        _ => condicion.ToString()
    };

    public void Dispose()
    {
        _cancelacion.Cancel();
        _cancelacion.Dispose();
    }
}
