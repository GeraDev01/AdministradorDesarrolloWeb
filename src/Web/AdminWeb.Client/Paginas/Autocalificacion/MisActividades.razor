                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="EvidenciaDto" Title="" Width="150px" Sortable="false">
                                <Template Context="ev">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
