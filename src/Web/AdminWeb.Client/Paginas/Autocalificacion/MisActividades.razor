                            <RadzenDataGridColumn TItem="EvidenciaDto" Title="Tamaño" Width="100px"
                                                  TextAlign="TextAlign.Right">
                                <Template Context="ev">@Tamano(ev.Bytes)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="EvidenciaDto" Property="Nota" Title="Nota" />
                            <RadzenDataGridColumn TItem="EvidenciaDto" Title="Adjuntada" Width="140px">
