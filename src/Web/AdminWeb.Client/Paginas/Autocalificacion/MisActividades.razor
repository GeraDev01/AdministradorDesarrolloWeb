    private void AbrirActividad(ActividadLibreDto? a) =>
        _actividad = a == null
            ? new FormularioDeActividad()
            : new FormularioDeActividad { Id = a.Id, Titulo = a.Titulo, Descripcion = a.Descripcion ?? "" };

    private async Task GuardarActividad()
    {
        if (_actividad is not { } f) return;

        var cuerpo = new ActividadLibreRequest(f.Titulo, f.Descripcion);
        var ruta = f.Id is int id
            ? $"api/autocalificacion/actividades/{id}/edicion"
            : "api/autocalificacion/actividades";

        if (await Enviar(ruta, cuerpo)) _actividad = null;
    }

    private async Task CerrarOReabrir(ActividadLibreDto a)
    {
        if (!a.EstaAbierta)
        {
            await Enviar($"api/autocalificacion/actividades/{a.Id}/reapertura", SinCuerpo);
            return;
        }

        // Con confirmación, igual que en el escritorio: cerrar detiene el cronómetro y consolida el
        // tiempo, y volver atrás obliga a reabrirla.
        if (!await Avisos.ConfirmarAsync(
            $"¿Cerrar «{a.Titulo}»? Tiempo registrado: {Reloj(a.SegundosCronometrados)}. " +
            "Si el cronómetro está corriendo, se detendrá.",
            "Cerrar actividad", "Sí, cerrar"))
            return;

        await Enviar($"api/autocalificacion/actividades/{a.Id}/cierre", SinCuerpo);
    }

    private async Task EliminarActividad(ActividadLibreDto a)
    {
        if (!await Avisos.ConfirmarAsync(
            $"¿Eliminar «{a.Titulo}»? Solo se puede si no tiene tiempo registrado.",
            "Eliminar actividad", "Sí, eliminar"))
            return;

        if (await Enviar($"api/autocalificacion/actividades/{a.Id}/eliminacion", SinCuerpo)
            && _abierta?.Id == a.Id)
        {
            _abierta = null;
            _evidencias = [];
        }
    }

    private async Task VerEvidencia(ActividadLibreDto a)
    {
        _abierta = _abierta?.Id == a.Id ? null : a;
        _evidencias = [];
        _nuevaEvidencia = [];
        _notaDeEvidencia = "";
        if (_abierta != null) await CargarEvidencias(_abierta.Id);
    }

    private async Task CargarEvidencias(int actividadId) =>
        _evidencias = await Api.LeerAsync<List<EvidenciaDto>>(
            $"api/autocalificacion/actividades/{actividadId}/evidencias", _cancelacion.Token) ?? [];

    /// <summary>
    /// Sube el archivo como formulario y no como JSON: en base64 cada archivo engorda un tercio y
    /// obliga al servidor a materializarlo entero antes de poder mirarlo. El tipo de contenido no se
    /// manda porque el servidor lo decide por los BYTES; enviarlo sería decorativo.
    /// </summary>
    private async Task AdjuntarEvidencia()
    {
        if (_abierta is not { } a || _nuevaEvidencia.FirstOrDefault() is not { } imagen) return;

        var formulario = new MultipartFormDataContent
        {
            { new ByteArrayContent(imagen.Contenido), "archivo", imagen.Nombre }
        };
        if (!string.IsNullOrWhiteSpace(_notaDeEvidencia))
            formulario.Add(new StringContent(_notaDeEvidencia), "nota");

        _ocupado = true;
        try
        {
            var (ok, r) = await Api.SubirAsync<ResultadoDto>(
                $"api/autocalificacion/actividades/{a.Id}/evidencias", formulario, _cancelacion.Token);

            if (ok && r is not null) Avisos.Exito(r.Mensaje);
            if (!ok) return;

            _nuevaEvidencia = [];
            _notaDeEvidencia = "";
        }
        finally
        {
            _ocupado = false;
        }

        await Cargar();
    }

    private async Task QuitarEvidencia(EvidenciaDto ev)
    {
        if (!await Avisos.ConfirmarAsync(
            $"¿Quitar «{ev.NombreArchivo}» de la evidencia? No se puede deshacer.",
            "Quitar evidencia", "Sí, quitar"))
            return;

        await Enviar($"api/autocalificacion/evidencias/{ev.Id}/eliminacion", SinCuerpo);
    }

    // ── Envío ────────────────────────────────────────────────────────────────

    /// <summary>
    /// Para las operaciones que no llevan datos: la ruta ya dice todo (cerrar, reabrir, eliminar) y
    /// el identificador va en ella.
    /// </summary>
    private static readonly object SinCuerpo = new();

    /// <summary>
    /// El envío que comparten todas las acciones. El mensaje del servidor se enseña TAL CUAL: explica
    /// el motivo en concreto —«la actividad tiene 2h 30m de tiempo registrado y no se puede
    /// eliminar»— y sustituirlo por un «no se pudo» genérico tiraría lo que el escritorio hacía bien.
    /// </summary>
    private async Task<bool> Enviar<T>(string ruta, T cuerpo)
    {
        _ocupado = true;
        try
        {
            var (ok, r) = await Api.EnviarAsync<T, ResultadoDto>(ruta, cuerpo, _cancelacion.Token);
            if (ok && r is not null) Avisos.Exito(r.Mensaje);
            if (ok) await Cargar();
            return ok;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private Task Abrir(string url) => Descargas.AbrirEnOtraPestanaAsync(url).AsTask();

    // ── Formato ──────────────────────────────────────────────────────────────

    private static bool HayCriterios(MisActividadesDto d) => d.Criterios.Any(c => c.Disponible);

    /// <summary>El tope de horas sale del que aplica el servidor, menos los 59 minutos del otro campo.</summary>
    private static int MaxHoras(MisActividadesDto d) => (d.Limites.MaxMinutosDeclarados - 59) / 60;

    /// <summary>«(Ninguno)» delante, como en el escritorio: el requerimiento es opcional.</summary>
    private static List<OpcionDto> ConNinguno(IReadOnlyList<OpcionDto> opciones) =>
        [new OpcionDto(0, "(Ninguno)"), .. opciones];

    private static string ConSigno(int puntos) => puntos >= 0 ? $"+{puntos}" : puntos.ToString();

    private static string Periodo(int anio, int mes) =>
        $"{Meses.FirstOrDefault(m => m.Id == mes)?.Texto ?? mes.ToString()} {anio}";

    private static string Minutos(int? minutos) => minutos switch
    {
        null or <= 0 => "—",
        >= 60 => $"{minutos / 60}h {minutos % 60:00}m",
        _ => $"{minutos}m"
    };

    private static string Reloj(int segundos)
    {
        var t = TimeSpan.FromSeconds(Math.Max(0, segundos));
        return t.TotalHours >= 1
            ? $"{(int)t.TotalHours}h {t.Minutes:00}m {t.Seconds:00}s"
            : $"{t.Minutes:00}m {t.Seconds:00}s";
    }

    private static string Tamano(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / (1024.0 * 1024.0):0.0} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    // Solo la palabra: esto devuelve una CADENA, y va acompañada por el punto de color que pinta la
    // rejilla, así que el estado está dicho también por algo que obedece al tema. Las marcas que
    // llevaba delante no lo hacían —las dibujaba el sistema operativo— y aquí no hay dónde colgar un
    // <RadzenIcon>: es un string.
    //
    // El COLOR ya no está aquí. Vivía justo debajo, en una ColorDeEstado local que devolvía la
    // declaración entera «color:var(--…)»; se fue a ColoresDeEstado.ColorDeAprobacion, en Shared,
    // devolviendo la variable sola para que sirva de background del punto. No la repongas aquí: una
    // copia local es como empiezan las tablas que un día dicen cosas distintas en dos pantallas.
    private static string Estado(PointApprovalStatus estado) => estado switch
    {
        PointApprovalStatus.Aprobado => "Aprobado",
        PointApprovalStatus.Pendiente => "Pendiente",
        PointApprovalStatus.Rechazado => "Rechazado",
        _ => estado.ToString()
    };

    public void Dispose()
    {
        _cancelacion.Cancel();
        _cancelacion.Dispose();
    }

    // ── Estado de los formularios ────────────────────────────────────────────

    /// <summary>
    /// Lo que se está capturando de una entrada de puntos. <c>Id</c> nulo es un alta; con
    /// identificador es una corrección.
    /// </summary>
    private sealed class FormularioDeEntrada
    {
        public int? Id { get; set; }
        public int CriterioId { get; set; }
        public int Anio { get; set; } = DateTime.Today.Year;
        public int Mes { get; set; } = DateTime.Today.Month;
        public int Horas { get; set; }
        public int Minutos { get; set; }
        public string Enlace { get; set; } = "";
        public string Comentario { get; set; } = "";

        /// <summary>0 es «(Ninguno)»: un desplegable no admite nulo como valor.</summary>
        public int RequerimientoId { get; set; }

        /// <summary>La entrada ya traía captura guardada. No se baja: solo se dice que está.</summary>
        public bool TeniaCaptura { get; set; }

        public bool QuitarCaptura { get; set; }

        /// <summary>La imagen nueva, si se eligió o se pegó una. Sustituye a la guardada.</summary>
        public List<ImagenAdjunta> Captura { get; set; } = [];
    }

    private sealed class FormularioDeReplica
    {
        public required AutocalificacionDto Entrada { get; init; }
        public string Argumento { get; set; } = "";
    }

    private sealed class FormularioDeActividad
    {
        public int? Id { get; set; }
        public string Titulo { get; set; } = "";
        public string Descripcion { get; set; } = "";
    }
}
