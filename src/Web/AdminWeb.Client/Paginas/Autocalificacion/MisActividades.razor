    private RenderFragment PanelDeEvidencia(MisActividadesDto d, ActividadLibreDto a) => __builder =>
    {
        <RadzenCard Style="border-left:5px solid var(--rz-info)">
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">
                        <RadzenIcon Icon="attach_file" /> Evidencia de «@a.Titulo»
                    </RadzenText>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                  title="Cerrar el panel" Click="@(() => VerEvidencia(a))" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                    Es lo que convierte «estuve 6 h en esto» en algo que el líder puede revisar.
