@page "/mis-actividades"
@attribute [Authorize(Policy = "AdminUDesarrollador")]
@using AdminWeb.Shared.Dtos.Autocalificacion
@implements IDisposable
@inject ClienteApi Api
@inject AvisosDeInterfaz Avisos
@inject Descargas Descargas

@*
    Mis actividades: lo que el desarrollador escribe sobre su propio trabajo.

    Junta lo que en el escritorio estaba en dos sitios —la pestaña «Mis actividades y puntos» del
    panel y la pantalla «Actividades libres»— porque son la misma pregunta contestada de dos formas:
    qué hice y con qué lo respaldo. Separarlas obligaba a recordar en cuál de las dos estaba cada
    cosa.

    Tres decisiones del escritorio que se conservan tal cual, por lo que valen y no por costumbre:

      · El PUNTAJE se enseña, no se edita. Lo fija el criterio y solo el líder lo ajusta al revisar.
        Antes era un campo escribible de 1 a 999, que contradecía la regla del propio módulo.
      · Una entrada APROBADA no ofrece «Corregir». La regla la aplica el servidor; aquí se refleja
        para no enseñar un botón que va a fallar.
      · Al replicar, el motivo del rechazo va DELANTE del cuadro donde se argumenta. Pedir que
        alguien responda sin tener a la vista lo que se le objetó es la forma más segura de que la
        segunda vuelta repita el malentendido de la primera.

    Lo que cambia respecto al escritorio: allí el formulario validaba el enlace antes de cerrarse
    porque al aceptar se perdía lo escrito. Aquí el panel NO se cierra si el servidor rechaza, así
    que no hace falta copiar esa regla en el navegador — y copiarla sería tener dos reglas que
    tarde o temprano se separan.
*@

<PageTitle>Mis actividades</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
        <RadzenText TextStyle="TextStyle.H5" class="rz-mb-0">Mis actividades</RadzenText>
        <RadzenButton Text="Recargar" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small" Click="@Cargar" Disabled="@_ocupado" />
    </RadzenStack>

    @if (_datos is { } d)
    {
        @if (!d.TieneFicha)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false">
                Tu cuenta no está vinculada a una ficha de desarrollador, así que no puedes registrar
                actividades ni puntos. Contacta al líder si esto no es correcto.
            </RadzenAlert>
        }
        else
        {
            @* Los glifos van en Icon, que RadzenTabsItem sí tiene, y no dentro del Text: un emoji lo
               dibuja el sistema operativo, no hereda el color de la pestaña activa y se ve distinto
               en cada equipo. «checklist» —y no «edit_note»— porque el lápiz está reservado a la
               ACCIÓN de editar, que aquí mismo aparece en varios botones; una pestaña que se lo
               quede haría creer que edita algo. «extension» es la pieza de rompecabezas que ya lleva
               esta misma sección en el menú lateral. *@
            <RadzenTabs>
                <Tabs>
                    <RadzenTabsItem Text="Actividades y puntos" Icon="checklist">
                        @PanelDePuntos(d)
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Actividades libres" Icon="extension">
                        @PanelDeActividades(d)
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        }
    }
</RadzenStack>

@code {
    private readonly CancellationTokenSource _cancelacion = new();

    private MisActividadesDto? _datos;
    private bool _ocupado;

    /// <summary>Formulario de alta o corrección abierto; null significa que no hay ninguno.</summary>
    private FormularioDeEntrada? _entrada;

    /// <summary>Réplica en curso. Solo una a la vez: son dos actos distintos y mezclarlos confunde.</summary>
    private FormularioDeReplica? _replica;

    private FormularioDeActividad? _actividad;

    /// <summary>La casilla del escritorio, con el mismo valor por omisión.</summary>
    private bool _verCerradas = true;

    /// <summary>Actividad cuya evidencia se está mirando. El panel se abre y se cierra con el mismo botón.</summary>
    private ActividadLibreDto? _abierta;
    private List<EvidenciaDto> _evidencias = [];
    private List<ImagenAdjunta> _nuevaEvidencia = [];
    private string _notaDeEvidencia = "";

    private static readonly OpcionDeMes[] Meses =
    [
        new(1, "Enero"), new(2, "Febrero"), new(3, "Marzo"), new(4, "Abril"),
        new(5, "Mayo"), new(6, "Junio"), new(7, "Julio"), new(8, "Agosto"),
        new(9, "Septiembre"), new(10, "Octubre"), new(11, "Noviembre"), new(12, "Diciembre")
    ];

    private record OpcionDeMes(int Id, string Texto);

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        _ocupado = true;
        try
        {
            _datos = await Api.LeerAsync<MisActividadesDto>("api/autocalificacion/mias", _cancelacion.Token);

            // La actividad que se estaba mirando se vuelve a resolver contra la lista recién traída:
            // pudo cerrarse o desaparecer, y conservar la vieja dejaría el panel enseñando un estado
            // que ya no es cierto.
            if (_abierta is { } previa)
            {
                _abierta = _datos?.ActividadesLibres.FirstOrDefault(a => a.Id == previa.Id);
                if (_abierta != null) await CargarEvidencias(_abierta.Id);
                else _evidencias = [];
            }
        }
        finally
        {
            _ocupado = false;
        }
    }

    // ── Autocalificación ─────────────────────────────────────────────────────

    private RenderFragment PanelDePuntos(MisActividadesDto d) => __builder =>
    {
        <RadzenStack Gap="0.75rem" class="rz-mt-2">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         Gap="0.75rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="Registrar actividad" Icon="add" ButtonStyle="ButtonStyle.Primary"
                              Click="@AbrirRegistro" Disabled="@(_ocupado || !HayCriterios(d))" />
                @* El nivel decide qué actividades tocan: varias son «(Junior)», «(Mid)» o «(Senior)»
                   y sin tenerlo a la vista no se sabe cuáles son las propias. *@
                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                    Tu nivel: <b>@(d.Nivel ?? "— sin nivel registrado —")</b>
                </RadzenText>
            </RadzenStack>

            @if (!HayCriterios(d))
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" AllowClose="false">
                    Todavía no hay actividades configuradas que puedas registrar. Pídeselas al líder.
                </RadzenAlert>
            }

            @if (_entrada is { } f)
            {
                @FormularioDePuntos(d, f)
            }

            @if (_replica is { } r)
            {
                @FormularioDeRespuesta(d, r)
            }

            <RadzenDataGrid TItem="AutocalificacionDto" Data="@d.Autocalificaciones" IsLoading="@_ocupado"
                            AllowSorting="true" AllowPaging="true" PageSize="15"
                            EmptyText="Todavía no has registrado ninguna actividad.">
                <Columns>
                    <RadzenDataGridColumn TItem="AutocalificacionDto" Title="Fecha" Width="105px">
                        <Template Context="e">@e.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AutocalificacionDto" Property="Criterio" Title="Qué hiciste">
                        <Template Context="e">
                            <div title="@(e.DescripcionCriterio ?? "(esta actividad no tiene descripción)")">
                                @e.Criterio
                            </div>
                            @if (!string.IsNullOrWhiteSpace(e.Comentario))
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">@e.Comentario</RadzenText>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AutocalificacionDto" Property="Puntos" Title="Puntos"
                                          Width="90px" TextAlign="TextAlign.Right">
                        <Template Context="e"><b>@ConSigno(e.Puntos)</b></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AutocalificacionDto" Title="Período" Width="120px">
                        <Template Context="e">@Periodo(e.Anio, e.Mes)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AutocalificacionDto" Title="Tiempo" Width="100px">
                        <Template Context="e">@Minutos(e.MinutosDeclarados)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AutocalificacionDto" Title="Origen" Width="150px">
                        @* De quién salió la entrada: decide qué se puede hacer con ella. *@
                        <Template Context="e">
                            @(e.EsAutocalificacion ? "Autocalificación" : "Asignado por líder")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AutocalificacionDto" Title="Estado" Width="130px">
                        @* Tres palabras que pesan exactamente lo mismo en la vista —«Aprobado»,
                           «Pendiente», «Rechazado»— en una lista que se recorre buscando UNA de las
                           tres: la rechazada, que es la que hay que corregir. Es el mismo caso que la
                           columna «Resultado» de la bitácora, y por eso lleva el mismo punto y la
                           misma paleta: cómo acabó algo que se intentó.

                           El texto vuelve a TINTA NORMAL. Iba coloreado dentro de un <b>, y tener el
                           punto Y la palabra de color es decir el mismo dato dos veces; la negrita se
                           va con él porque aquí solo servía para sostener el color.

                           El color ya no lo decide esta pantalla: sale de ColoresDeEstado, en Shared,
                           que devuelve la variable SOLA —la de aquí devolvía «color:var(--…)», que no
                           vale para el background del punto— y cierra en neutro en vez de en cadena
                           vacía, porque un punto sin relleno no se lee como «neutro» sino como que el
                           pintado falló.

                           El punto va DELANTE del texto y la pastilla de «vueltas» detrás, y no
                           compiten: una dice en qué punto está la entrada y la otra cuántas veces ha
                           ido y vuelto, que son dos datos distintos.

                           Marcado copiado de Componentes/BotonDeEstado.razor: el borde gris mantiene
                           el punto visible aunque falte la variable, y la palabra va siempre al lado. *@
                        <Template Context="e">
                            <span style="white-space:nowrap;display:inline-flex;align-items:center;gap:.4rem">
                                <span style="width:.55rem;height:.55rem;flex:none;border-radius:50%;border:1px solid var(--rz-border-color);background:@ColoresDeEstado.ColorDeAprobacion(e.Estado)"></span>
                                @Estado(e.Estado)
                            </span>
                            @if (e.Vueltas > 0)
                            {
                                @* RadzenBadge NO tiene parámetro Icon, así que el glifo entra por el
                                   ChildContent, que según la documentación de Radzen ANULA el Text.
                                   Si alguien vuelve a poner Text aquí, lo de dentro seguirá ganando y
                                   ese Text quedará como código muerto. «restart_alt» es el glifo que
                                   la aplicación usa para las «vueltas» de revisión en las tres
                                   pantallas donde salen. *@
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" title="@e.HistorialDeRevision">
                                    <RadzenIcon Icon="restart_alt" /> ×@e.Vueltas
                                </RadzenBadge>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AutocalificacionDto" Title="Motivo del líder" Width="200px">
                        @* Lo que el desarrollador necesita ver cuando algo se rechaza. Sin esto, un
                           rechazo es un «no» sin explicación. *@
                        <Template Context="e">
                            @if (!string.IsNullOrWhiteSpace(e.ComentarioDeRevision))
                            {
                                <span title="@e.HistorialDeRevision">@e.ComentarioDeRevision</span>
                            }
                            else if (e.Estado == PointApprovalStatus.Rechazado)
                            {
                                <span>(sin motivo registrado)</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AutocalificacionDto" Title="" Width="240px" Sortable="false">
                        <Template Context="e">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                                @if (e.SePuedeCorregir)
                                {
                                    <RadzenButton Text="Corregir" Icon="edit" ButtonStyle="ButtonStyle.Light"
                                                  Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                  Click="@(() => AbrirCorreccion(e))" />
                                }
                                @if (e.SePuedeReplicar)
                                {
                                    @* «reply» A PROPÓSITO, y no «content_copy»: aquí «replicar» no
                                       es duplicar la entrada, es CONTESTARLE al líder que la
                                       rechazó —abre el cuadro de argumento y la manda otra vez a
                                       revisión. Hay destinatario humano, que es justo la condición
                                       de la flecha de responder. No lo cambies a copiar. *@
                                    <RadzenButton Text="Replicar" Icon="reply" ButtonStyle="ButtonStyle.Secondary"
                                                  Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                  Click="@(() => AbrirReplica(e))"
                                                  title="Argumenta y vuelve a mandarla a revisión." />
                                }
                                @if (e.TieneCaptura)
                                {
                                    <RadzenButton Icon="image" ButtonStyle="ButtonStyle.Light"
                                                  Size="ButtonSize.ExtraSmall" title="Ver la captura"
                                                  Click="@(() => Abrir($"api/autocalificacion/entradas/{e.Id}/captura"))" />
                                }
                                @if (!string.IsNullOrWhiteSpace(e.Enlace))
                                {
                                    <RadzenButton Icon="link" ButtonStyle="ButtonStyle.Light"
                                                  Size="ButtonSize.ExtraSmall" title="@e.Enlace"
                                                  Click="@(() => Abrir(e.Enlace!))" />
                                }
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    };

    private RenderFragment FormularioDePuntos(MisActividadesDto d, FormularioDeEntrada f) => __builder =>
    {
        var criterio = d.Criterios.FirstOrDefault(c => c.Id == f.CriterioId);

        <RadzenCard Style="border-left:5px solid var(--rz-primary)">
            <RadzenStack Gap="0.75rem">
                @* El icono del título es el MISMO que el del botón que abrió el panel: así se ve de
                   un golpe si lo que está abierto es un alta o una corrección. *@
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">
                    <RadzenIcon Icon="@(f.Id is null ? "add" : "edit")" />
                    @(f.Id is null ? "Registrar actividad" : "Corregir actividad")
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                    @(f.Id is null
                        ? "Los puntos que registres quedan PENDIENTES hasta que el líder los apruebe."
                        : "Puedes corregirla mientras no esté aprobada. Corregir no la devuelve a revisión: para eso está «Replicar».")
                </RadzenText>

                @* «Criterio» es vocabulario del módulo de puntuación, no de quien registra lo que
                   hizo. Al desarrollador se le pregunta lo que de verdad se le está preguntando. *@
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="¿Qué hiciste? *" Component="criterio" />
                    <RadzenDropDown @bind-Value="f.CriterioId" Data="@d.Criterios" Name="criterio"
                                    TextProperty="Texto" ValueProperty="Id" Style="width:100%"
                                    Disabled="@_ocupado" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                        @(string.IsNullOrWhiteSpace(criterio?.Descripcion)
                            ? "(esta actividad no tiene descripción; pídesela al líder)"
                            : criterio!.Descripcion)
                    </RadzenText>
                    @if (criterio is { Disponible: false })
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false">
                            Esta actividad ya no está disponible: elige otra para poder guardar.
                        </RadzenAlert>
                    }
                </RadzenStack>

                @* El puntaje lo fija el criterio, no el desarrollador: se muestra, no se edita. *@
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-0">Esto vale:</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-0" Style="color:var(--rz-success)">
                        @(criterio is null ? "—" : $"+{criterio.Puntos}")
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                        El valor lo define el líder. Solo él puede ajustarlo al revisarlo.
                    </RadzenText>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             Gap="0.75rem" Wrap="FlexWrap.Wrap">
                    <RadzenLabel Text="Período:" Component="mes" />
                    <RadzenDropDown @bind-Value="f.Mes" Data="@Meses" TextProperty="Texto" ValueProperty="Id"
                                    Name="mes" Style="width:150px" Disabled="@_ocupado" />
                    <RadzenNumeric @bind-Value="f.Anio" Min="2020" Max="2099" Style="width:110px"
                                   Disabled="@_ocupado" />
                </RadzenStack>

                @* Tiempo DECLARADO, no cronometrado: cubre el trabajo que ocurre sin la aplicación
                   abierta (una junta, un apoyo de pasillo), que es justo el que no quedaba en ningún
                   lado. El tope de horas sale del que aplica el servidor y no de un número escrito
                   aquí: con uno propio, el campo dejaba capturar más de lo que se acepta y el
                   registro se rechazaba al guardar sin haber avisado de nada. *@
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenLabel Text="Tiempo dedicado (opcional):" />
                    <RadzenNumeric @bind-Value="f.Horas" Min="0" Max="@MaxHoras(d)" Style="width:100px"
                                   Disabled="@_ocupado" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">h</RadzenText>
                    <RadzenNumeric @bind-Value="f.Minutos" Min="0" Max="59" Step="5" Style="width:100px"
                                   Disabled="@_ocupado" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">min</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                        Independiente del cronómetro. Déjalo en 0 si no aplica.
                    </RadzenText>
                </RadzenStack>

                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Enlace al item de DevOps (PR, work item o ticket):" Component="enlace" />
                    <RadzenTextBox @bind-Value="f.Enlace" Name="enlace" Style="width:100%"
                                   Placeholder="https://dev.azure.com/…" Disabled="@_ocupado" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                        Copia la dirección desde la barra del navegador. El líder podrá abrirla al revisar.
                    </RadzenText>
                </RadzenStack>

                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Comentario / evidencia:" Component="comentario" />
                    <RadzenTextArea @bind-Value="f.Comentario" Name="comentario" Rows="3"
                                    Style="width:100%" Disabled="@_ocupado" />
                </RadzenStack>

                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Requerimiento (opcional):" Component="requerimiento" />
                    <RadzenDropDown @bind-Value="f.RequerimientoId" Data="@ConNinguno(d.Requerimientos)"
                                    Name="requerimiento" TextProperty="Texto" ValueProperty="Id"
                                    Style="width:100%" Disabled="@_ocupado" />
                </RadzenStack>

                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Captura de pantalla (opcional):" />
                    @if (f.TeniaCaptura && !f.QuitarCaptura && f.Captura.Count == 0)
                    {
                        @* Con captura guardada no se vuelve a bajar para volver a subirla: se enseña
                           que está, se puede abrir, y solo viaja si se cambia o se quita. *@
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">Ya tiene una captura.</RadzenText>
                            <RadzenButton Text="Verla" Icon="image" ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.ExtraSmall"
                                          Click="@(() => Abrir($"api/autocalificacion/entradas/{f.Id}/captura"))" />
                            @* «clear» (aspa de vaciar un campo) y no «close» (aspa de cerrar una
                               ventana): esto quita la captura elegida, no cierra nada. *@
                            <RadzenButton Text="Quitarla" Icon="clear" ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.ExtraSmall" Click="@(() => f.QuitarCaptura = true)" />
                        </RadzenStack>
                    }
                    else if (f.QuitarCaptura && f.Captura.Count == 0)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                                La captura se quitará al guardar.
                            </RadzenText>
                            <RadzenButton Text="Conservarla" ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.ExtraSmall" Click="@(() => f.QuitarCaptura = false)" />
                        </RadzenStack>
                    }
                    <PegarImagen @bind-Imagenes="f.Captura" Maximo="1" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="@(f.Id is null ? "Enviar a revisión" : "Guardar cambios")"
                                  Icon="@(f.Id is null ? "send" : "save")"
                                  ButtonStyle="ButtonStyle.Primary" Click="@GuardarEntrada" Disabled="@_ocupado" />
                    <RadzenButton Text="Cancelar" Icon="close" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => _entrada = null)" Disabled="@_ocupado" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    };

    private RenderFragment FormularioDeRespuesta(MisActividadesDto d, FormularioDeReplica r) => __builder =>
    {
        <RadzenCard Style="border-left:5px solid var(--rz-warning)">
            <RadzenStack Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">
                    <RadzenIcon Icon="reply" /> Replicar el rechazo
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                    <b>@r.Entrada.Criterio</b> (@ConSigno(r.Entrada.Puntos) pts)
                    @if (r.Entrada.Vueltas > 0)
                    {
                        <span> — ya ha ido y vuelto @r.Entrada.Vueltas vez/veces.</span>
                    }
                </RadzenText>

                @* El motivo va delante del cuadro donde se argumenta, igual que en el escritorio. *@
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Por qué te la rechazaron" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0"
                                Style="@(string.IsNullOrWhiteSpace(r.Entrada.ComentarioDeRevision) ? "" : "color:var(--rz-danger)")">
                        @(string.IsNullOrWhiteSpace(r.Entrada.ComentarioDeRevision)
                            ? "El líder no dejó un motivo."
                            : r.Entrada.ComentarioDeRevision)
                    </RadzenText>
                </RadzenStack>

                @if (!string.IsNullOrWhiteSpace(r.Entrada.HistorialDeRevision))
                {
                    <RadzenStack Gap="0.25rem">
                        <RadzenLabel Text="Lo que se ha dicho hasta ahora" />
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0"
                                    Style="white-space:pre-wrap">@r.Entrada.HistorialDeRevision</RadzenText>
                    </RadzenStack>
                }

                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Tu argumento *" Component="argumento" />
                    <RadzenTextArea @bind-Value="r.Argumento" Name="argumento" Rows="5" Style="width:100%"
                                    MaxLength="@d.Limites.MaxArgumento" Disabled="@_ocupado" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                        Es lo que el líder va a leer. Hasta @d.Limites.MaxArgumento caracteres.
                    </RadzenText>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="Enviar a revisión" Icon="send" ButtonStyle="ButtonStyle.Primary"
                                  Click="@EnviarReplica" Disabled="@_ocupado" />
                    <RadzenButton Text="Cancelar" Icon="close" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => _replica = null)" Disabled="@_ocupado" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    };

    private void AbrirRegistro()
    {
        _entrada = new FormularioDeEntrada
        {
            CriterioId = _datos?.Criterios.FirstOrDefault(c => c.Disponible)?.Id ?? 0
        };
        _replica = null;
    }

    private void AbrirCorreccion(AutocalificacionDto e)
    {
        int minutos = e.MinutosDeclarados ?? 0;
        _entrada = new FormularioDeEntrada
        {
            Id = e.Id,
            CriterioId = e.CriterioId,
            Anio = e.Anio,
            Mes = e.Mes,
            Horas = minutos / 60,
            Minutos = minutos % 60,
            Enlace = e.Enlace ?? "",
            Comentario = e.Comentario ?? "",
            RequerimientoId = e.RequerimientoId ?? 0,
            TeniaCaptura = e.TieneCaptura
        };
        _replica = null;
    }

    private async Task GuardarEntrada()
    {
        if (_entrada is not { } f) return;

        int minutos = f.Horas * 60 + f.Minutos;
        var captura = f.Captura.FirstOrDefault();

        var cuerpo = new AutocalificacionRequest(
            f.CriterioId, f.Anio, f.Mes,
            f.Comentario,
            f.RequerimientoId > 0 ? f.RequerimientoId : null,
            minutos > 0 ? minutos : null,
            f.Enlace,
            captura?.Contenido, captura?.Nombre,
            f.QuitarCaptura);

        var ruta = f.Id is int id
            ? $"api/autocalificacion/entradas/{id}/correccion"
            : "api/autocalificacion/entradas";

        // El panel solo se cierra si el servidor aceptó: si rechaza, lo escrito sigue ahí para
        // corregirlo, que es lo que en el escritorio obligaba a validar antes de cerrar el diálogo.
        if (await Enviar(ruta, cuerpo)) _entrada = null;
    }

    private void AbrirReplica(AutocalificacionDto e)
    {
        _replica = new FormularioDeReplica { Entrada = e };
        _entrada = null;
    }

    private async Task EnviarReplica()
    {
        if (_replica is not { } r) return;
        if (await Enviar($"api/autocalificacion/entradas/{r.Entrada.Id}/replica", new ReplicaRequest(r.Argumento)))
            _replica = null;
    }

