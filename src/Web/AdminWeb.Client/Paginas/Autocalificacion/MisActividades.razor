                    <RadzenDataGrid TItem="EvidenciaDto" Data="@_evidencias" AllowPaging="false"
                                    AllowSorting="false" EmptyText="">
                        <Columns>
                            <RadzenDataGridColumn TItem="EvidenciaDto" Title="Archivo">
                                @* Aquí el dibujo SÍ hace falta y no se puede quitar: es lo único que
                                   distingue una captura de un documento antes de abrirlo. Se pasa a
                                   glifos de la fuente para que se atenúen junto con la fila cuando la
                                   rejilla la apaga, cosa que el emoji no hacía. «image» es el mismo
                                   que usa PegarImagen.razor para esta misma idea. *@
                                <Template Context="ev">
                                    @if (ev.EsImagen) { <RadzenIcon Icon="image" /> } else { <RadzenIcon Icon="description" /> }
