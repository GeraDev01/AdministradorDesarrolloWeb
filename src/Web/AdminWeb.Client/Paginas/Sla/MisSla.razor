@page "/mis-sla"
@attribute [Authorize(Policy = "AdminUDesarrollador")]
@using AdminWeb.Shared.Dtos.Sla
@implements IDisposable
@inject ClienteApi Api
@inject AvisosDeInterfaz Avisos

@*
    Mis SLA (clave del escritorio: «my-sla»).

    Qué tengo comprometido, para cuándo, y cuánto falta.

    LOS DOS BOTONES NO SON LO MISMO, y esa es la regla que la pantalla tiene que dejar clara:

      · «Registrar avance» publica un comentario en el work item de Azure DevOps y SOLO si DevOps lo
        acepta cuenta como constancia y se reprograma el recordatorio. Es el botón del escritorio, y
        su valor está justo ahí: si el comentario no quedó en el ticket, el compromiso sigue
        reclamando. Se firma con el token propio, así que en DevOps queda a nombre de quien lo hizo.
      · «Posponer» solo aplaza el aviso, con los mismos límites de siempre: entre 1 y 72 horas y
        nunca más allá del vencimiento. Sirve para decir «estoy en ello», no para dar por atendido.

    LO QUE CAMBIA RESPECTO AL ESCRITORIO

      · El recordatorio ya no depende de tener la aplicación abierta. Antes, quien cerraba el
        programa no se enteraba de nada; ahora el servidor deja el aviso en «Avisos» y ahí sigue
        cuando se entre, aunque el compromiso se haya vencido un domingo.
      · El comentario se captura en un panel dentro de la propia pantalla y no en una ventana modal
        aparte, como el resto de la aplicación.

    Las horas viajan en UTC y se pintan en la hora de quien mira. Ningún texto que venga de un ticket
    se pinta como marcado.
*@

<PageTitle>Mis SLA</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.H5" class="rz-mb-0">Mis SLA</RadzenText>
        <RadzenButton Text="Recargar" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small" Click="@Cargar" Disabled="@_ocupado" />
    </RadzenStack>

    @if (_datos is { } d)
    {
        @if (!d.TieneFicha)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false">
                @d.Mensaje
            </RadzenAlert>
        }
        else
        {
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             Gap="1rem" Wrap="FlexWrap.Wrap">
                    @* El tipo del parámetro va explícito: Change es EventCallback<bool> y con un
                       lambda sin tipar el compilador lo toma como EventCallback a secas. *@
                    <RadzenCheckBox data-recorrido="mis-sla-cerrados"
                                    TValue="bool" Name="cerrados" Value="@_verCerrados"
                                    Change="@((bool ver) => VerCerrados(ver))" />
                    <RadzenLabel Text="Ver también los cerrados" Component="cerrados" />

                    @* El triángulo va como glifo de la fuente y no como el carácter ⚠: éste lo dibuja
                       el sistema operativo, se ve distinto en cada equipo y no hereda el color, así
                       que el aviso rojo salía de su propio color en la mitad de las máquinas. *@
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0"
                                Style="@($"margin-left:auto;font-weight:600;color:{(d.Urgentes > 0 ? "var(--rz-danger)" : "var(--rz-text-secondary-color)")}")">
                        @if (d.Urgentes > 0)
                        {
                            <RadzenIcon Icon="warning" />
                        }
                        @d.Mensaje
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>

            @if (Registrando is { } avance)
            {
                <RadzenCard>
                    <RadzenStack Gap="0.75rem">
                        @* «forum» es el glifo que AzureDevOps.razor usa ya para el botón de comentarios
                           de un ticket, y esta tarjeta hace exactamente eso: publicar un comentario en
                           el ticket. Va como <RadzenIcon> porque el contenedor es un RadzenText, que
                           no tiene parámetro Icon. *@
                        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                            <RadzenIcon Icon="forum" /> Registrar avance en el ticket #@avance.TicketExternalId
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                            @avance.Objetivo — se publica con TU token, así que en DevOps queda a tu
                            nombre. El avance solo cuenta si el comentario llega al ticket.
                        </RadzenText>

                        <RadzenTextArea @bind-Value="_comentario" Rows="4" Style="width:100%"
                                        Placeholder="Qué se avanzó, qué falta y para cuándo…" />
                        <PegarImagen @bind-Imagenes="_evidencias" Maximo="5" />

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenButton Text="Publicar en DevOps" Disabled="@_ocupado"
                                          Click="@RegistrarAvance" />
                            <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light"
                                          Disabled="@_ocupado" Click="@(() => _registrandoId = null)" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            }

            <RadzenDataGrid data-recorrido="mis-sla-rejilla"
                            TItem="SlaCompromisoDto" Data="@d.Compromisos" IsLoading="@_ocupado"
                            AllowSorting="true" AllowPaging="true" PageSize="20"
                            RowRender="@PintarUrgentes"
                            EmptyText="No tienes compromisos pendientes.">
                <Columns>
                    <RadzenDataGridColumn TItem="SlaCompromisoDto" Property="Id" Title="ID" Width="70px" />
                    <RadzenDataGridColumn TItem="SlaCompromisoDto" Property="Objetivo" Title="Objetivo" />
                    <RadzenDataGridColumn TItem="SlaCompromisoDto" Property="TicketExternalId"
                                          Title="Ticket" Width="110px">
                        <Template Context="s">
                            @if (s.TicketExternalId is int t)
                            {
                                @if (!string.IsNullOrWhiteSpace(s.TicketUrl))
                                {
                                    @* target/rel explícitos: el enlace lo capturó el líder y abre un
                                       sitio externo; sin noopener la pestaña nueva puede manipular esta. *@
                                    <a href="@s.TicketUrl" target="_blank" rel="noopener">
                                        #@t <RadzenIcon Icon="open_in_new" />
                                    </a>
                                }
                                else
                                {
                                    <span>#@t</span>
                                }
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SlaCompromisoDto" Property="VenceUtc" Title="Vence" Width="150px">
                        <Template Context="s">@s.VenceUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SlaCompromisoDto" Property="VenceUtc" Title="Falta" Width="110px">
                        <Template Context="s">
                            @(s.Estado == SlaStatus.Activo ? Restante(s.VenceUtc) : "—")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SlaCompromisoDto" Property="Estado" Title="Estado" Width="150px">
                        @* El punto de color, con el marcado de Componentes/BotonDeEstado.razor copiado
                           tal cual —mismas medidas, mismo hueco y mismo borde—, para que esta rejilla
                           se lea igual que las demás de la aplicación.

                           Si hay una lista donde el color hace falta es ésta: se entra a saber qué
                           está fuera de plazo y qué está a punto, no a leer cinco palabras parecidas.

                           El texto vuelve a TINTA NORMAL. Antes iba en negrita coloreada, y con el
                           punto delante eso sería decir el mismo dato dos veces y dejar dos sitios
                           donde puede discrepar. Tampoco choca con el tinte de la FILA que pone
                           PintarUrgentes: la fila dice «esta reclama algo» y el punto dice qué es
                           exactamente; y el punto lleva su color en background, así que sobrevive al
                           fondo de la fila mejor de lo que sobrevivía el color del texto.

                           El BORDE gris no es decoración: si un día falta la variable, el punto se
                           queda sin relleno pero SE SIGUE VIENDO, en vez de desaparecer sin que nadie
                           note que algo se rompió. Y la palabra va SIEMPRE al lado.

                           El color sale del ENUM que el DTO ya trae (más los dos booleanos que el
                           SERVIDOR ya resolvió), nunca de comparar la etiqueta. Y la palabra y el
                           color salen del MISMO sitio, EtiquetasDeSla en Shared, que es la corrección
                           de fondo de este cambio: hasta ahora esta pantalla y «SLA y recordatorios»
                           tenían cada una su copia y YA HABÍAN DIVERGIDO —el mismo compromiso fuera de
                           plazo salía rojo aquí y ámbar allá, y allá ni siquiera existía la palabra
                           «Toca comentar»—. Con una sola tabla, el punto y la palabra no pueden
                           contradecirse. No vuelvas a bajarla a la pantalla. *@
                        <Template Context="s">
                            <span style="white-space:nowrap;display:inline-flex;align-items:center;gap:.4rem">
                                <span style="width:.55rem;height:.55rem;flex:none;border-radius:50%;border:1px solid var(--rz-border-color);background:@EtiquetasDeSla.ColorDeSla(s)"></span>
                                @EtiquetasDeSla.EtiquetaDeSla(s)
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SlaCompromisoDto" Property="Comentarios"
                                          Title="Comentarios" Width="140px">
                        <Template Context="s">
                            @(s.Comentarios == 0
                                ? "ninguno"
                                : $"{s.Comentarios} · {s.UltimoComentarioUtc?.ToLocalTime():dd/MM HH:mm}")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SlaCompromisoDto" Property="Notas" Title="Notas" Width="200px">
                        <Template Context="s">@(string.IsNullOrWhiteSpace(s.Notas) ? "—" : s.Notas)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SlaCompromisoDto" Title="" Width="230px" Sortable="false">
                        <Template Context="s">
                            @if (s.Estado == SlaStatus.Activo)
                            {
                                @* Sin ticket ligado no hay dónde dejar constancia: el botón no se
                                   ofrece en vez de ofrecerlo y rechazarlo al pulsarlo. *@
                                @if (s.TicketExternalId is not null)
                                {
                                    @* «add» porque este botón NO publica nada: abre el formulario en
                                       blanco donde se escribe el avance. El que publica de verdad
                                       está dentro del panel. *@
                                    <RadzenButton data-recorrido="mis-sla-avance"
                                                  Text="Registrar avance" Icon="add"
                                                  Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                  title="Comenta el ticket en Azure DevOps. Solo si el comentario queda allá cuenta como avance."
                                                  Click="@(() => AbrirAvance(s))" />
                                }
                                @* «alarm»: posponer es mover el despertador, y es el mismo glifo con
                                   el que la aplicación dice «programar para más tarde» en cualquier
                                   otro sitio. No es un cronómetro (ése es el SLA en sí) ni un reloj
                                   de pared (ése es el marcaje de jornada). *@
                                <RadzenButton data-recorrido="mis-sla-posponer"
                                              Text="Posponer" Icon="alarm" ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                              title="Aplaza el recordatorio 4 horas. No mueve la fecha límite."
                                              Click="@(() => Posponer(s))" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenStack>

@code {
    /// <summary>
    /// Cuánto aplaza el botón. Cuatro horas, como en el escritorio: lo bastante para terminar lo que
    /// se está haciendo y lo bastante poco para que el compromiso no se olvide.
    /// </summary>
    private const int HorasDePosposicion = 4;

    private readonly CancellationTokenSource _cancelacion = new();

    private MisSlaDto? _datos;
    private bool _ocupado;

    /// <summary>La casilla del escritorio, con el mismo valor por omisión: solo lo vigente.</summary>
    private bool _verCerrados;

    // Registro de avance.
    private int? _registrandoId;
    private string _comentario = "";
    private List<ImagenAdjunta> _evidencias = [];

    /// <summary>
    /// El compromiso cuyo avance se está escribiendo, resuelto contra la última carga: cada recarga
    /// trae objetos nuevos, y guardar la referencia dejaría el panel titulado con datos viejos.
    /// </summary>
    private SlaCompromisoDto? Registrando =>
        _registrandoId is int id ? _datos?.Compromisos.FirstOrDefault(s => s.Id == id) : null;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        _ocupado = true;
        try
        {
            _datos = await Api.LeerAsync<MisSlaDto>(
                $"api/sla/mios?incluirCerrados={_verCerrados.ToString().ToLowerInvariant()}", _cancelacion.Token);

            // El compromiso que se estaba comentando pudo cerrarse solo —su ticket se cerró en
            // DevOps— o salir del filtro: dejar el panel abierto sobre algo que ya no está en la
            // lista publicaría contra un compromiso que nadie ve.
            if (Registrando is null) _registrandoId = null;
        }
        finally { _ocupado = false; }
    }

    private async Task VerCerrados(bool ver)
    {
        _verCerrados = ver;
        await Cargar();
    }

    // ── Registrar avance ─────────────────────────────────────────────────────

    private void AbrirAvance(SlaCompromisoDto s)
    {
        _registrandoId = s.Id;
        _comentario = "";
        _evidencias = [];
    }

    /// <summary>
    /// Publica el comentario en el ticket. Solo si DevOps lo acepta cuenta el avance, y de eso se
    /// encarga el servidor: aquí no se toca nada del compromiso ni se cierra el panel a la ligera.
    /// </summary>
    private async Task RegistrarAvance()
    {
        if (Registrando is not { } s) return;

        // Lo evidente se atrapa aquí para no gastar un viaje; el resto —tamaños, tipos, de quién es
        // el ticket— lo decide el servidor, que es donde la regla tiene que vivir.
        if (string.IsNullOrWhiteSpace(_comentario) && _evidencias.Count == 0)
        {
            Avisos.Aviso("Escribe qué avanzaste o adjunta una evidencia antes de publicar.");
            return;
        }

        // Multipart aunque no lleve capturas: es una sola forma de mandar la operación, y ClienteApi
        // le pone el testigo antifalsificación sin que esta pantalla tenga que acordarse.
        var formulario = new MultipartFormDataContent
        {
            { new StringContent(_comentario ?? ""), "texto" }
        };
        foreach (var imagen in _evidencias)
            formulario.Add(new ByteArrayContent(imagen.Contenido), "imagenes", imagen.Nombre);

        _ocupado = true;
        try
        {
            var (ok, resultado) = await Api.SubirAsync<ResultadoDto>(
                $"api/sla/{s.Id}/avance", formulario, _cancelacion.Token);

            // Si no quedó en el ticket, el panel se queda abierto con lo escrito: el motivo ya se
            // enseñó y volver a teclearlo todo sería castigar a quien no falló.
            if (!ok || resultado is null) return;

            Avisos.Exito(resultado.Mensaje);
            _registrandoId = null;
        }
        finally { _ocupado = false; }

        await Cargar();
    }

    private async Task Posponer(SlaCompromisoDto s)
    {
        _ocupado = true;
        try
        {
            var (ok, resultado) = await Api.EnviarAsync<PosponerSlaRequest, ResultadoDto>(
                $"api/sla/{s.Id}/posponer", new PosponerSlaRequest(HorasDePosposicion), _cancelacion.Token);
            if (!ok) return;

            // El mensaje del servicio se enseña tal cual: dice cuánto se pospuso de verdad, que no
            // siempre son las horas pedidas —nunca pasa del vencimiento—.
            if (resultado is { } r) Avisos.Resultado(r.Ok, r.Mensaje);
        }
        finally { _ocupado = false; }

        await Cargar();
    }

    /// <summary>
    /// Cuánto falta, en la unidad que se entiende de un vistazo. Se calcula en el navegador contra su
    /// propio reloj: es un dato que cambia cada minuto y pedirlo al servidor lo dejaría envejecido en
    /// pantalla.
    /// </summary>
    private static string Restante(DateTime venceUtc)
    {
        var falta = venceUtc.ToLocalTime() - DateTime.Now;
        if (falta.TotalSeconds <= 0) return "vencido";
        if (falta.TotalDays >= 1) return $"{(int)falta.TotalDays}d {falta.Hours}h";
        return falta.TotalHours >= 1 ? $"{(int)falta.TotalHours}h {falta.Minutes}m" : $"{falta.Minutes}m";
    }

    /// <summary>
    /// El fondo de la fila que reclama. Las variantes «-lighter» del tema están declaradas en rgba,
    /// así que el tinte se posa sobre el fondo que haya —blanco o grafito— en vez de taparlo. Un
    /// color claro opaco escrito a mano se veía bien en claro y dejaba la fila ilegible en oscuro.
    /// </summary>
    private void PintarUrgentes(RowRenderEventArgs<SlaCompromisoDto> fila)
    {
        if (fila.Data.FueraDePlazo || fila.Data.Estado == SlaStatus.Vencido)
            fila.Attributes["style"] = "background-color: var(--rz-danger-lighter)";
        else if (fila.Data.TocaComentar)
            fila.Attributes["style"] = "background-color: var(--rz-warning-lighter)";
    }

    // Aquí vivían Etiqueta(s) y Color(s), copiadas también en SlaYRecordatorios.razor. Las dos se
    // fueron a EtiquetasDeSla, en Shared, y no se reponen: la palabra y el color del mismo estado
    // tienen que salir del MISMO switch. Mientras estuvieron duplicadas ya se habían separado —«fuera
    // de plazo» era rojo aquí y ámbar en la pantalla del líder, que además no conocía «Toca
    // comentar»—, y ahora que el color pinta un punto una discrepancia así se ve todavía antes.

    public void Dispose()
    {
        _cancelacion.Cancel();
        _cancelacion.Dispose();
    }
}
