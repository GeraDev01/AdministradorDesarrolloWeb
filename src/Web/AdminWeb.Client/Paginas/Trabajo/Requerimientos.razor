@page "/requerimientos"
@attribute [Authorize(Policy = "SoloAdmin")]
@using AdminWeb.Shared.Dtos.DevOps
@using AdminWeb.Shared.Dtos.Trabajo
@implements IDisposable
@inject ClienteApi Api
@inject AvisosDeInterfaz Avisos
@inject Descargas Descargas

@*
    Los requerimientos, del lado del líder: darlos de alta, corregirlos, decidir quién los trabaja y
    cancelarlos.

    Decisiones del escritorio que se conservan:

      · «Eliminar» NO borra: pasa el requerimiento a CANCELADO y ahí se queda, a la vista. Aquí el
        botón se llama «Cancelar» porque es lo que de verdad hace, y la confirmación lo dice con
        todas sus letras. Borrarlo se llevaría por delante su tiempo cronometrado, sus asignaciones y
        su historia en el sprint donde estuvo comprometido.
      · Lo VENCIDO se pinta en rojo en toda la fila: compromiso pasado y sin entregar. Es lo que uno
        viene a ver a esta pantalla, y quien decide si lo está es el SERVIDOR con su fecha.
      · Al asignar, se avisa solo a quien no estaba antes. La pantalla no tiene que saberlo: manda la
        lista completa y el servicio hace la resta.

    Lo que cambia respecto al escritorio:

      · El alta, la edición y la asignación se hacen en un panel dentro de la misma pantalla en vez
        de en ventanas modales aparte. En el navegador una ventana modal encima de otra pantalla se
        pierde detrás del propio navegador con demasiada facilidad.
      · Las fechas que en el escritorio se anulaban con una casilla «N/A» se vacían aquí con el botón
        de limpiar del propio calendario: es el gesto que ya trae el control, y una casilla al lado
        sería un segundo sitio donde decir lo mismo.
      · El avance se captura como número y no con una barra deslizante. La barra del escritorio ya
        iba de cinco en cinco porque arrastrar es impreciso; en un formulario que se guarda con un
        botón, el número es exacto y además se puede teclear.
      · Los DOCUMENTOS del requerimiento siguen siendo dos cosas distintas —el de requerimiento y el
        de estimación—, cada uno con su botón, como en RequirementAttachmentsForm. Suben desde un
        selector de archivos porque casi siempre son un PDF o un .docx, no una imagen.

    Lo que cambia en los documentos: el escritorio los abría volcándolos a una carpeta temporal que
    nunca se borraba y lanzando el programa asociado. Aquí se piden a /api/adjuntos/requerimiento/{id}
    y el navegador previsualiza lo que sabe o descarga el resto, sin dejar rastro. Los bytes NO
    viajan en la lista: de cada documento solo llegan su nombre, su tipo y su tamaño.

    «Importar de DevOps» da de alta como requerimientos los work items asignados y abiertos y los
    reparte según las reglas de auto-asignación. El mismo botón está en el tablero de Azure DevOps,
    que es de donde salen; aquí porque es donde se ve el resultado y donde se corrige lo que traiga.

    Lo que NO está y no es un olvido: la exportación a Excel, que cuelga de un servicio todavía sin
    portar; el enlace al ticket sí está, porque para eso basta con la URL que el propio requerimiento
    ya trae.
*@

<PageTitle>Requerimientos</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.H5" class="rz-mb-0">Requerimientos</RadzenText>
        <RadzenButton Text="Recargar" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small" Click="@Cargar" Disabled="@_ocupado" />
    </RadzenStack>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                     Gap="1rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_buscar" Placeholder="Buscar por título o descripción…"
                           Change="@(_ => Cargar())" Style="min-width:18rem" />

            <RadzenLabel Text="Estado:" Component="estado" />
            <RadzenDropDown TValue="RequirementStatus?" @bind-Value="_estado" Name="estado"
                            Data="@Estados" TextProperty="Texto" ValueProperty="Valor"
                            AllowClear="true" Placeholder="Todos" Disabled="@_ocupado"
                            Change="@(_ => Cargar())" Style="min-width:11rem" />

            <RadzenLabel Text="Dev:" Component="dev" />
            <RadzenDropDown TValue="int?" @bind-Value="_desarrolladorId" Name="dev"
                            Data="@Desarrolladores" TextProperty="Texto" ValueProperty="Id"
                            AllowClear="true" Placeholder="Todos los devs" Disabled="@_ocupado"
                            Change="@(_ => Cargar())" Style="min-width:12rem" />

            <RadzenButton Text="Nuevo" Icon="add" Disabled="@_ocupado" Click="@AbrirFormularioNuevo" />

            @* «sync» y no «download»: de aquí no sale ningún archivo. Trae trabajo del otro sistema,
               escribe requerimientos y reparte asignaciones, que es justo lo que el glifo de las dos
               flechas anuncia y el de recargar escondería. *@
            <RadzenButton Text="Importar de DevOps" Icon="sync" ButtonStyle="ButtonStyle.Light"
                          Disabled="@_ocupado" Click="@ImportarDeDevOps"
                          title="Da de alta los work items asignados y abiertos, repartidos según las reglas." />

            <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0" Style="margin-left:auto">
                @Resumen()
            </RadzenText>
        </RadzenStack>
    </RadzenCard>

    @if (_capturando)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                    @(_editandoId is null ? "Nuevo requerimiento" : $"Editar requerimiento #{_editandoId}")
                </RadzenText>

                <RadzenTextBox @bind-Value="_titulo" MaxLength="200" Style="width:100%"
                               Placeholder="Título (obligatorio)" />
                <RadzenTextArea @bind-Value="_detalle" Rows="4" Style="width:100%"
                                Placeholder="Descripción (opcional)" />

                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap"
                             AlignItems="AlignItems.Center">
                    <RadzenLabel Text="Estado:" Component="estadoNuevo" />
                    <RadzenDropDown TValue="RequirementStatus?" @bind-Value="_estadoCapturado" Name="estadoNuevo"
                                    Data="@Estados" TextProperty="Texto" ValueProperty="Valor"
                                    Style="min-width:11rem" />

                    <RadzenLabel Text="Prioridad:" Component="prioridadNueva" />
                    <RadzenDropDown TValue="RequirementPriority?" @bind-Value="_prioridad" Name="prioridadNueva"
                                    Data="@Prioridades" TextProperty="Texto" ValueProperty="Valor"
                                    Style="min-width:11rem" />

                    <RadzenLabel Text="Estimación (hrs):" Component="horas" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_horas" Name="horas" Min="0" Max="1000"
                                   Style="width:8rem" Placeholder="—" />

                    <RadzenLabel Text="Avance (%):" Component="avance" />
                    <RadzenNumeric TValue="int" @bind-Value="_avance" Name="avance" Min="0" Max="100"
                                   Style="width:8rem" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap"
                             AlignItems="AlignItems.Center">
                    <RadzenLabel Text="Solicitud:" Component="fSolicitud" />
                    <RadzenDatePicker TValue="DateTime?" @bind-Value="_fechaSolicitud" Name="fSolicitud"
                                      DateFormat="dd/MM/yyyy" ShowTime="false" AllowClear="true"
                                      Placeholder="—" Style="width:11rem" />

                    <RadzenLabel Text="Compromiso:" Component="fCompromiso" />
                    <RadzenDatePicker TValue="DateTime?" @bind-Value="_fechaCompromiso" Name="fCompromiso"
                                      DateFormat="dd/MM/yyyy" ShowTime="false" AllowClear="true"
                                      Placeholder="—" Style="width:11rem" />

                    <RadzenLabel Text="Entrega real:" Component="fEntrega" />
                    <RadzenDatePicker TValue="DateTime?" @bind-Value="_fechaEntrega" Name="fEntrega"
                                      DateFormat="dd/MM/yyyy" ShowTime="false" AllowClear="true"
                                      Placeholder="—" Style="width:11rem" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="@(_editandoId is null ? "Crear" : "Guardar")"
                                  Disabled="@_ocupado" Click="@GuardarRequerimiento" />
                    <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light"
                                  Disabled="@_ocupado" Click="@(() => _capturando = false)" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }

    @if (Asignando is { } asignando)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                @* «groups» —varias siluetas, el glifo que el menú le dio a Equipos— y no «person»:
                   aquí se eligen VARIAS personas de una lista, no una. Va como <RadzenIcon> dentro
                   del texto porque RadzenText no tiene parámetro Icon. *@
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                    <RadzenIcon Icon="groups" /> Quién trabaja «@asignando.Titulo»
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                    Lo marcado es lo que queda. A quien se marque por primera vez se le avisa; a quien
                    ya lo tenía, no.
                </RadzenText>

                <RadzenStack Gap="0.35rem">
                    @foreach (var dev in Desarrolladores)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                            @* El tipo del parámetro va explícito: Change es EventCallback<bool> y con un
                               lambda sin tipar el compilador lo toma como EventCallback a secas. *@
                            <RadzenCheckBox TValue="bool" Name="@($"dev_{dev.Id}")"
                                            Value="@_asignados.Contains(dev.Id)"
                                            Change="@((bool marcado) => Marcar(dev.Id, marcado))" />
                            <RadzenLabel Text="@dev.Texto" Component="@($"dev_{dev.Id}")" />
                        </RadzenStack>
                    }
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="Guardar asignación" Disabled="@_ocupado" Click="@GuardarAsignacion" />
                    <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light"
                                  Disabled="@_ocupado" Click="@(() => _asignandoId = null)" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }

    @if (Adjuntando is { } adjuntando)
    {
        <RadzenCard Style="border-left:5px solid var(--rz-info)">
            <RadzenStack Gap="0.75rem">
                @* «attach_file» es el clip de la fuente y ya es el de este mismo encabezado en
                   MisPermisos, MisVacaciones, Plantillas y MisActividades. Una pantalla de adjuntos
                   con un clip distinto al de las otras cuatro se lee como si hiciera otra cosa. *@
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                    <RadzenIcon Icon="attach_file" /> Documentos de «@adjuntando.Titulo»
                </RadzenText>

                @* Dos botones y no un desplegable de tipo: es como el escritorio los ofrecía, y así
                   el gesto de subir dice ya qué documento es en vez de exigir una segunda elección
                   que se olvida. *@
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Wrap="FlexWrap.Wrap"
                             AlignItems="AlignItems.Center">
                    @* RadzenLabel NO tiene parámetro Icon —solo Text, Component y ChildContent—, así
                       que el clip no puede ir por atributo: va dentro, como ChildContent, que según
                       la documentación de Radzen ANULA el parámetro Text. OJO si alguien vuelve por
                       aquí: dejar el Text puesto además del contenido no da error, simplemente se
                       ignora en silencio y queda código muerto que confunde al siguiente. *@
                    <RadzenStack Gap="0.25rem">
                        <RadzenLabel><RadzenIcon Icon="attach_file" /> Adjuntar requerimiento</RadzenLabel>
                        <InputFile OnChange="@(e => Adjuntar(e, adjuntando.Id, RequirementAttachmentKind.Requerimiento))"
                                   disabled="@_ocupado" />
                    </RadzenStack>
                    <RadzenStack Gap="0.25rem">
                        <RadzenLabel><RadzenIcon Icon="attach_file" /> Adjuntar estimación</RadzenLabel>
                        <InputFile OnChange="@(e => Adjuntar(e, adjuntando.Id, RequirementAttachmentKind.Estimacion))"
                                   disabled="@_ocupado" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                        Hasta @MegasDeAdjunto MB por archivo.
                    </RadzenText>
                </RadzenStack>

                <RadzenDataGrid TItem="AdjuntoDeRequerimientoDto" Data="@_adjuntos" IsLoading="@_ocupado"
                                AllowSorting="false"
                                EmptyText="Este requerimiento todavía no tiene documentos.">
                    <Columns>
                        <RadzenDataGridColumn TItem="AdjuntoDeRequerimientoDto" Title="Tipo" Width="150px">
                            @* El color separa de un vistazo el requerimiento de la estimación, igual
                               que en la rejilla del escritorio. *@
                            <Template Context="a">
                                <b style="@($"color:{ColorDeTipo(a.Tipo)}")">@a.TipoTexto</b>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AdjuntoDeRequerimientoDto" Property="Nombre" Title="Archivo" />
                        <RadzenDataGridColumn TItem="AdjuntoDeRequerimientoDto" Title="Tamaño" Width="110px"
                                              TextAlign="TextAlign.Right">
                            <Template Context="a">@(Math.Max(1, a.Bytes / 1024)) KB</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AdjuntoDeRequerimientoDto" Title="Subido" Width="150px">
                            <Template Context="a">@a.SubidoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AdjuntoDeRequerimientoDto" Title="" Width="180px">
                            <Template Context="a">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                                    @* «download» aunque el botón diga Abrir: lo que pasa al pulsarlo es
                                       que sale un archivo, y el navegador decide si lo previsualiza o
                                       lo baja. Un icono de hoja describiría el formato, no la acción. *@
                                    <RadzenButton Text="Abrir" Icon="download" ButtonStyle="ButtonStyle.Light"
                                                  Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                  Click="@(() => AbrirAdjunto(a))" />
                                    <RadzenButton Text="Eliminar" Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                                  Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                  Click="@(() => EliminarAdjunto(a))" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>

                <div>
                    <RadzenButton Text="Cerrar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Disabled="@_ocupado" Click="@(() => _adjuntandoId = null)" />
                </div>
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenDataGrid TItem="RequerimientoDto" Data="@Filas" IsLoading="@_ocupado"
                    AllowSorting="true" AllowPaging="true" PageSize="20"
                    RowRender="@PintarVencidos"
                    EmptyText="No hay requerimientos que cumplan el filtro.">
        <Columns>
            <RadzenDataGridColumn TItem="RequerimientoDto" Property="Id" Title="ID" Width="70px" />
            <RadzenDataGridColumn TItem="RequerimientoDto" Property="Titulo" Title="Título" />
            <RadzenDataGridColumn TItem="RequerimientoDto" Property="EstadoTexto" Title="Estado" Width="130px">
                <Template Context="r">
                    <b style="@($"color:{EtiquetasDeTrabajo.ColorDeEstado(r.Estado)}")">@r.EstadoTexto</b>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RequerimientoDto" Property="PrioridadTexto" Title="Prioridad" Width="110px">
                @* El punto de color sustituye al círculo de emoji que traía la etiqueta (🔵🟡🟠🔴).
                   Aquí el color NO era adorno: en una rejilla de veinte filas la urgencia se veía sin
                   leer una sola palabra, y con el emoji fuera esta columna se quedaba en cuatro
                   palabras que pesan lo mismo. Es el mismo recurso —y el mismo marcado— de
                   BotonDeEstado: lo pinta una variable del tema, así que obedece al modo claro y al
                   oscuro, mientras que el emoji lo dibujaba el sistema operativo y en oscuro seguía
                   brillando con sus colores de siempre.

                   El BORDE gris no es decoración: si un día falta la variable, el punto se queda sin
                   relleno pero SE SIGUE VIENDO, en vez de desaparecer sin que nadie note que algo se
                   rompió. Y la palabra va SIEMPRE al lado, que es lo que salva a quien no separa el
                   rojo del verde y a cualquiera que imprima la tabla.

                   El color sale del ENUM (r.Prioridad, que el DTO ya trae junto al texto) y no de
                   comparar la cadena: comparar el texto es lo que se rompe en cuanto alguien cambia
                   una etiqueta, sin error y sin que se note.

                   El DESPLEGABLE del filtro (más abajo, `Prioridades`) se queda solo con la palabra y
                   no es un olvido: su TextProperty apunta a OpcionDePrioridad.Texto, que es una CADENA
                   y no admite marcado. Es el mismo compromiso que ya aceptó BotonDeEstado en su
                   ChildContent. Cuatro palabras en una lista abierta a propósito no necesitan color;
                   el punto hace falta en la rejilla, que es lo que se mira todo el día. *@
                <Template Context="r">
                    <span style="white-space:nowrap;display:inline-flex;align-items:center;gap:.4rem">
                        <span style="width:.55rem;height:.55rem;flex:none;border-radius:50%;border:1px solid var(--rz-border-color);background:@EtiquetasDeTrabajo.ColorDePrioridad(r.Prioridad)"></span>
                        @r.PrioridadTexto
                    </span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RequerimientoDto" Property="DesarrolladoresTexto"
                                  Title="Desarrolladores" Width="200px">
                <Template Context="r">@(string.IsNullOrEmpty(r.DesarrolladoresTexto) ? "—" : r.DesarrolladoresTexto)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RequerimientoDto" Property="HorasEstimadas" Title="Hrs"
                                  Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.HorasEstimadas?.ToString("0.#") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RequerimientoDto" Property="FechaCompromiso"
                                  Title="F. Compromiso" Width="130px">
                <Template Context="r">@(r.FechaCompromiso?.ToString("dd/MM/yyyy") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RequerimientoDto" Property="AvancePct" Title="Avance"
                                  Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.AvancePct)%</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RequerimientoDto" Property="OrigenTexto" Title="Origen" Width="100px">
                @* El origen DevOps se marca con color Y con peso. Solo con color no valdría: en
                   oscuro se acerca demasiado al texto normal, y quien no distingue ese tono se
                   quedaría sin saber cuáles vinieron de fuera. *@
                <Template Context="r">
                    <span style="@(r.EsDeDevOps ? "color:var(--rz-info);font-weight:600" : "")">@r.OrigenTexto</span>
                </Template>
            </RadzenDataGridColumn>
            @* Solo el NÚMERO, que es el indicador que llevaba la rejilla del escritorio: los nombres y
               los bytes se piden al abrir el panel, no en cada carga de la tabla. *@
            <RadzenDataGridColumn TItem="RequerimientoDto" Property="Adjuntos" Title="Docs" Width="80px"
                                  TextAlign="TextAlign.Right">
                @* Solo el número: la columna ya se llama «Docs» y va alineada a la derecha como
                   numérica. El clip delante de cada cifra era repetir la cabecera renglón a renglón
                   y además rompía la alineación de los números, que es justo para lo que se puso el
                   TextAlign.Right. *@
                <Template Context="r">@(r.Adjuntos == 0 ? "—" : r.Adjuntos.ToString())</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RequerimientoDto" Title="" Width="320px" Sortable="false">
                <Template Context="r">
                    <RadzenButton Text="Editar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                  Disabled="@_ocupado" Click="@(() => AbrirFormularioDe(r))" />
                    <RadzenButton Text="Asignar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                  Disabled="@_ocupado" Click="@(() => AbrirAsignacion(r))" />
                    <RadzenButton Text="Documentos" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                  Disabled="@_ocupado" Click="@(() => AbrirAdjuntos(r))" />
                    @if (r.Estado != RequirementStatus.Cancelado)
                    {
                        <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                      Disabled="@_ocupado" Click="@(() => CancelarRequerimiento(r))" />
                    }
                    @if (!string.IsNullOrWhiteSpace(r.Enlace))
                    {
                        @* «open_in_new»: lo que hay que avisar es que se sale de la aplicación. Va
                           como glifo de la fuente para que herede el rojo de las filas vencidas en
                           vez de quedarse del color que le ponga el sistema operativo. *@
                        <a href="@r.Enlace" target="_blank" rel="noopener" title="Abrir el ticket">
                            <RadzenIcon Icon="open_in_new" />
                        </a>
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>

@code {
    private readonly CancellationTokenSource _cancelacion = new();

    private RequerimientosDto? _datos;
    private bool _ocupado;

    // Filtros.
    private string _buscar = "";
    private RequirementStatus? _estado;
    private int? _desarrolladorId;

    // Alta y edición.
    private bool _capturando;
    private int? _editandoId;
    private string _titulo = "";
    private string _detalle = "";
    // Nulables aunque el formulario siempre tenga una elección: es el tipo que pide el desplegable
    // cuando sus opciones son las mismas que las del filtro, que sí ofrece «todos».
    private RequirementStatus? _estadoCapturado = RequirementStatus.PorEstimar;
    private RequirementPriority? _prioridad = RequirementPriority.Media;
    private decimal? _horas;
    private DateTime? _fechaSolicitud;
    private DateTime? _fechaCompromiso;
    private DateTime? _fechaEntrega;
    private int _avance;

    /// <summary>El sello con el que se leyó la ficha; vuelve al servidor para detectar el choque.</summary>
    private string? _sello;

    // Asignación.
    private int? _asignandoId;
    private readonly HashSet<int> _asignados = [];

    // Documentos adjuntos. La lista se pide aparte al abrir el panel: en la tabla solo viaja el
    // número, y los bytes ni siquiera entonces.
    private int? _adjuntandoId;
    private IReadOnlyList<AdjuntoDeRequerimientoDto> _adjuntos = [];

    private IReadOnlyList<RequerimientoDto> Filas => _datos?.Filas ?? [];
    private IReadOnlyList<OpcionDto> Desarrolladores => _datos?.Desarrolladores ?? [];

    private long MegasDeAdjunto => (_datos?.MaxAdjuntoBytes ?? 0) / (1024 * 1024);

    /// <summary>
    /// El requerimiento cuya asignación se está editando, resuelto contra la última carga: cada
    /// recarga trae objetos nuevos, y guardar la referencia dejaría el panel enseñando datos viejos.
    /// </summary>
    private RequerimientoDto? Asignando =>
        _asignandoId is int id ? Filas.FirstOrDefault(r => r.Id == id) : null;

    /// <summary>El requerimiento cuyos documentos se están viendo, resuelto igual que el anterior.</summary>
    private RequerimientoDto? Adjuntando =>
        _adjuntandoId is int id ? Filas.FirstOrDefault(r => r.Id == id) : null;

    private static readonly IReadOnlyList<OpcionDeEstado> Estados =
        Enum.GetValues<RequirementStatus>()
            .Select(e => new OpcionDeEstado(e, EtiquetasDeTrabajo.Estado(e)))
            .ToList();

    private static readonly IReadOnlyList<OpcionDePrioridad> Prioridades =
        Enum.GetValues<RequirementPriority>()
            .Select(p => new OpcionDePrioridad(p, EtiquetasDeTrabajo.Prioridad(p)))
            .ToList();

    /// <summary>
    /// Las opciones de los desplegables. El valor va NULABLE porque el filtro ofrece «todos», y así
    /// la opción tiene exactamente el tipo del campo que rellena.
    /// </summary>
    private record OpcionDeEstado(RequirementStatus? Valor, string Texto);

    private record OpcionDePrioridad(RequirementPriority? Valor, string Texto);

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        _ocupado = true;
        try
        {
            var filtros = new List<string>();
            if (_estado is { } e) filtros.Add($"estado={e}");
            if (_desarrolladorId is { } d) filtros.Add($"desarrolladorId={d}");
            if (!string.IsNullOrWhiteSpace(_buscar)) filtros.Add($"buscar={Uri.EscapeDataString(_buscar.Trim())}");
            var ruta = "api/trabajo/requerimientos" + (filtros.Count > 0 ? "?" + string.Join("&", filtros) : "");

            _datos = await Api.LeerAsync<RequerimientosDto>(ruta, _cancelacion.Token);

            // El requerimiento que se estaba asignando pudo salir del filtro o dejar de existir:
            // mantener el panel abierto sobre algo que ya no está en la lista guardaría sobre datos
            // viejos sin que nadie lo note.
            if (Asignando is null) _asignandoId = null;
            if (Adjuntando is null) { _adjuntandoId = null; _adjuntos = []; }
        }
        finally { _ocupado = false; }
    }

    // ── Alta y edición ───────────────────────────────────────────────────────

    private void AbrirFormularioNuevo()
    {
        _editandoId = null;
        _sello = null;
        _titulo = "";
        _detalle = "";
        _estadoCapturado = RequirementStatus.PorEstimar;
        _prioridad = RequirementPriority.Media;
        _horas = null;
        _fechaSolicitud = DateTime.Today;
        _fechaCompromiso = null;
        _fechaEntrega = null;
        _avance = 0;
        _capturando = true;
    }

    private void AbrirFormularioDe(RequerimientoDto r)
    {
        _editandoId = r.Id;
        _sello = r.Sello;
        _titulo = r.Titulo;
        _detalle = r.Detalle ?? "";
        _estadoCapturado = r.Estado;
        _prioridad = r.Prioridad;
        _horas = r.HorasEstimadas;
        _fechaSolicitud = r.FechaSolicitud;
        _fechaCompromiso = r.FechaCompromiso;
        _fechaEntrega = r.FechaEntrega;
        _avance = r.AvancePct;
        _capturando = true;
    }

    private async Task GuardarRequerimiento()
    {
        // Solo lo evidente se comprueba aquí; el resto —los topes, las fechas incoherentes— lo valida
        // el servicio, que es donde la regla tiene que vivir.
        if (string.IsNullOrWhiteSpace(_titulo))
        {
            Avisos.Aviso("El título es obligatorio.");
            return;
        }

        var cuerpo = new GuardarRequerimientoRequest(
            _titulo, _detalle,
            _estadoCapturado ?? RequirementStatus.PorEstimar,
            _prioridad ?? RequirementPriority.Media,
            _horas, _fechaSolicitud, _fechaCompromiso, _fechaEntrega, _avance, _sello);

        var ruta = _editandoId is int id
            ? $"api/trabajo/requerimientos/{id}/editar"
            : "api/trabajo/requerimientos/nuevo";

        if (await Enviar(ruta, cuerpo)) _capturando = false;
    }

    // ── Asignación ───────────────────────────────────────────────────────────

    private void AbrirAsignacion(RequerimientoDto r)
    {
        _asignandoId = r.Id;
        _asignados.Clear();
        foreach (var id in r.DesarrolladoresIds) _asignados.Add(id);
    }

    private void Marcar(int developerId, bool marcado)
    {
        if (marcado) _asignados.Add(developerId); else _asignados.Remove(developerId);
    }

    private async Task GuardarAsignacion()
    {
        if (_asignandoId is not int id) return;
        if (await Enviar($"api/trabajo/requerimientos/{id}/asignar",
                new AsignarDesarrolladoresRequest(_asignados.ToList())))
            _asignandoId = null;
    }

    // ── Cancelación ──────────────────────────────────────────────────────────

    private async Task CancelarRequerimiento(RequerimientoDto r)
    {
        // La confirmación dice lo que de verdad pasa. En el escritorio el botón decía «Eliminar» y
        // preguntaba «¿Cancelar 'X'?», que ya avisaba de la diferencia; aquí se dice entera para que
        // nadie crea que está borrando algo.
        if (!await Avisos.ConfirmarAsync(
            $"¿Cancelar «{r.Titulo}»?\n\nNo se borra: queda en la lista con estado Cancelado, y deja " +
            "de contar en el avance del sprint.",
            "Cancelar requerimiento", "Sí, cancelarlo"))
            return;

        await Enviar($"api/trabajo/requerimientos/{r.Id}/cancelar", new CancelarRequerimientoRequest(r.Sello));
    }

    // ── Documentos del requerimiento ─────────────────────────────────────────

    private async Task AbrirAdjuntos(RequerimientoDto r)
    {
        _adjuntandoId = r.Id;
        await CargarAdjuntos();
    }

    /// <summary>
    /// La lista de documentos del panel abierto. Se pide aparte y no con la tabla porque solo la
    /// necesita quien abre el panel: mandarla con cada requerimiento sería cargar los nombres de todos
    /// para enseñar los de uno.
    /// </summary>
    private async Task CargarAdjuntos()
    {
        if (_adjuntandoId is not int id) { _adjuntos = []; return; }

        _ocupado = true;
        try
        {
            _adjuntos = await Api.LeerAsync<List<AdjuntoDeRequerimientoDto>>(
                $"api/trabajo/requerimientos/{id}/adjuntos", _cancelacion.Token) ?? [];
        }
        finally { _ocupado = false; }
    }

    private async Task Adjuntar(InputFileChangeEventArgs e, int requerimientoId, RequirementAttachmentKind tipo)
    {
        var archivo = e.File;

        // El tope se comprueba aquí solo para no meter en la memoria del navegador —ni empujar por la
        // red— algo que va a rebotar. La comprobación que cuenta (tamaño, nombre y extensión) la hace
        // el servidor, porque a la API se la puede llamar sin pasar por esta página.
        long maxBytes = _datos?.MaxAdjuntoBytes ?? 0;
        if (archivo.Size > maxBytes)
        {
            Avisos.Aviso($"«{archivo.Name}» pasa de {MegasDeAdjunto} MB.");
            return;
        }

        _ocupado = true;
        try
        {
            byte[] contenido;
            try
            {
                using var origen = archivo.OpenReadStream(maxBytes);
                using var memoria = new MemoryStream();
                await origen.CopyToAsync(memoria, _cancelacion.Token);
                contenido = memoria.ToArray();
            }
            catch (Exception ex)
            {
                Avisos.Error($"No se pudo leer «{archivo.Name}»: {ex.Message}");
                return;
            }

            // El MultipartFormDataContent lo cierra ClienteApi.SubirAsync cuando la petición termina,
            // y es él quien adjunta el testigo antifalsificación que exige toda subida multipart.
            var formulario = new MultipartFormDataContent
            {
                { new ByteArrayContent(contenido), "archivo", archivo.Name },
                { new StringContent(tipo.ToString()), "tipo" }
            };

            var (ok, respuesta) = await Api.SubirAsync<ResultadoDto>(
                $"api/trabajo/requerimientos/{requerimientoId}/adjuntos", formulario, _cancelacion.Token);

            if (!ok) return;
            if (respuesta is not null) Avisos.Exito(respuesta.Mensaje);
        }
        finally { _ocupado = false; }

        // Las dos cosas: la lista del panel y la tabla, porque el contador de la columna «Docs» sale
        // de la carga de requerimientos y si no se quedaría desfasado.
        await CargarAdjuntos();
        await Cargar();
    }

    /// <summary>
    /// Abre el documento por la ruta común a todos los adjuntos: decide el tipo por los BYTES, manda
    /// <c>nosniff</c> y limpia el nombre. El navegador previsualiza lo que sabe (PDF, imágenes) y
    /// descarga el resto, en vez del volcado a una carpeta temporal que el escritorio nunca borraba.
    /// </summary>
    private Task AbrirAdjunto(AdjuntoDeRequerimientoDto a) =>
        Descargas.DesdeApiAsync($"api/adjuntos/requerimiento/{a.Id}").AsTask();

    private async Task EliminarAdjunto(AdjuntoDeRequerimientoDto a)
    {
        // Aquí eliminar sí borra, al revés que en el requerimiento: se dice para que nadie espere el
        // «queda cancelado» que la otra confirmación promete.
        if (!await Avisos.ConfirmarAsync(
            $"¿Eliminar «{a.Nombre}»?\n\nEste sí se borra de verdad y no se puede deshacer.",
            "Eliminar documento", "Sí, eliminar"))
            return;

        _ocupado = true;
        try
        {
            var (ok, respuesta) = await Api.EnviarAsync<object, ResultadoDto>(
                $"api/trabajo/adjuntos/{a.Id}/eliminacion", new { }, _cancelacion.Token);

            if (!ok) return;
            if (respuesta is not null) Avisos.Exito(respuesta.Mensaje);
        }
        finally { _ocupado = false; }

        await CargarAdjuntos();
        await Cargar();
    }

    /// <summary>
    /// El color del tipo lo pone la pantalla, no el servicio: separa de un vistazo el documento de
    /// requerimiento del de estimación, igual que en la rejilla del escritorio.
    ///
    /// Va a la ESCALA DE SERIES y no al semáforo a propósito. Un tipo de documento no es un estado:
    /// con verde y rojo, «estimación» se leería como «va bien» y «requerimiento» como «hay un
    /// problema», que es exactamente lo que no significan. Las series existen para enumerar cosas
    /// que solo necesitan distinguirse entre sí.
    /// </summary>
    private static string ColorDeTipo(RequirementAttachmentKind tipo) => tipo switch
    {
        RequirementAttachmentKind.Estimacion => "var(--adminweb-serie-2)",
        RequirementAttachmentKind.Requerimiento => "var(--adminweb-serie-1)",
        _ => "var(--rz-text-secondary-color)"
    };

    // ── Importación desde Azure DevOps ───────────────────────────────────────

    /// <summary>
    /// Da de alta como requerimientos los work items asignados y abiertos.
    ///
    /// Se confirma antes porque escribe en lote y sobre datos de todo el equipo: reparte
    /// asignaciones y avisa a quien le toque, y eso no es algo que deba pasar por rozar un botón.
    /// </summary>
    private async Task ImportarDeDevOps()
    {
        if (!await Avisos.ConfirmarAsync(
            "Se darán de alta como requerimientos los work items asignados y abiertos que todavía no " +
            "existan aquí, repartiéndolos según las reglas de auto-asignación.\n\nNada que ya esté " +
            "cerrado se da de alta, y lo que ya existía solo se actualiza.",
            "Importar de Azure DevOps", "Sí, importar"))
            return;

        _ocupado = true;
        try
        {
            // El mensaje del servicio se enseña TAL CUAL: cuenta cuántos se dieron de alta, cuántos
            // se actualizaron y cuántos quedaron auto-asignados, o explica por qué no se pudo —sin
            // token, sin organización, DevOps caído—.
            var (ok, resultado) = await Api.EnviarAsync<object?, ResultadoDeImportacionDto>(
                "api/devops/importar", null, _cancelacion.Token);

            if (!ok || resultado is null) return;
            Avisos.Exito(resultado.Mensaje);
        }
        finally { _ocupado = false; }

        await Cargar();
    }

    // ── Envío ────────────────────────────────────────────────────────────────

    /// <summary>
    /// El envío que comparten todas las acciones. El mensaje del servidor se enseña TAL CUAL: dice el
    /// motivo concreto —«ya estaba cancelado», «la fecha de entrega no puede ser anterior a la de
    /// solicitud»— y cambiarlo por un «no se pudo» genérico tiraría lo que el escritorio hacía bien.
    /// </summary>
    private async Task<bool> Enviar<T>(string ruta, T cuerpo)
    {
        _ocupado = true;
        try
        {
            var (ok, r) = await Api.EnviarAsync<T, ResultadoDto>(ruta, cuerpo, _cancelacion.Token);
            if (ok && r is not null) Avisos.Exito(r.Mensaje);
            if (ok) await Cargar();
            return ok;
        }
        finally { _ocupado = false; }
    }

    // ── Textos y pintado ─────────────────────────────────────────────────────

    private string Resumen()
    {
        int vencidos = Filas.Count(r => r.Vencido);
        return $"{Filas.Count} requerimiento(s)." +
               // Sin triángulo, igual que en MisAsignaciones.razor —es la misma frase copiada en dos
               // pantallas—: es una cadena que se pinta como texto plano y no cabe un componente. El
               // trozo solo se añade cuando hay vencidos, así que aparecer YA es el aviso.
               (vencidos > 0 ? $"  {vencidos} con el compromiso vencido." : "");
    }

    /// <summary>
    /// La fila entera en rojo cuando el compromiso venció y sigue sin entregarse, igual que en el
    /// escritorio. Es la única señal de la tabla que no describe el dato sino que reclama atención.
    ///
    /// Lleva NEGRITA además del color: en tema oscuro el rojo pierde fuerza contra el grafito, y hay
    /// gente que no lo distingue. Cuesta una palabra y hace que la tabla se lea impresa.
    /// </summary>
    private void PintarVencidos(RowRenderEventArgs<RequerimientoDto> args)
    {
        if (args.Data.Vencido) args.Attributes["style"] = "color:var(--rz-danger);font-weight:600";
    }

    public void Dispose()
    {
        _cancelacion.Cancel();
        _cancelacion.Dispose();
    }
}
