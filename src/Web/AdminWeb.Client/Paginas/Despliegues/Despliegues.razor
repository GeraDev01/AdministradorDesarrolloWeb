        await Descargas.DesdeApiAsync($"api/despliegues/historial/{jobId}/evidencia");

    // ── Envío ────────────────────────────────────────────────────────────────

    /// <summary>
    /// El envío que comparten todas las acciones. El mensaje del servidor se enseña TAL CUAL: dice el
    /// motivo concreto —«ese servidor está recibiendo otro despliegue», «no se puede eliminar: el
    /// perfil tiene despliegues en el historial»— y cambiarlo por un «no se pudo» genérico tiraría lo
    /// que el escritorio hacía bien.
    /// </summary>
    private async Task<bool> Enviar<T>(string ruta, T cuerpo, bool recargar = true)
    {
        _ocupado = true;
        try
        {
            var (ok, r) = await Api.EnviarAsync<T, ResultadoDto>(ruta, cuerpo, _cancelacion.Token);
            if (ok && r is not null) Avisos.Exito(r.Mensaje);
            if (ok && recargar) await Cargar();
            return ok;
        }
        finally { _ocupado = false; }
    }

    // ── Textos y pintado ─────────────────────────────────────────────────────

    private IEnumerable<SistemaDto> SistemasActivos => _sistemas.Where(s => s.Activo);

    private IEnumerable<ServidorDto> ServidoresActivos => _servidores.Where(s => s.Activo);

    /// <summary>
    /// Las versiones del sistema elegido, como opciones del desplegable. Se avisa ahí mismo de las
    /// que el servidor no puede alcanzar: enterarse al elegir es mejor que enterarse al desplegar.
    /// </summary>
    private List<OpcionDto> VersionesDelSistema =>
        [.. _versiones.Where(v => v.SistemaId == _sistemaId)
            .Select(v => new OpcionDto(v.Id,
                $"{v.Version}  ({v.CreadaUtc.ToLocalTime():dd/MM/yyyy})" + (v.PaqueteDisponible ? "" : "  ⚠ sin paquete")))];

    private IEnumerable<VersionDto> VersionesDelSistemaSeleccionado =>
        SistemaSeleccionado() is { } s ? _versiones.Where(v => v.SistemaId == s.Id) : [];

    private SistemaDto? SistemaSeleccionado() =>
        _sistemaSeleccionado?.FirstOrDefault() ?? SistemasActivos.FirstOrDefault(s => s.Id == _sistemaId);

    private void SeleccionarSistema(IList<SistemaDto>? seleccion) => _sistemaSeleccionado = seleccion;

    private void CambioDeSistema() => _versionId = VersionesDelSistema.FirstOrDefault()?.Id;

    private VersionDto? VersionElegida() => _versiones.FirstOrDefault(v => v.Id == _versionId);

    private bool SinRespaldo() => _respaldar.Count == 0;

    private string ResumenDeSeleccion() =>
        _elegidos.Count == 0
            ? "Ninguno elegido todavía."
            : $"{_elegidos.Count} servidor(es) elegidos, {_respaldar.Count} con respaldo previo.";

    private string ResumenDeLoQueSeVa()
    {
        var version = VersionElegida();
        var nombres = _servidores.Where(s => _elegidos.Contains(s.Id)).Select(s => s.Nombre);
        return $"{version?.Sistema} v{version?.Version} → {string.Join(", ", nombres)}";
    }

    private static string Megas(long bytes) => $"{bytes / 1024d / 1024d:0.0} MB";

    private static string? Resumir(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return null;
        var plano = texto.Replace("\r", "").Replace('\n', ' ');
        return plano.Length > 70 ? plano[..70] + "…" : plano;
    }

    private static string EstiloDeEstado(JobStatus estado) => estado switch
    {
        JobStatus.Completado => "color:var(--rz-success)",
        JobStatus.Fallido => "color:var(--rz-danger)",
        JobStatus.Cancelado or JobStatus.Parcial => "color:var(--rz-warning)",
        _ => ""
    };

    private void ApagarSistemasInactivos(RowRenderEventArgs<SistemaDto> args)
    {
        if (!args.Data.Activo) args.Attributes["style"] = "opacity:.55";
    }

    private void ApagarServidoresInactivos(RowRenderEventArgs<ServidorDto> args)
    {
        if (!args.Data.Activo) args.Attributes["style"] = "opacity:.55";
    }

    public async ValueTask DisposeAsync()
    {
        Vivo.DespliegueAvanzo -= AlAvanzar;
        Vivo.DespliegueRegistro -= AlRegistrar;
        Vivo.DespliegueTermino -= AlTerminar;

        // Dejar de mirar NO cancela: el despliegue sigue en el servidor y al volver se retoma. Es la
        // diferencia entera con el escritorio, donde cerrar la ventana lo mataba.
        if (_trabajo is { } trabajo)
        {
            try { await Vivo.DejarDespliegueAsync(trabajo.JobId); } catch { /* la conexión ya pudo cerrarse */ }
        }

        _cancelacion.Cancel();
        _cancelacion.Dispose();
    }
}
