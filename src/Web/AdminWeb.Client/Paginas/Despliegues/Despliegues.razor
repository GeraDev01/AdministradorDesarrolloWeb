@page "/despliegues"
@attribute [Authorize(Policy = "AdminUOperaciones")]
@using AdminWeb.Shared.Dtos.Despliegues
@* El listado del almacén: es de donde salen los paquetes de la compilación automática. *@
@using AdminWeb.Shared.Dtos.Programados
@implements IAsyncDisposable
@inject ClienteApi Api
@inject AvisosDeInterfaz Avisos
@inject Descargas Descargas
@inject ConexionEnVivo Vivo

@*
    Los despliegues.

    ══ LO QUE CAMBIA DE VERDAD RESPECTO AL ESCRITORIO ══

    Allí el despliegue lo ejecutaba el .exe de quien pulsaba el botón: si cerraba la aplicación a
    media subida, el despliegue moría a medias y no había forma de saber qué había quedado publicado
    y qué no. Aquí lo ejecuta EL SERVIDOR. Esta pantalla lo comanda y lo mira; no lo ejecuta.

    Las tres consecuencias, todas visibles en la pantalla:

      · Cerrar la pestaña NO cancela nada. Se puede irse y volver, y al volver la pantalla retoma el
        despliegue en curso donde iba —avance, bitácora y todo— porque el estado vive en el servidor.
      · Cancelar existe, pero hay que pedirlo. Es una acción deliberada y con su botón propio.
      · Dos personas pueden estar mirando el mismo despliegue a la vez. Por eso el servidor se niega
        a lanzar dos despliegues simultáneos al mismo servidor: la mezcla de dos versiones en la
        misma carpeta remota es un estado que nadie pidió y que además no se nota.

    ══ LO QUE SE CONSERVA DEL ESCRITORIO ══

      · EL CHECKLIST ES OBLIGATORIO, con su nota escrita, y queda como evidencia exportable junto al
        despliegue. No es un «¿seguro?»: esa pregunta se contesta que sí por reflejo, y marcar cuatro
        puntos obliga a mirarlos. Lo exige también el servidor, no solo este formulario.
      · El respaldo previo de la carpeta remota, salvo que la configuración lo apague, y decidible
        POR SERVIDOR. Si el respaldo falla, ese servidor no recibe el despliegue.
      · La selección DIRECTA de servidores (estilo Blobup) es la vía normal; los perfiles guardados
        siguen ahí como atajo.
      · El changelog lo ve todo el mundo, también Operaciones: es lo que necesita quien despliega
        para saber qué va a subir. Crear y borrar versiones sigue siendo del líder.
      · Un servidor se da de BAJA, no se borra: el historial tiene que seguir siendo legible.

    ══ LO QUE NO ESTÁ ══

      Crear una versión comprimiendo una carpeta local. No se puede traducir y no se traducirá: en el
      navegador no hay carpeta que el servidor pueda leer, y una caja donde alguien teclee una ruta
      del servidor sería un agujero, no una función.

      Las otras dos vías del escritorio sí están: registrar un paquete que ya se dejó en la carpeta de
      despliegue del servidor, y registrar uno que ya está en Azure Blob Storage —que es de donde
      salen los artefactos de la compilación automática—. El explorador del almacén tiene además su
      propia pantalla en «Almacenamiento».
*@

<PageTitle>Despliegues</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.H5" class="rz-mb-0">Despliegues</RadzenText>
        <RadzenButton Text="Recargar" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small" Click="@Cargar" Disabled="@_ocupado" />
        @if (_trabajo is { } enCurso && enCurso.Fin is null)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Info"
                         Text="@($"Despliegue #{enCurso.JobId} en curso en el servidor")" />
        }
    </RadzenStack>

    @if (_opciones is { } opciones)
    {
        <RadzenTabs @bind-SelectedIndex="_pestana">
            <Tabs>

                @* ══════════════════════════════ DESPLEGAR ══════════════════════════════ *@
                <RadzenTabsItem Text="🚀 Desplegar">
                    <RadzenStack Gap="0.75rem">

                        @if (!opciones.RespaldoPrevioActivo)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false">
                                El respaldo previo está DESACTIVADO en la configuración: se despliega sin red de
                                seguridad y no habrá a qué volver si algo sale mal.
                            </RadzenAlert>
                        }

                        @if (_trabajo is { } trabajo)
                        {
                            <RadzenCard>
                                <RadzenStack Gap="0.5rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                                 Gap="1rem" Wrap="FlexWrap.Wrap">
                                        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                                            @trabajo.Sistema v@trabajo.Version
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                                            @trabajo.Destino · lo lanzó @trabajo.QuienLoLanzo
                                            el @trabajo.InicioUtc.ToLocalTime().ToString("dd/MM HH:mm:ss")
                                        </RadzenText>

                                        @if (trabajo.Fin is null)
                                        {
                                            <RadzenButton Text="⏹ Cancelar despliegue" ButtonStyle="ButtonStyle.Danger"
                                                          Size="ButtonSize.Small" Disabled="@_ocupado"
                                                          Click="@CancelarDespliegue" Style="margin-left:auto" />
                                        }
                                        else
                                        {
                                            <RadzenButton Text="Cerrar" ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.Small" Click="@SoltarTrabajo"
                                                          Style="margin-left:auto" />
                                        }
                                    </RadzenStack>

                                    @if (trabajo.Fin is { } fin)
                                    {
                                        <RadzenAlert AlertStyle="@(fin.Estado == JobStatus.Completado ? AlertStyle.Success : AlertStyle.Warning)"
                                                     Shade="Shade.Lighter" AllowClose="false">
                                            @fin.EstadoTexto — @fin.Resumen
                                        </RadzenAlert>
                                    }
                                    else
                                    {
                                        <RadzenProgressBar Value="@_avance.Porcentaje" ShowValue="true"
                                                           Mode="ProgressBarMode.Determinate" />
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                                            ⏳ @(string.IsNullOrEmpty(_avance.Servidor) ? "" : $"[{_avance.Servidor}] ")@_avance.Detalle
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                                            Corre en el servidor: puedes cerrar esta pestaña o cambiar de pantalla sin
                                            interrumpirlo. Al volver, esta vista se retoma sola.
                                        </RadzenText>
                                    }

                                    <ConsolaDeDespliegue Renglones="@_renglones"
                                                         Vacio="(esperando al servidor…)" />
                                </RadzenStack>
                            </RadzenCard>
                        }

                        @if (_confirmando)
                        {
                            @* El checklist, dentro de la pantalla y no en una ventana modal: en el
                               navegador una modal encima de otra pantalla se pierde detrás del propio
                               navegador con demasiada facilidad. Lo que se exige es lo mismo. *@
                            <RadzenCard>
                                <RadzenStack Gap="0.75rem">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                                        Checklist previo — @ResumenDeLoQueSeVa()
                                    </RadzenText>

                                    @if (SinRespaldo())
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false">
                                            Ningún servidor se va a respaldar: si esta versión rompe algo, no hay copia
                                            de lo que había.
                                        </RadzenAlert>
                                    }

                                    @foreach (var punto in opciones.Checklist)
                                    {
                                        <RadzenStack Gap="0.1rem">
                                            <RadzenCheckBox TValue="bool" Name="@punto.Clave"
                                                            Value="@_marcados.Contains(punto.Clave)"
                                                            Change="@((bool v) => Marcar(punto.Clave, v))" />
                                            <RadzenLabel Text="@punto.Texto" Component="@punto.Clave" />
                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">@punto.Ayuda</RadzenText>
                                        </RadzenStack>
                                    }

                                    <RadzenTextArea @bind-Value="_nota" Rows="2" Style="width:100%"
                                                    Placeholder="¿Por qué se despliega ahora? (obligatorio: un ticket, un CAB, un motivo)" />

                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                        <RadzenButton Text="🚀 Desplegar" Disabled="@(_ocupado || !ChecklistCompleto(opciones))"
                                                      Click="@Lanzar" />
                                        <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light"
                                                      Disabled="@_ocupado" Click="@(() => _confirmando = false)" />
                                    </RadzenStack>
                                </RadzenStack>
                            </RadzenCard>
                        }

                        <RadzenCard>
                            <RadzenStack Gap="0.75rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                             Gap="1rem" Wrap="FlexWrap.Wrap">
                                    <RadzenLabel Text="Sistema:" Component="sistemaDespliegue" />
                                    <RadzenDropDown TValue="int?" @bind-Value="_sistemaId" Name="sistemaDespliegue"
                                                    Data="@SistemasActivos" TextProperty="Nombre" ValueProperty="Id"
                                                    Placeholder="Elige un sistema" Disabled="@_ocupado"
                                                    Change="@(_ => CambioDeSistema())" Style="min-width:16rem" />

                                    <RadzenLabel Text="Versión:" Component="versionDespliegue" />
                                    <RadzenDropDown TValue="int?" @bind-Value="_versionId" Name="versionDespliegue"
                                                    Data="@VersionesDelSistema" TextProperty="Texto" ValueProperty="Id"
                                                    Placeholder="Elige una versión" Disabled="@_ocupado"
                                                    Style="min-width:20rem" />

                                    <RadzenButton Text="🚀 Preparar despliegue" Disabled="@(_ocupado || _confirmando)"
                                                  Click="@AbrirChecklist" Style="margin-left:auto" />
                                </RadzenStack>

                                @if (VersionElegida() is { PaqueteDisponible: false } sinPaquete)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false">
                                        El servidor no encuentra el paquete de «@sinPaquete.Version». Vuelve a dejar el
                                        .zip en la carpeta de despliegue antes de intentarlo.
                                    </RadzenAlert>
                                }

                                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                                    Elige los servidores destino y, en cada uno, si se respalda su carpeta remota antes
                                    de sobrescribirla. @ResumenDeSeleccion()
                                </RadzenText>

                                @if (_perfiles.Count > 0)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                                 Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">Atajo:</RadzenText>
                                        @foreach (var perfil in _perfiles)
                                        {
                                            <RadzenButton Text="@($"🔧 {perfil.Nombre}")" ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                          Click="@(() => AplicarPerfil(perfil))" />
                                        }
                                    </RadzenStack>
                                }

                                <RadzenDataGrid TItem="ServidorDto" Data="@ServidoresActivos" AllowPaging="true" PageSize="10"
                                                AllowSorting="true" EmptyText="No hay servidores activos.">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="ServidorDto" Title="Desplegar" Width="100px" Sortable="false">
                                            <Template Context="s">
                                                <RadzenCheckBox TValue="bool" Value="@_elegidos.Contains(s.Id)"
                                                                Disabled="@(_ocupado || !s.TieneContrasena)"
                                                                Change="@((bool v) => Elegir(s.Id, v))" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ServidorDto" Title="Respaldar" Width="100px" Sortable="false">
                                            <Template Context="s">
                                                <RadzenCheckBox TValue="bool" Value="@_respaldar.Contains(s.Id)"
                                                                Disabled="@(_ocupado || !_elegidos.Contains(s.Id) || !opciones.RespaldoPrevioActivo)"
                                                                Change="@((bool v) => Respaldar(s.Id, v))" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ServidorDto" Property="Nombre" Title="Servidor" />
                                        <RadzenDataGridColumn TItem="ServidorDto" Property="RutaRemota" Title="Ruta remota" Width="200px" />
                                        <RadzenDataGridColumn TItem="ServidorDto" Property="VersionDesplegada" Title="Tiene hoy" Width="220px">
                                            <Template Context="s">@(s.VersionDesplegada ?? "—")</Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ServidorDto" Property="UltimoDespliegueUtc"
                                                              Title="Últ. actualización" Width="160px">
                                            <Template Context="s">
                                                @(s.UltimoDespliegueUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nunca")
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="ServidorDto" Title="" Width="220px" Sortable="false">
                                            <Template Context="s">
                                                @if (!s.TieneContrasena)
                                                {
                                                    @* No es que falte: está guardada con el cifrado antiguo de Windows y
                                                       el servidor no puede leerla. Decirlo evita el «530» incomprensible. *@
                                                    <span style="color:var(--rz-warning)">⚠ hay que recapturar su contraseña</span>
                                                }
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            </RadzenStack>
                        </RadzenCard>

                        @if (_enCurso.Count > 1 || (_enCurso.Count == 1 && _trabajo is null))
                        {
                            <RadzenCard>
                                <RadzenStack Gap="0.5rem">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">
                                        Otros despliegues que el servidor tiene entre manos
                                    </RadzenText>
                                    @foreach (var otro in _enCurso.Where(t => t.JobId != _trabajo?.JobId))
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                                                #@otro.JobId — @otro.Sistema v@otro.Version → @otro.Destino
                                                (@otro.QuienLoLanzo)
                                            </RadzenText>
                                            <RadzenButton Text="Mirarlo" ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.ExtraSmall" Click="@(() => AdoptarAsync(otro))" />
                                        </RadzenStack>
                                    }
                                </RadzenStack>
                            </RadzenCard>
                        }
                    </RadzenStack>
                </RadzenTabsItem>

                @* ══════════════════════════ SISTEMAS Y VERSIONES ══════════════════════════ *@
                <RadzenTabsItem Text="🖥 Sistemas y versiones">
                    <RadzenStack Gap="0.75rem">
                        @if (!opciones.PuedeAdministrarCatalogo)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                                Solo consulta. El changelog está a la vista a propósito: es lo que necesitas para saber
                                qué vas a subir.
                            </RadzenText>
                        }
                        else if (!opciones.CarpetaDeDespligueConfigurada)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false">
                                Falta configurar la carpeta de despliegue del servidor (clave <b>DefaultDeployFolder</b>
                                en Configuración). Es donde el servidor busca los paquetes y donde guarda los respaldos
                                previos; sin ella no se pueden registrar versiones nuevas.
                            </RadzenAlert>
                        }

                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     Gap="1rem" Wrap="FlexWrap.Wrap">
                            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">Sistemas</RadzenText>
                            @if (opciones.PuedeAdministrarCatalogo)
                            {
                                <RadzenButton Text="➕ Nuevo sistema" Size="ButtonSize.Small"
                                              Disabled="@_ocupado" Click="@NuevoSistema" />
                            }
                        </RadzenStack>

                        <RadzenDataGrid TItem="SistemaDto" Data="@_sistemas" AllowSorting="true" AllowPaging="true"
                                        PageSize="8" RowRender="@ApagarSistemasInactivos"
                                        SelectionMode="DataGridSelectionMode.Single"
                                        Value="@_sistemaSeleccionado" ValueChanged="@SeleccionarSistema"
                                        EmptyText="No hay sistemas dados de alta.">
                            <Columns>
                                <RadzenDataGridColumn TItem="SistemaDto" Property="Nombre" Title="Sistema" />
                                <RadzenDataGridColumn TItem="SistemaDto" Property="Descripcion" Title="Descripción">
                                    <Template Context="s">@(s.Descripcion ?? "—")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SistemaDto" Property="Versiones" Title="Versiones"
                                                      Width="110px" TextAlign="TextAlign.Right" />
                                <RadzenDataGridColumn TItem="SistemaDto" Property="Activo" Title="Estado" Width="110px">
                                    <Template Context="s">@(s.Activo ? "Activo" : "De baja")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SistemaDto" Title="" Width="200px" Sortable="false">
                                    <Template Context="s">
                                        @if (opciones.PuedeAdministrarCatalogo)
                                        {
                                            <RadzenButton Text="Editar" ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                          Click="@(() => EditarSistema(s))" />
                                            <RadzenButton Text="@(s.Activo ? "Dar de baja" : "Reactivar")"
                                                          ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                                          Disabled="@_ocupado" Click="@(() => AlternarSistema(s))" />
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>

                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     Gap="1rem" Wrap="FlexWrap.Wrap">
                            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                                Versiones @(SistemaSeleccionado() is { } sel ? $"de {sel.Nombre}" : "(elige un sistema)")
                            </RadzenText>
                            @if (opciones.PuedeAdministrarCatalogo && SistemaSeleccionado() is not null)
                            {
                                <RadzenButton Text="➕ Registrar paquete" Size="ButtonSize.Small"
                                              Disabled="@(_ocupado || !opciones.CarpetaDeDespligueConfigurada)"
                                              Click="@RegistrarPaquete"
                                              title="Un .zip que ya está en la carpeta de despliegue del servidor." />
                                @* La vía normal cuando hay compilación automática: el artefacto ya
                                   está en el almacén y solo hay que darlo de alta. *@
                                <RadzenButton Text="☁ Desde el almacén" Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Light"
                                              Disabled="@_ocupado" Click="@RegistrarDesdeAlmacen"
                                              title="Un .zip que ya está en Azure Blob Storage." />
                            }
                        </RadzenStack>

                        <RadzenDataGrid TItem="VersionDto" Data="@VersionesDelSistemaSeleccionado" AllowSorting="true"
                                        AllowPaging="true" PageSize="10"
                                        EmptyText="Este sistema no tiene versiones registradas.">
                            <Columns>
                                <RadzenDataGridColumn TItem="VersionDto" Property="Version" Title="Versión" Width="160px" />
                                <RadzenDataGridColumn TItem="VersionDto" Property="TamanoBytes" Title="Tamaño" Width="110px">
                                    <Template Context="v">@Megas(v.TamanoBytes)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VersionDto" Property="CreadaUtc" Title="Registrada" Width="150px">
                                    <Template Context="v">@v.CreadaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VersionDto" Property="PaqueteDisponible" Title="Paquete" Width="130px">
                                    <Template Context="v">
                                        @if (v.PaqueteDisponible)
                                        {
                                            <span>✓ en el servidor</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--rz-danger)">✗ no está</span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VersionDto" Property="Changelog" Title="Changelog">
                                    <Template Context="v">@(Resumir(v.Changelog) ?? "—")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VersionDto" Title="" Width="200px" Sortable="false">
                                    <Template Context="v">
                                        @if (opciones.PuedeAdministrarCatalogo)
                                        {
                                            <RadzenButton Text="Editar" ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                          Click="@(() => EditarVersion(v))" />
                                            @if (!v.EtiquetaBloqueada)
                                            {
                                                <RadzenButton Text="Eliminar" ButtonStyle="ButtonStyle.Light"
                                                              Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                              Click="@(() => EliminarVersion(v))" />
                                            }
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenStack>
                </RadzenTabsItem>

                @* ══════════════════════════════ SERVIDORES ══════════════════════════════ *@
                <RadzenTabsItem Text="🌐 Servidores">
                    <RadzenStack Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     Gap="1rem" Wrap="FlexWrap.Wrap">
                            @if (opciones.PuedeCrearServidores)
                            {
                                <RadzenButton Text="➕ Nuevo servidor" Size="ButtonSize.Small"
                                              Disabled="@_ocupado" Click="@NuevoServidor" />
                            }
                            @* El alta MASIVA es del líder aunque la de uno en uno la tenga también
                               Operaciones: un archivo puede reescribir de golpe el inventario entero,
                               contraseñas incluidas, y eso es corregir lo existente. *@
                            @if (opciones.PuedeEditarServidores)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                                    o importar varios desde un JSON:
                                </RadzenText>
                                <InputFile OnChange="@ImportarServidores" accept=".json" disabled="@_ocupado" />
                            }

                            @if (!opciones.PuedeEditarServidores)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                                    Puedes dar de alta servidores. Para corregir o dar de baja uno existente, pídeselo a
                                    un líder: un servidor mal editado rompe despliegues de todo el equipo.
                                </RadzenText>
                            }
                        </RadzenStack>

                        <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" AllowClose="false">
                            Las contraseñas de los servidores no se pueden leer desde aquí, ni siquiera cifradas: solo
                            se sabe si están puestas y se pueden reemplazar. Al editar, dejar la contraseña en blanco
                            la conserva.
                        </RadzenAlert>

                        <RadzenDataGrid TItem="ServidorDto" Data="@_servidores" AllowSorting="true" AllowPaging="true"
                                        PageSize="12" RowRender="@ApagarServidoresInactivos"
                                        EmptyText="No hay servidores dados de alta.">
                            <Columns>
                                <RadzenDataGridColumn TItem="ServidorDto" Property="Nombre" Title="Nombre" />
                                <RadzenDataGridColumn TItem="ServidorDto" Property="Host" Title="Host" />
                                <RadzenDataGridColumn TItem="ServidorDto" Property="Puerto" Title="Puerto" Width="90px" />
                                <RadzenDataGridColumn TItem="ServidorDto" Property="Usuario" Title="Usuario" Width="140px" />
                                <RadzenDataGridColumn TItem="ServidorDto" Property="RutaRemota" Title="Ruta remota" Width="180px" />
                                <RadzenDataGridColumn TItem="ServidorDto" Property="TieneContrasena" Title="Contraseña" Width="150px">
                                    <Template Context="s">
                                        @if (s.TieneContrasena)
                                        {
                                            <span>✓ guardada</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--rz-warning)">⚠ recapturar</span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ServidorDto" Property="VersionDesplegada" Title="Tiene hoy" Width="200px">
                                    <Template Context="s">@(s.VersionDesplegada ?? "—")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ServidorDto" Property="QuienDesplego" Title="Quién" Width="150px">
                                    <Template Context="s">@(s.QuienDesplego ?? "—")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ServidorDto" Title="" Width="260px" Sortable="false">
                                    <Template Context="s">
                                        @if (opciones.PuedeEditarServidores)
                                        {
                                            <RadzenButton Text="Editar" ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                          Click="@(() => EditarServidor(s))" />
                                            <RadzenButton Text="@(s.Activo ? "Dar de baja" : "Reactivar")"
                                                          ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                                          Disabled="@_ocupado" Click="@(() => AlternarServidor(s))" />
                                        }
                                        @if (!string.IsNullOrWhiteSpace(s.Url))
                                        {
                                            <a href="@s.Url" target="_blank" rel="noopener" title="Abrir el sitio"> 🌍</a>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenStack>
                </RadzenTabsItem>

                @* ═══════════════════════════════ PERFILES ═══════════════════════════════ *@
                @if (opciones.PuedeAdministrarCatalogo)
                {
                    <RadzenTabsItem Text="🔧 Perfiles">
                        <RadzenStack Gap="0.75rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                         Gap="1rem" Wrap="FlexWrap.Wrap">
                                <RadzenButton Text="➕ Nuevo perfil" Size="ButtonSize.Small"
                                              Disabled="@_ocupado" Click="@NuevoPerfil" />
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                                    Un perfil es un destino con nombre. Marcar «operaciones» le permite a ese rol
                                    desplegarlo sin elegir servidores uno por uno.
                                </RadzenText>
                            </RadzenStack>

                            <RadzenDataGrid TItem="PerfilDto" Data="@_perfiles" AllowSorting="true" AllowPaging="true"
                                            PageSize="10" EmptyText="No hay perfiles guardados.">
                                <Columns>
                                    <RadzenDataGridColumn TItem="PerfilDto" Property="Nombre" Title="Perfil" Width="200px" />
                                    <RadzenDataGridColumn TItem="PerfilDto" Property="Descripcion" Title="Descripción">
                                        <Template Context="p">@(p.Descripcion ?? "—")</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="PerfilDto" Property="Servidores" Title="Servidores" />
                                    <RadzenDataGridColumn TItem="PerfilDto" Property="PermitidoParaOperaciones"
                                                          Title="Operaciones" Width="120px">
                                        <Template Context="p">@(p.PermitidoParaOperaciones ? "✓ Sí" : "—")</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="PerfilDto" Title="" Width="200px" Sortable="false">
                                        <Template Context="p">
                                            <RadzenButton Text="Editar" ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                          Click="@(() => EditarPerfil(p))" />
                                            @if (!p.TieneHistorial)
                                            {
                                                <RadzenButton Text="Eliminar" ButtonStyle="ButtonStyle.Light"
                                                              Size="ButtonSize.ExtraSmall" Disabled="@_ocupado"
                                                              Click="@(() => EliminarPerfil(p))" />
                                            }
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenStack>
                    </RadzenTabsItem>
                }

                @* ═══════════════════════════════ HISTORIAL ══════════════════════════════ *@
                <RadzenTabsItem Text="📜 Historial">
                    <RadzenStack Gap="0.75rem">
                        <RadzenDataGrid TItem="DespliegueDelHistorialDto" Data="@_historial" AllowSorting="true"
                                        AllowPaging="true" PageSize="15"
                                        SelectionMode="DataGridSelectionMode.Single"
                                        Value="@_historialSeleccionado" ValueChanged="@SeleccionarDelHistorial"
                                        EmptyText="Todavía no hay despliegues.">
                            <Columns>
                                <RadzenDataGridColumn TItem="DespliegueDelHistorialDto" Property="JobId" Title="#" Width="70px" />
                                <RadzenDataGridColumn TItem="DespliegueDelHistorialDto" Property="Sistema" Title="Sistema" />
                                <RadzenDataGridColumn TItem="DespliegueDelHistorialDto" Property="Version" Title="Versión" Width="140px" />
                                <RadzenDataGridColumn TItem="DespliegueDelHistorialDto" Property="Destino" Title="Destino" />
                                <RadzenDataGridColumn TItem="DespliegueDelHistorialDto" Property="EstadoTexto" Title="Estado" Width="120px">
                                    <Template Context="h">
                                        <span style="@EstiloDeEstado(h.Estado)">@h.EstadoTexto</span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="DespliegueDelHistorialDto" Title="OK / Fall." Width="100px" Sortable="false">
                                    <Template Context="h">@h.Ok / @h.Fallidos</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="DespliegueDelHistorialDto" Property="InicioUtc" Title="Inicio" Width="150px">
                                    <Template Context="h">@(h.InicioUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="DespliegueDelHistorialDto" Property="DuracionSegundos"
                                                      Title="Duración" Width="110px">
                                    <Template Context="h">@(h.DuracionSegundos is double d ? $"{d:0} s" : "—")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="DespliegueDelHistorialDto" Property="QuienLoLanzo"
                                                      Title="Quién" Width="150px" />
                                <RadzenDataGridColumn TItem="DespliegueDelHistorialDto" Property="TieneChecklist"
                                                      Title="Checklist" Width="110px">
                                    @* La ausencia es un dato: los despliegues anteriores a que el checklist
                                       fuera obligatorio no tienen evidencia, y decirlo vale más que un hueco. *@
                                    <Template Context="h">
                                        @if (h.TieneChecklist)
                                        {
                                            <span>✓</span>
                                        }
                                        else
                                        {
                                            <span style="opacity:.55">sin registrar</span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>

                        <RadzenCard>
                            @if (_expediente is not { } expediente)
                            {
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                                    Selecciona un despliegue para ver su checklist y su log completo.
                                </RadzenText>
                            }
                            else
                            {
                                <RadzenStack Gap="0.75rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                                 Gap="1rem" Wrap="FlexWrap.Wrap">
                                        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0">
                                            Despliegue #@expediente.Cabecera.JobId —
                                            @expediente.Cabecera.Sistema v@expediente.Cabecera.Version
                                        </RadzenText>
                                        <RadzenButton Text="📄 Descargar evidencia" ButtonStyle="ButtonStyle.Light"
                                                      Size="ButtonSize.Small"
                                                      Click="@(() => DescargarEvidencia(expediente.Cabecera.JobId))" />
                                    </RadzenStack>

                                    @* Texto plano en un <pre>, nunca MarkupString: la evidencia lleva
                                       rutas y nombres que no son de fiar como marcado. *@
                                    <pre style="white-space:pre-wrap; word-break:break-word; margin:0; font-size:.82rem;">@(expediente.Checklist ?? "(Este despliegue es anterior al checklist previo: no hay confirmación registrada.)")</pre>

                                    <ConsolaDeDespliegue Renglones="@expediente.Bitacora" Alto="18rem"
                                                         Vacio="(sin entradas de log para este despliegue)" />
                                </RadzenStack>
                            }
                        </RadzenCard>
                    </RadzenStack>
                </RadzenTabsItem>

            </Tabs>
        </RadzenTabs>
    }
</RadzenStack>

@code {
    private readonly CancellationTokenSource _cancelacion = new();

    private OpcionesDeDesplieguesDto? _opciones;
    private List<SistemaDto> _sistemas = [];
    private List<VersionDto> _versiones = [];
    private List<ServidorDto> _servidores = [];
    private List<PerfilDto> _perfiles = [];
    private List<DespliegueDelHistorialDto> _historial = [];
    private bool _ocupado;
    private int _pestana;

    // Pestaña de despliegue.
    private int? _sistemaId;
    private int? _versionId;
    private readonly HashSet<int> _elegidos = [];
    private readonly HashSet<int> _respaldar = [];
    private bool _confirmando;
    private readonly HashSet<string> _marcados = [];
    private string _nota = "";

    // El despliegue que se está mirando.
    private TrabajoDeDespliegueDto? _trabajo;
    private List<TrabajoDeDespliegueDto> _enCurso = [];
    private List<RenglonDeBitacoraDto> _renglones = [];
    private AvanceDeDespliegueDto _avance = new(0, 0, "", "");

    // Selecciones de las rejillas.
    private IList<SistemaDto>? _sistemaSeleccionado;
    private IList<DespliegueDelHistorialDto>? _historialSeleccionado;
    private ExpedienteDeDespliegueDto? _expediente;

    protected override async Task OnInitializedAsync()
    {
        Vivo.DespliegueAvanzo += AlAvanzar;
        Vivo.DespliegueRegistro += AlRegistrar;
        Vivo.DespliegueTermino += AlTerminar;

        await Cargar();
    }

    // ── Carga ────────────────────────────────────────────────────────────────

    private async Task Cargar()
    {
        _ocupado = true;
        try
        {
            _opciones = await Api.LeerAsync<OpcionesDeDesplieguesDto>("api/despliegues/opciones", _cancelacion.Token);
            if (_opciones is null) return;

            _sistemas = await Api.LeerAsync<List<SistemaDto>>("api/despliegues/sistemas", _cancelacion.Token) ?? [];
            _versiones = await Api.LeerAsync<List<VersionDto>>("api/despliegues/versiones", _cancelacion.Token) ?? [];
            _servidores = await Api.LeerAsync<List<ServidorDto>>("api/despliegues/servidores", _cancelacion.Token) ?? [];
            _historial = await Api.LeerAsync<List<DespliegueDelHistorialDto>>("api/despliegues/historial", _cancelacion.Token) ?? [];

            // Los perfiles son del líder: para Operaciones la respuesta sería un 403 que no aporta
            // nada, así que ni se pide.
            _perfiles = _opciones.PuedeAdministrarCatalogo
                ? await Api.LeerAsync<List<PerfilDto>>("api/despliegues/perfiles", _cancelacion.Token) ?? []
                : [];

            _sistemaId ??= SistemasActivos.FirstOrDefault()?.Id;
            _sistemaSeleccionado ??= SistemaSeleccionado() is { } s ? [s] : null;
            if (_versionId is null || VersionesDelSistema.All(v => v.Id != _versionId))
                _versionId = VersionesDelSistema.FirstOrDefault()?.Id;

            await RetomarEnCursoAsync();
        }
        finally { _ocupado = false; }
    }

    /// <summary>
    /// Retoma la vista de lo que el servidor tenga entre manos.
    ///
    /// Es la mejora que define esta pantalla: en el escritorio no había nada que retomar porque el
    /// despliegue moría con la aplicación. Se adopta automáticamente el propio; los de otras personas
    /// se ofrecen para mirarlos, pero no se roba la pantalla de quien acaba de entrar.
    /// </summary>
    private async Task RetomarEnCursoAsync()
    {
        _enCurso = [.. await Api.LeerAsync<List<TrabajoDeDespliegueDto>>(
            "api/despliegues/en-curso", _cancelacion.Token) ?? []];

        if (_trabajo is not null) return;

        var mio = _enCurso.FirstOrDefault(t => t.Mio && t.Fin is null)
                  ?? _enCurso.FirstOrDefault(t => t.Mio);
        if (mio is not null) await AdoptarAsync(mio);
    }

    /// <summary>Se pone a mirar un despliegue: toma su foto y se suscribe a lo que venga después.</summary>
    private async Task AdoptarAsync(TrabajoDeDespliegueDto trabajo)
    {
        if (_trabajo is { } anterior && anterior.JobId != trabajo.JobId)
            await Vivo.DejarDespliegueAsync(anterior.JobId);

        _trabajo = trabajo;
        _renglones = [.. trabajo.Bitacora];
        _avance = trabajo.Avance;
        _pestana = 0;

        // Primero la foto y después la suscripción: al revés se perdería lo ocurrido entre las dos.
        // Un renglón repetido en la consola es un mal menor frente a un hueco silencioso.
        await Vivo.SeguirDespliegueAsync(trabajo.JobId);
    }

    private async Task SoltarTrabajo()
    {
        if (_trabajo is { } trabajo) await Vivo.DejarDespliegueAsync(trabajo.JobId);
        _trabajo = null;
        _renglones = [];
        await Cargar();
    }

    // ── Lo que llega por el canal en vivo ────────────────────────────────────

    private void AlAvanzar(AvanceDeDespliegueDto avance)
    {
        if (_trabajo?.JobId != avance.JobId) return;
        _avance = avance;
        InvokeAsync(StateHasChanged);
    }

    private void AlRegistrar(RenglonDeBitacoraDto renglon)
    {
        if (_trabajo is null) return;
        _renglones.Add(renglon);
        // Mismo tope que el servidor: la consola es para seguir el despliegue, no para archivarlo.
        // El log completo queda en el historial.
        if (_renglones.Count > 400) _renglones.RemoveRange(0, _renglones.Count - 400);
        InvokeAsync(StateHasChanged);
    }

    private void AlTerminar(FinDeDespliegueDto fin)
    {
        if (_trabajo is not { } trabajo || trabajo.JobId != fin.JobId) return;
        _trabajo = trabajo with { Fin = fin };
        InvokeAsync(async () =>
        {
            // El historial y el estado de los servidores acaban de cambiar: se recargan solos para
            // que nadie tenga que acordarse de pulsar «recargar» al terminar un despliegue.
            _historial = await Api.LeerAsync<List<DespliegueDelHistorialDto>>(
                "api/despliegues/historial", _cancelacion.Token) ?? _historial;
            _servidores = await Api.LeerAsync<List<ServidorDto>>(
                "api/despliegues/servidores", _cancelacion.Token) ?? _servidores;
            StateHasChanged();
        });
    }

    // ── Lanzar ───────────────────────────────────────────────────────────────

    private void AbrirChecklist()
    {
        if (_versionId is null) { Avisos.Aviso("Elige la versión que vas a desplegar."); return; }
        if (_elegidos.Count == 0) { Avisos.Aviso("Elige al menos un servidor destino."); return; }

        _marcados.Clear();
        _nota = "";
        _confirmando = true;
    }

    private void Marcar(string clave, bool marcado)
    {
        if (marcado) _marcados.Add(clave); else _marcados.Remove(clave);
    }

    private bool ChecklistCompleto(OpcionesDeDesplieguesDto opciones) =>
        opciones.Checklist.All(p => _marcados.Contains(p.Clave))
        && (_nota ?? "").Trim().Length >= opciones.MinimoNota;

    private async Task Lanzar()
    {
        _ocupado = true;
        try
        {
            var peticion = new LanzarDespliegueRequest(
                _versionId!.Value,
                [.. _elegidos],
                PerfilId: null,
                RespaldarServidorIds: [.. _respaldar],
                Marcados: [.. _marcados],
                Nota: _nota);

            var (ok, lanzado) = await Api.EnviarAsync<LanzarDespliegueRequest, DespliegueLanzadoDto>(
                "api/despliegues/lanzar", peticion, _cancelacion.Token);
            if (!ok || lanzado is null) return;

            Avisos.Exito(lanzado.Mensaje);
            _confirmando = false;

            var trabajo = await Api.LeerAsync<TrabajoDeDespliegueDto>(
                $"api/despliegues/trabajo/{lanzado.JobId}", _cancelacion.Token);
            if (trabajo is not null) await AdoptarAsync(trabajo);
        }
        finally { _ocupado = false; }
    }

    private async Task CancelarDespliegue()
    {
        if (_trabajo is not { } trabajo) return;

        // Se pregunta porque cancelar a media subida deja el servidor con una versión a medias, y eso
        // es peor que esperar dos minutos. En el escritorio bastaba con cerrar la aplicación; aquí
        // hay que pedirlo, y ese es el punto.
        if (!await Avisos.ConfirmarAsync(
            $"¿Cancelar el despliegue #{trabajo.JobId}? Los servidores que ya recibieron la versión se " +
            "quedan con ella; el que esté a medias puede quedar con archivos mezclados.",
            "Cancelar despliegue", "Sí, cancelarlo"))
            return;

        await Enviar<object?>($"api/despliegues/trabajo/{trabajo.JobId}/cancelar", null, recargar: false);
    }

    // ── Selección de servidores ──────────────────────────────────────────────

    private void Elegir(int servidorId, bool elegido)
    {
        if (elegido)
        {
            _elegidos.Add(servidorId);
            // Se respalda por omisión al elegir un servidor: quien no se pronuncia obtiene la red de
            // seguridad, no su ausencia. Quitarla es un acto consciente.
            if (_opciones?.RespaldoPrevioActivo == true) _respaldar.Add(servidorId);
        }
        else
        {
            _elegidos.Remove(servidorId);
            _respaldar.Remove(servidorId);
        }
    }

    private void Respaldar(int servidorId, bool respaldar)
    {
        if (respaldar) _respaldar.Add(servidorId); else _respaldar.Remove(servidorId);
    }

    private void AplicarPerfil(PerfilDto perfil)
    {
        _elegidos.Clear();
        _respaldar.Clear();
        foreach (var id in perfil.ServidorIds.Where(id => _servidores.Any(s => s.Id == id && s.Activo)))
            Elegir(id, true);
    }

    // ── Catálogo ─────────────────────────────────────────────────────────────

    private async Task NuevoSistema()
    {
        var nombre = await Avisos.PedirTextoAsync("¿Cómo se llama el sistema?", "Nuevo sistema");
        if (string.IsNullOrWhiteSpace(nombre)) return;

        var descripcion = await Avisos.PedirTextoAsync("Descripción (opcional):", "Nuevo sistema");
        await Enviar("api/despliegues/sistemas/nuevo", new GuardarSistemaRequest(nombre, descripcion, null));
    }

    private async Task EditarSistema(SistemaDto sistema)
    {
        var nombre = await Avisos.PedirTextoAsync($"Nombre (actual: «{sistema.Nombre}»):", "Editar sistema");
        if (string.IsNullOrWhiteSpace(nombre)) return;

        var descripcion = await Avisos.PedirTextoAsync("Descripción (opcional):", "Editar sistema");
        await Enviar($"api/despliegues/sistemas/{sistema.Id}/editar",
            new GuardarSistemaRequest(nombre, descripcion, sistema.CarpetaPorOmision));
    }

    private async Task AlternarSistema(SistemaDto sistema)
    {
        if (sistema.Activo && !await Avisos.ConfirmarAsync(
            $"¿Dar de baja «{sistema.Nombre}»? Deja de ofrecerse para desplegar y su historial se conserva.",
            "Dar de baja", "Sí, darlo de baja"))
            return;

        await Enviar<object?>($"api/despliegues/sistemas/{sistema.Id}/alternar", null);
    }

    private async Task RegistrarPaquete()
    {
        if (SistemaSeleccionado() is not { } sistema) return;

        var paquetes = await Api.LeerAsync<List<PaqueteDisponibleDto>>(
            "api/despliegues/paquetes", _cancelacion.Token) ?? [];
        if (paquetes.Count == 0)
        {
            Avisos.Aviso("No hay ningún .zip sin registrar en la carpeta de despliegue del servidor. " +
                         "Deja ahí el paquete y vuelve a intentarlo.");
            return;
        }

        var lista = string.Join("\n", paquetes.Select(p => $"· {p.Nombre}  ({Megas(p.TamanoBytes)})"));
        var nombre = await Avisos.PedirTextoAsync(
            $"¿Qué paquete se registra? Escribe su nombre exacto.\n\n{lista}", "Registrar paquete");
        if (string.IsNullOrWhiteSpace(nombre)) return;

        var etiqueta = await Avisos.PedirTextoAsync(
            "Etiqueta de la versión (p. ej. 2.4.1). Una vez desplegada ya no se podrá cambiar: es su " +
            "nombre en el historial.", "Registrar paquete");
        if (string.IsNullOrWhiteSpace(etiqueta)) return;

        var changelog = await Avisos.PedirTextoAsync(
            "Changelog: qué trae esta versión. Lo lee quien despliega para saber qué va a subir.",
            "Registrar paquete");

        await Enviar("api/despliegues/versiones/nueva",
            new CrearVersionRequest(sistema.Id, etiqueta, changelog, nombre.Trim()));
    }

    /// <summary>
    /// La otra vía de entrada de una versión: un paquete que la compilación automática ya dejó en el
    /// almacén.
    ///
    /// Faltaba, y su ausencia era más grave de lo que parece: los artefactos de CI van a Blob, así
    /// que el camino normal para dar de alta una versión estaba cortado y solo quedaba dejar el .zip
    /// a mano en el disco del servidor.
    /// </summary>
    private async Task RegistrarDesdeAlmacen()
    {
        if (SistemaSeleccionado() is not { } sistema) return;

        var almacen = await Api.LeerAsync<ListadoDeBlobsDto>(
            "api/almacenamiento/?carpeta=", _cancelacion.Token);

        var paquetes = almacen?.Archivos
            .Where(a => a.Nombre.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
            .ToList() ?? [];

        if (paquetes.Count == 0)
        {
            Avisos.Aviso("No hay ningún .zip en la carpeta de versiones del almacén. " +
                         "Comprueba que Azure Blob Storage esté configurado y que la compilación " +
                         "haya subido el paquete.");
            return;
        }

        // El tamaño ya viene redactado por el servidor, así que aquí no se vuelve a formatear.
        var lista = string.Join("\n", paquetes.Select(p => $"· {p.NombreCorto}  ({p.TamanoLegible})"));
        var nombre = await Avisos.PedirTextoAsync(
            $"¿Qué paquete del almacén se registra? Escribe su nombre exacto.\n\n{lista}",
            "Registrar desde el almacén");
        if (string.IsNullOrWhiteSpace(nombre)) return;

        var etiqueta = await Avisos.PedirTextoAsync(
            "Etiqueta de la versión (p. ej. 2.4.1). Una vez desplegada ya no se podrá cambiar: es su " +
            "nombre en el historial.", "Registrar desde el almacén");
        if (string.IsNullOrWhiteSpace(etiqueta)) return;

        var changelog = await Avisos.PedirTextoAsync(
            "Changelog: qué trae esta versión. Lo lee quien despliega para saber qué va a subir.",
            "Registrar desde el almacén");

        await Enviar("api/despliegues/versiones/nueva-del-almacen",
            new CrearVersionDesdeAlmacenRequest(sistema.Id, etiqueta, changelog, nombre.Trim()));
    }

    private async Task EditarVersion(VersionDto version)
    {
        var etiqueta = version.Version;
        if (!version.EtiquetaBloqueada)
        {
            var nueva = await Avisos.PedirTextoAsync($"Etiqueta (actual: «{version.Version}»):", "Editar versión");
            if (string.IsNullOrWhiteSpace(nueva)) return;
            etiqueta = nueva;
        }
        else
        {
            Avisos.Info("Esta versión ya se desplegó: su etiqueta es su nombre en el historial y no se " +
                        "puede cambiar. El changelog sí.");
        }

        var changelog = await Avisos.PedirTextoAsync("Changelog:", "Editar versión");
        await Enviar($"api/despliegues/versiones/{version.Id}/editar",
            new EditarVersionRequest(etiqueta, changelog, version.CarpetaDestino));
    }

    private async Task EliminarVersion(VersionDto version)
    {
        if (!await Avisos.ConfirmarAsync(
            $"¿Quitar del catálogo la versión «{version.Version}»? El archivo .zip se queda en la carpeta " +
            "del servidor.", "Eliminar versión", "Sí, quitarla"))
            return;

        await Enviar<object?>($"api/despliegues/versiones/{version.Id}/eliminar", null);
    }

    // ── Servidores ───────────────────────────────────────────────────────────

    /// <summary>
    /// Alta masiva de servidores desde un JSON, como en el escritorio: el archivo que el área ya
    /// tiene sirve tal cual.
    ///
    /// <para>El servidor valida TODO antes de escribir nada: si una fila está mal, no entra ninguna
    /// y dice cuál. Y el archivo lleva contraseñas en claro —no hay otra forma de importarlas—, así
    /// que conviene no dejarlo en un disco compartido.</para>
    /// </summary>
    private async Task ImportarServidores(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo is null) return;

        const long tope = 1024 * 1024;
        if (archivo.Size > tope)
        {
            Avisos.Aviso($"El archivo pasa de {tope / 1024} KB. Es un JSON de texto, no un volcado.");
            return;
        }

        if (!await Avisos.ConfirmarAsync(
                $"Se van a dar de alta o ACTUALIZAR los servidores de «{archivo.Name}». " +
                "Los que ya existan con el mismo nombre se sobrescriben, contraseña incluida. ¿Seguir?",
                "Importar servidores"))
            return;

        _ocupado = true;
        try
        {
            using var flujo = archivo.OpenReadStream(tope, _cancelacion.Token);
            using var memoria = new MemoryStream();
            await flujo.CopyToAsync(memoria, _cancelacion.Token);

            var formulario = new MultipartFormDataContent
            {
                { new ByteArrayContent(memoria.ToArray()), "archivo", archivo.Name }
            };

            var (ok, r) = await Api.SubirAsync<ResultadoDto>(
                "api/despliegues/servidores/importar", formulario, _cancelacion.Token);

            // El rechazo lo enseña el manejador de respuestas nombrando la fila que falla.
            if (ok && r is not null) Avisos.Exito(r.Mensaje);
            if (ok) await Cargar();
        }
        finally { _ocupado = false; }
    }

    private async Task NuevoServidor()
    {
        var nombre = await Avisos.PedirTextoAsync("Nombre del servidor (el que se lee en la bitácora):", "Nuevo servidor");
        if (string.IsNullOrWhiteSpace(nombre)) return;

        var host = await Avisos.PedirTextoAsync("Host (ftps://… o ftp://…):", "Nuevo servidor");
        if (string.IsNullOrWhiteSpace(host)) return;

        var puerto = await Avisos.PedirTextoAsync("Puerto (21 por omisión):", "Nuevo servidor");
        var usuario = await Avisos.PedirTextoAsync("Usuario:", "Nuevo servidor");
        if (string.IsNullOrWhiteSpace(usuario)) return;

        var contrasena = await Avisos.PedirTextoAsync(
            "Contraseña. Se guarda cifrada en la base compartida y NO se podrá volver a leer desde " +
            "aquí: solo reemplazar.", "Nuevo servidor");
        if (string.IsNullOrWhiteSpace(contrasena)) return;

        var ruta = await Avisos.PedirTextoAsync("Ruta remota (p. ej. /site/wwwroot):", "Nuevo servidor");
        if (string.IsNullOrWhiteSpace(ruta)) return;

        var url = await Avisos.PedirTextoAsync("URL pública del sitio (opcional):", "Nuevo servidor");

        await Enviar("api/despliegues/servidores/nuevo", new GuardarServidorRequest(
            nombre, host, int.TryParse(puerto, out var p) ? p : 21, usuario, contrasena, ruta, url));
    }

    private async Task EditarServidor(ServidorDto servidor)
    {
        var host = await Avisos.PedirTextoAsync($"Host (actual: «{servidor.Host}»):", "Editar servidor");
        if (string.IsNullOrWhiteSpace(host)) return;

        var puerto = await Avisos.PedirTextoAsync($"Puerto (actual: {servidor.Puerto}):", "Editar servidor");
        var usuario = await Avisos.PedirTextoAsync($"Usuario (actual: «{servidor.Usuario}»):", "Editar servidor");
        if (string.IsNullOrWhiteSpace(usuario)) return;

        // En blanco = conservar. No es comodidad: la contraseña no viaja de vuelta al navegador, así
        // que este formulario no puede reenviarla y sin esta regla corregir la ruta la borraría.
        var contrasena = await Avisos.PedirTextoAsync(
            "Contraseña NUEVA. Déjala en blanco para conservar la que ya tiene.", "Editar servidor");

        var ruta = await Avisos.PedirTextoAsync($"Ruta remota (actual: «{servidor.RutaRemota}»):", "Editar servidor");
        if (string.IsNullOrWhiteSpace(ruta)) return;

        var url = await Avisos.PedirTextoAsync($"URL pública (actual: «{servidor.Url ?? "—"}»):", "Editar servidor");

        await Enviar($"api/despliegues/servidores/{servidor.Id}/editar", new GuardarServidorRequest(
            servidor.Nombre, host, int.TryParse(puerto, out var p) ? p : servidor.Puerto,
            usuario, contrasena, ruta, url));
    }

    private async Task AlternarServidor(ServidorDto servidor)
    {
        if (!servidor.Activo)
        {
            await Enviar<object?>($"api/despliegues/servidores/{servidor.Id}/alta", null);
            return;
        }

        var motivo = await Avisos.PedirTextoAsync(
            $"«{servidor.Nombre}» deja de recibir despliegues, pero se conserva para que el historial siga " +
            "siendo legible. ¿Por qué? (opcional)", "Dar de baja");
        if (motivo is null) return;   // null es cancelar; vacío es aceptar sin escribir

        await Enviar($"api/despliegues/servidores/{servidor.Id}/baja", new MotivoDespliegueRequest(motivo));
    }

    // ── Perfiles ─────────────────────────────────────────────────────────────

    private async Task NuevoPerfil() => await CapturarPerfil(null);

    private async Task EditarPerfil(PerfilDto perfil) => await CapturarPerfil(perfil);

    private async Task CapturarPerfil(PerfilDto? perfil)
    {
        var nombre = await Avisos.PedirTextoAsync(
            perfil is null ? "¿Cómo se llama el perfil?" : $"Nombre (actual: «{perfil.Nombre}»):",
            perfil is null ? "Nuevo perfil" : "Editar perfil");
        if (string.IsNullOrWhiteSpace(nombre)) return;

        var descripcion = await Avisos.PedirTextoAsync("Descripción (opcional):", "Perfil");

        var activos = _servidores.Where(s => s.Activo).ToList();
        var lista = string.Join("\n", activos.Select(s => $"{s.Id} · {s.Nombre}"));
        var ids = await Avisos.PedirTextoAsync(
            $"Identificadores de los servidores, separados por comas:\n\n{lista}", "Perfil");
        if (string.IsNullOrWhiteSpace(ids)) return;

        var elegidos = ids.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(t => int.TryParse(t, out var n) ? n : 0)
            .Where(n => activos.Any(s => s.Id == n))
            .Distinct()
            .ToList();
        if (elegidos.Count == 0)
        {
            Avisos.Aviso("Ninguno de esos identificadores corresponde a un servidor activo.");
            return;
        }

        bool operaciones = await Avisos.ConfirmarAsync(
            "¿Operaciones puede desplegar este perfil? Marcarlo le da a ese rol un destino que ya no " +
            "elige servidor por servidor.", "Permiso del perfil", "Sí", "No");

        var cuerpo = new GuardarPerfilRequest(nombre, descripcion, operaciones, elegidos);
        await Enviar(perfil is null
            ? "api/despliegues/perfiles/nuevo"
            : $"api/despliegues/perfiles/{perfil.Id}/editar", cuerpo);
    }

    private async Task EliminarPerfil(PerfilDto perfil)
    {
        if (!await Avisos.ConfirmarAsync($"¿Eliminar el perfil «{perfil.Nombre}»?", "Eliminar perfil", "Sí, eliminarlo"))
            return;

        await Enviar<object?>($"api/despliegues/perfiles/{perfil.Id}/eliminar", null);
    }

