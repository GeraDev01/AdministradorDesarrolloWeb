<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net10.0 PURO: es lo que libera a las pruebas de arrastrar WinForms y lo que permite que la red de
    seguridad del port corra en cualquier sitio, incluido el pipeline en Linux.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- SQLite en memoria/archivo temporal para probar los servicios contra un motor real, que es
         el mismo andamiaje (TestDb) que ya usan las ~1000 pruebas del escritorio. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AdminWeb.Application\AdminWeb.Application.csproj" />
  </ItemGroup>

</Project>
