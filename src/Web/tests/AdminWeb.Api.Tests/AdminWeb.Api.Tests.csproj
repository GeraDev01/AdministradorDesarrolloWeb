<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Pruebas de la API levantada de verdad, con su tubería completa: autenticación por cookie,
    políticas, filtro de excepciones y enrutado.

    Existen porque las pruebas de servicios no pueden verlo. Un servicio puede estar perfecto y la
    API responder mal: una política mal escrita, un servicio sin registrar, el middleware en el orden
    equivocado, una cookie que no viaja. Todo eso compila y pasa las ~570 pruebas de Application
    igual. La prueba de humo (humo.ps1) cubre ese terreno, pero se lanza a mano; esto corre en CI.

    Sdk.Web y no Sdk normal: WebApplicationFactory necesita el manifiesto del framework compartido de
    ASP.NET Core para arrancar el Program de la API.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- El proyecto no se ejecuta: solo hospeda pruebas. -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AdminWeb.Api\AdminWeb.Api.csproj" />
  </ItemGroup>

</Project>
