<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil de publicación del INSTALADOR: un solo .exe autocontenido para repartir al equipo.

  Es la misma aplicación para todos: el menú y los permisos dependen del rol de la cuenta con la
  que cada quien inicia sesión.

  IMPORTANTE — para publicar con la conexión a la base ya incrustada, usa el script:

      Administrador_Desarrollo_Web\Deploy\build-app.ps1 -ConnectionString "server = ...; uid = app_dev; pwd = ...; database = ..."

  El script genera el recurso cifrado (Deploy\devbuild.bin), publica con este mismo conjunto de
  propiedades y luego borra el recurso del árbol de fuentes. Publicar desde Visual Studio con este
  perfil produce un ejecutable SIN conexión incrustada: válido, pero cada equipo tendrá que
  capturarla la primera vez en Configuración → Base de datos.

  IncludeAllContentForSelfExtract mete dentro del .exe también las plantillas .docx y las
  librerías nativas (SQLite, WebView2). Sin eso, "un solo archivo" no sería cierto: quedarían
  archivos sueltos al lado que hay que copiar junto con el ejecutable.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\dist\instalador\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Sin símbolos: es un binario para repartir, no para depurar. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- ReadyToRun mejora el arranque en frío a costa de tamaño. Se deja apagado a propósito:
         el ejecutable ya ronda los 64 MB y el arranque no es el cuello de botella. -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- El recorte NO es seguro aquí: EF Core y los serializadores resuelven tipos por reflexión
         y el recorte los elimina, produciendo fallos en tiempo de ejecución difíciles de rastrear. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
